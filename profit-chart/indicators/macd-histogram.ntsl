// =========================================================================
// MACD HISTOGRAM COM CONTORNO
// =========================================================================
// Exibe apenas o histograma do MACD com uma linha conectando os topos
// para facilitar a visualizacao de maximas e minimas.
//
// A linha ajuda a identificar:
//   - Picos do histograma (maximas de momentum)
//   - Vales do histograma (minimas de momentum)
//   - Divergencias com o preco
// =========================================================================

input
  // ----- Periodos do MACD -----

  // Periodo da EMA rapida. Padrao: 72
  Periodo_EMA_Rapida(72);

  // Periodo da EMA lenta. Padrao: 200
  Periodo_EMA_Lenta(200);

  // Periodo da linha de sinal (EMA do MACD). Padrao: 34
  Periodo_Sinal(34);

  // ----- Opcoes de Exibicao -----

  // Exibir linha de contorno conectando os topos do histograma?
  Exibir_Linha_Contorno(true);

var
  bStarted: Boolean;

  // Componentes do MACD
  fMacdLine: Float;
  fSignalLine: Float;
  fHistogram: Float;

  // Cores
  nPositiveColor: Integer;
  nNegativeColor: Integer;
  nLineColor: Integer;

begin
  // -----------------------------------------------------------------------
  // Inicializacao
  // -----------------------------------------------------------------------
  if not bStarted then begin
    bStarted := True;
    nPositiveColor := RGB(0, 180, 80);
    nNegativeColor := RGB(220, 50, 50);
    nLineColor := RGB(255, 255, 255);
  end;

  // -----------------------------------------------------------------------
  // Calcula MACD
  // -----------------------------------------------------------------------
  fMacdLine := MediaExp(Periodo_EMA_Rapida, Close) - MediaExp(Periodo_EMA_Lenta, Close);
  fSignalLine := MediaExp(Periodo_Sinal, fMacdLine);
  fHistogram := fMacdLine - fSignalLine;

  // -----------------------------------------------------------------------
  // Plot 1: Histograma (barras)
  // -----------------------------------------------------------------------
  PlotN(1, fHistogram);
  SetPlotType(1, 1);
  SetPlotWidth(1, 2);

  // Cor baseada em positivo/negativo
  if fHistogram >= 0 then
    SetPlotColor(1, nPositiveColor)
  else
    SetPlotColor(1, nNegativeColor);

  // -----------------------------------------------------------------------
  // Plot 2: Linha de contorno no topo do histograma
  // -----------------------------------------------------------------------
  if Exibir_Linha_Contorno then begin
    PlotN(2, fHistogram);
    SetPlotType(2, 0);
    SetPlotWidth(2, 2);
    SetPlotColor(2, nLineColor);
  end;

  // -----------------------------------------------------------------------
  // Plot 3: Linha de referencia no zero
  // -----------------------------------------------------------------------
  PlotN(3, 0);
  SetPlotType(3, 0);
  SetPlotWidth(3, 1);
  SetPlotColor(3, RGB(100, 100, 100));

end;
