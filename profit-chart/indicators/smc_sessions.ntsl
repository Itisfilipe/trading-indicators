// =========================================================================
// SMC SESSIONS - Killzones desenhadas como caixas (Asia/London/NY AM/Lunch/PM)
// =========================================================================
// Cada sessao com cor propria e horarios configuraveis.
// Mantem ate Max_Sessoes_Passadas caixas passadas por tipo (ring buffer)
// redesenhadas em LastBarOnChart para evitar duplicacao em ticks.
// Extensao high/low (High/Low) projetada para a direita a partir da sessao
// mais recente (slot 1) - pontos de liquidez.
//
// Modo de horario:
//   - Horario_Em_NY = true (default): inputs em NY clock; o indicador soma
//     Offset_NY_Para_BR minutos pra converter pra BR.
//     Default = 60 (DST abr-out). Mude para 120 no EST (nov-mar).
//   - Horario_Em_NY = false: inputs em hora do Brasil direto.
// =========================================================================

input
  Tema_Escuro(false);

  Horario_Em_NY(true);
  Offset_NY_Para_BR(60);

  Ativar_Asia(true);
  Asia_Inicio(2000);              // 20:00 NY
  Asia_Fim(0);                    // 00:00 NY - cruza meia-noite

  Ativar_Londres(true);
  Londres_Inicio(200);            // 02:00 NY
  Londres_Fim(500);               // 05:00 NY

  Ativar_NY_AM(true);
  NY_AM_Inicio(930);              // 09:30 NY (cash open)
  NY_AM_Fim(1100);                // 11:00 NY

  Ativar_NY_Lunch(true);
  NY_Lunch_Inicio(1200);          // 12:00 NY
  NY_Lunch_Fim(1300);             // 13:00 NY

  Ativar_NY_PM(true);
  NY_PM_Inicio(1330);             // 13:30 NY
  NY_PM_Fim(1600);                // 16:00 NY

  Mostrar_Niveis_Sessao(false);
  Espessura_Borda_Sessao(2);
  Max_Sessoes_Passadas(5);

var
  nAsiaStartEff,    nAsiaEndEff    : Integer;
  nLondonStartEff,  nLondonEndEff  : Integer;
  nNyAmStartEff,    nNyAmEndEff    : Integer;
  nNyLunchStartEff, nNyLunchEndEff : Integer;
  nNyPmStartEff,    nNyPmEndEff    : Integer;

  bInAsia, bInLondon, bInNyAm, bInNyLunch, bInNyPm : Boolean;
  fAsiaHigh, fAsiaLow         : Float;
  fLondonHigh, fLondonLow     : Float;
  fNyAmHigh, fNyAmLow         : Float;
  fNyLunchHigh, fNyLunchLow   : Float;
  fNyPmHigh, fNyPmLow         : Float;
  nAsiaStartDate, nLondonStartDate, nNyAmStartDate,
  nNyLunchStartDate, nNyPmStartDate : Integer;

  fAsia1H, fAsia2H, fAsia3H, fAsia4H, fAsia5H : Float;
  fAsia1L, fAsia2L, fAsia3L, fAsia4L, fAsia5L : Float;
  nAsia1S, nAsia2S, nAsia3S, nAsia4S, nAsia5S : Integer;
  nAsia1E, nAsia2E, nAsia3E, nAsia4E, nAsia5E : Integer;

  fLon1H, fLon2H, fLon3H, fLon4H, fLon5H : Float;
  fLon1L, fLon2L, fLon3L, fLon4L, fLon5L : Float;
  nLon1S, nLon2S, nLon3S, nLon4S, nLon5S : Integer;
  nLon1E, nLon2E, nLon3E, nLon4E, nLon5E : Integer;

  fAm1H, fAm2H, fAm3H, fAm4H, fAm5H : Float;
  fAm1L, fAm2L, fAm3L, fAm4L, fAm5L : Float;
  nAm1S, nAm2S, nAm3S, nAm4S, nAm5S : Integer;
  nAm1E, nAm2E, nAm3E, nAm4E, nAm5E : Integer;

  fLu1H, fLu2H, fLu3H, fLu4H, fLu5H : Float;
  fLu1L, fLu2L, fLu3L, fLu4L, fLu5L : Float;
  nLu1S, nLu2S, nLu3S, nLu4S, nLu5S : Integer;
  nLu1E, nLu2E, nLu3E, nLu4E, nLu5E : Integer;

  fPm1H, fPm2H, fPm3H, fPm4H, fPm5H : Float;
  fPm1L, fPm2L, fPm3L, fPm4L, fPm5L : Float;
  nPm1S, nPm2S, nPm3S, nPm4S, nPm5S : Integer;
  nPm1E, nPm2E, nPm3E, nPm4E, nPm5E : Integer;

  nAsiaColor, nLondonColor, nNyAmColor, nNyLunchColor, nNyPmColor : Integer;
  nAsiaFill,  nLondonFill,  nNyAmFill,  nNyLunchFill,  nNyPmFill  : Integer;

  nT : Integer;
  nEndRun : Integer;             // data fim da sessao corrente (para running draw)

begin
  if Tema_Escuro then
    begin
      nAsiaColor     := RGB(220, 200,  40);
      nLondonColor   := RGB( 80, 130, 255);
      nNyAmColor     := RGB(255,  80,  80);
      nNyLunchColor  := RGB(150, 200, 255);
      nNyPmColor     := RGB(200, 130, 255);
      nAsiaFill      := RGB( 70,  60,  10);
      nLondonFill    := RGB( 20,  35,  80);
      nNyAmFill      := RGB( 80,  25,  25);
      nNyLunchFill   := RGB( 45,  60,  85);
      nNyPmFill      := RGB( 65,  35,  85);
    end
  else
    begin
      nAsiaColor     := RGB(220, 180,  20);
      nLondonColor   := RGB( 60, 100, 220);
      nNyAmColor     := RGB(220,  60,  60);
      nNyLunchColor  := RGB(110, 170, 230);
      nNyPmColor     := RGB(160,  80, 200);
      nAsiaFill      := RGB(252, 240, 180);
      nLondonFill    := RGB(205, 220, 250);
      nNyAmFill      := RGB(250, 210, 210);
      nNyLunchFill   := RGB(215, 230, 250);
      nNyPmFill      := RGB(230, 215, 245);
    end;

  if Horario_Em_NY then
    begin
      nAsiaStartEff    := CalcTime(Asia_Inicio,    Offset_NY_Para_BR);
      nAsiaEndEff      := CalcTime(Asia_Fim,       Offset_NY_Para_BR);
      nLondonStartEff  := CalcTime(Londres_Inicio, Offset_NY_Para_BR);
      nLondonEndEff    := CalcTime(Londres_Fim,    Offset_NY_Para_BR);
      nNyAmStartEff    := CalcTime(NY_AM_Inicio,   Offset_NY_Para_BR);
      nNyAmEndEff      := CalcTime(NY_AM_Fim,      Offset_NY_Para_BR);
      nNyLunchStartEff := CalcTime(NY_Lunch_Inicio, Offset_NY_Para_BR);
      nNyLunchEndEff   := CalcTime(NY_Lunch_Fim,   Offset_NY_Para_BR);
      nNyPmStartEff    := CalcTime(NY_PM_Inicio,   Offset_NY_Para_BR);
      nNyPmEndEff      := CalcTime(NY_PM_Fim,      Offset_NY_Para_BR);
    end
  else
    begin
      nAsiaStartEff    := Asia_Inicio;
      nAsiaEndEff      := Asia_Fim;
      nLondonStartEff  := Londres_Inicio;
      nLondonEndEff    := Londres_Fim;
      nNyAmStartEff    := NY_AM_Inicio;
      nNyAmEndEff      := NY_AM_Fim;
      nNyLunchStartEff := NY_Lunch_Inicio;
      nNyLunchEndEff   := NY_Lunch_Fim;
      nNyPmStartEff    := NY_PM_Inicio;
      nNyPmEndEff      := NY_PM_Fim;
    end;

  nT := Time;

  // =================== ASIA ===================
  fAsiaHigh := fAsiaHigh[1]; fAsiaLow := fAsiaLow[1];
  nAsiaStartDate := nAsiaStartDate[1];
  fAsia1H := fAsia1H[1]; fAsia2H := fAsia2H[1]; fAsia3H := fAsia3H[1]; fAsia4H := fAsia4H[1]; fAsia5H := fAsia5H[1];
  fAsia1L := fAsia1L[1]; fAsia2L := fAsia2L[1]; fAsia3L := fAsia3L[1]; fAsia4L := fAsia4L[1]; fAsia5L := fAsia5L[1];
  nAsia1S := nAsia1S[1]; nAsia2S := nAsia2S[1]; nAsia3S := nAsia3S[1]; nAsia4S := nAsia4S[1]; nAsia5S := nAsia5S[1];
  nAsia1E := nAsia1E[1]; nAsia2E := nAsia2E[1]; nAsia3E := nAsia3E[1]; nAsia4E := nAsia4E[1]; nAsia5E := nAsia5E[1];

  if Ativar_Asia then
    begin
      if nAsiaStartEff > nAsiaEndEff then
        bInAsia := (nT >= nAsiaStartEff) or (nT < nAsiaEndEff)
      else
        bInAsia := (nT >= nAsiaStartEff) and (nT < nAsiaEndEff);

      if bInAsia and not bInAsia[1] then
        begin
          fAsiaHigh := High;
          fAsiaLow  := Low;
          if (nAsiaStartEff > nAsiaEndEff) and (nT < nAsiaEndEff) then
            nAsiaStartDate := CalcDate(Date, -1)
          else
            nAsiaStartDate := Date;
        end
      else if bInAsia then
        begin
          if High > fAsiaHigh then fAsiaHigh := High;
          if Low  < fAsiaLow  then fAsiaLow  := Low;
        end
      else if bInAsia[1] then
        begin
          fAsia5H := fAsia4H; fAsia5L := fAsia4L; nAsia5S := nAsia4S; nAsia5E := nAsia4E;
          fAsia4H := fAsia3H; fAsia4L := fAsia3L; nAsia4S := nAsia3S; nAsia4E := nAsia3E;
          fAsia3H := fAsia2H; fAsia3L := fAsia2L; nAsia3S := nAsia2S; nAsia3E := nAsia2E;
          fAsia2H := fAsia1H; fAsia2L := fAsia1L; nAsia2S := nAsia1S; nAsia2E := nAsia1E;
          fAsia1H := fAsiaHigh; fAsia1L := fAsiaLow; nAsia1S := nAsiaStartDate;
          if nAsiaStartEff > nAsiaEndEff then
            nAsia1E := CalcDate(nAsiaStartDate, 1)
          else
            nAsia1E := nAsiaStartDate;
        end;

      if bInAsia and LastBarOnChart and (fAsiaHigh > fAsiaLow) then
        begin
          nEndRun := nAsiaStartDate;
          if nAsiaStartEff > nAsiaEndEff then nEndRun := CalcDate(nAsiaStartDate, 1);
          HorizontalLineCustom((fAsiaHigh+fAsiaLow)/2, nAsiaFill, 1, 0,
            "", 8, tpTopLeft, nAsiaStartDate, nEndRun, (fAsiaHigh-fAsiaLow)/2, nAsiaStartEff, nAsiaEndEff);
          HorizontalLineCustom(fAsiaHigh, nAsiaColor, Espessura_Borda_Sessao, 0,
            "Asia", 8, tpTopLeft, nAsiaStartDate, nEndRun, 0, nAsiaStartEff, nAsiaEndEff);
          HorizontalLineCustom(fAsiaLow, nAsiaColor, Espessura_Borda_Sessao, 0,
            "", 8, tpTopLeft, nAsiaStartDate, nEndRun, 0, nAsiaStartEff, nAsiaEndEff);
        end;

      if LastBarOnChart then
        begin
          if (nAsia1E > 0) and (fAsia1H > fAsia1L) and (Max_Sessoes_Passadas >= 1) then
            begin
              HorizontalLineCustom((fAsia1H+fAsia1L)/2, nAsiaFill, 1, 0, "", 8, tpTopLeft, nAsia1S, nAsia1E, (fAsia1H-fAsia1L)/2, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia1H, nAsiaColor, Espessura_Borda_Sessao, 0, "Asia", 8, tpTopLeft, nAsia1S, nAsia1E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia1L, nAsiaColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAsia1S, nAsia1E, 0, nAsiaStartEff, nAsiaEndEff);
            end;
          if (nAsia2E > 0) and (fAsia2H > fAsia2L) and (Max_Sessoes_Passadas >= 2) then
            begin
              HorizontalLineCustom((fAsia2H+fAsia2L)/2, nAsiaFill, 1, 0, "", 8, tpTopLeft, nAsia2S, nAsia2E, (fAsia2H-fAsia2L)/2, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia2H, nAsiaColor, Espessura_Borda_Sessao, 0, "Asia", 8, tpTopLeft, nAsia2S, nAsia2E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia2L, nAsiaColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAsia2S, nAsia2E, 0, nAsiaStartEff, nAsiaEndEff);
            end;
          if (nAsia3E > 0) and (fAsia3H > fAsia3L) and (Max_Sessoes_Passadas >= 3) then
            begin
              HorizontalLineCustom((fAsia3H+fAsia3L)/2, nAsiaFill, 1, 0, "", 8, tpTopLeft, nAsia3S, nAsia3E, (fAsia3H-fAsia3L)/2, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia3H, nAsiaColor, Espessura_Borda_Sessao, 0, "Asia", 8, tpTopLeft, nAsia3S, nAsia3E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia3L, nAsiaColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAsia3S, nAsia3E, 0, nAsiaStartEff, nAsiaEndEff);
            end;
          if (nAsia4E > 0) and (fAsia4H > fAsia4L) and (Max_Sessoes_Passadas >= 4) then
            begin
              HorizontalLineCustom((fAsia4H+fAsia4L)/2, nAsiaFill, 1, 0, "", 8, tpTopLeft, nAsia4S, nAsia4E, (fAsia4H-fAsia4L)/2, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia4H, nAsiaColor, Espessura_Borda_Sessao, 0, "Asia", 8, tpTopLeft, nAsia4S, nAsia4E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia4L, nAsiaColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAsia4S, nAsia4E, 0, nAsiaStartEff, nAsiaEndEff);
            end;
          if (nAsia5E > 0) and (fAsia5H > fAsia5L) and (Max_Sessoes_Passadas >= 5) then
            begin
              HorizontalLineCustom((fAsia5H+fAsia5L)/2, nAsiaFill, 1, 0, "", 8, tpTopLeft, nAsia5S, nAsia5E, (fAsia5H-fAsia5L)/2, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia5H, nAsiaColor, Espessura_Borda_Sessao, 0, "Asia", 8, tpTopLeft, nAsia5S, nAsia5E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia5L, nAsiaColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAsia5S, nAsia5E, 0, nAsiaStartEff, nAsiaEndEff);
            end;

          if Mostrar_Niveis_Sessao and (nAsia1E > 0) and (fAsia1H > fAsia1L) then
            begin
              HorizontalLineCustom(fAsia1H, nAsiaColor, 1, 2, "Asia High", 8, tpTopRight,
                nAsia1E, 0, 0, nAsiaEndEff, 2359);
              HorizontalLineCustom(fAsia1L, nAsiaColor, 1, 2, "Asia Low", 8, tpBottomRight,
                nAsia1E, 0, 0, nAsiaEndEff, 2359);
            end;
        end;
    end;

  // =================== LONDON ===================
  fLondonHigh := fLondonHigh[1]; fLondonLow := fLondonLow[1];
  nLondonStartDate := nLondonStartDate[1];
  fLon1H := fLon1H[1]; fLon2H := fLon2H[1]; fLon3H := fLon3H[1]; fLon4H := fLon4H[1]; fLon5H := fLon5H[1];
  fLon1L := fLon1L[1]; fLon2L := fLon2L[1]; fLon3L := fLon3L[1]; fLon4L := fLon4L[1]; fLon5L := fLon5L[1];
  nLon1S := nLon1S[1]; nLon2S := nLon2S[1]; nLon3S := nLon3S[1]; nLon4S := nLon4S[1]; nLon5S := nLon5S[1];
  nLon1E := nLon1E[1]; nLon2E := nLon2E[1]; nLon3E := nLon3E[1]; nLon4E := nLon4E[1]; nLon5E := nLon5E[1];

  if Ativar_Londres then
    begin
      if nLondonStartEff > nLondonEndEff then
        bInLondon := (nT >= nLondonStartEff) or (nT < nLondonEndEff)
      else
        bInLondon := (nT >= nLondonStartEff) and (nT < nLondonEndEff);

      if bInLondon and not bInLondon[1] then
        begin
          fLondonHigh := High; fLondonLow := Low;
          if (nLondonStartEff > nLondonEndEff) and (nT < nLondonEndEff) then
            nLondonStartDate := CalcDate(Date, -1)
          else
            nLondonStartDate := Date;
        end
      else if bInLondon then
        begin
          if High > fLondonHigh then fLondonHigh := High;
          if Low  < fLondonLow  then fLondonLow  := Low;
        end
      else if bInLondon[1] then
        begin
          fLon5H := fLon4H; fLon5L := fLon4L; nLon5S := nLon4S; nLon5E := nLon4E;
          fLon4H := fLon3H; fLon4L := fLon3L; nLon4S := nLon3S; nLon4E := nLon3E;
          fLon3H := fLon2H; fLon3L := fLon2L; nLon3S := nLon2S; nLon3E := nLon2E;
          fLon2H := fLon1H; fLon2L := fLon1L; nLon2S := nLon1S; nLon2E := nLon1E;
          fLon1H := fLondonHigh; fLon1L := fLondonLow; nLon1S := nLondonStartDate;
          if nLondonStartEff > nLondonEndEff then
            nLon1E := CalcDate(nLondonStartDate, 1)
          else
            nLon1E := nLondonStartDate;
        end;

      if bInLondon and LastBarOnChart and (fLondonHigh > fLondonLow) then
        begin
          nEndRun := nLondonStartDate;
          if nLondonStartEff > nLondonEndEff then nEndRun := CalcDate(nLondonStartDate, 1);
          HorizontalLineCustom((fLondonHigh+fLondonLow)/2, nLondonFill, 1, 0,
            "", 8, tpTopLeft, nLondonStartDate, nEndRun, (fLondonHigh-fLondonLow)/2, nLondonStartEff, nLondonEndEff);
          HorizontalLineCustom(fLondonHigh, nLondonColor, Espessura_Borda_Sessao, 0,
            "London", 8, tpTopLeft, nLondonStartDate, nEndRun, 0, nLondonStartEff, nLondonEndEff);
          HorizontalLineCustom(fLondonLow, nLondonColor, Espessura_Borda_Sessao, 0,
            "", 8, tpTopLeft, nLondonStartDate, nEndRun, 0, nLondonStartEff, nLondonEndEff);
        end;

      if LastBarOnChart then
        begin
          if (nLon1E > 0) and (fLon1H > fLon1L) and (Max_Sessoes_Passadas >= 1) then
            begin
              HorizontalLineCustom((fLon1H+fLon1L)/2, nLondonFill, 1, 0, "", 8, tpTopLeft, nLon1S, nLon1E, (fLon1H-fLon1L)/2, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon1H, nLondonColor, Espessura_Borda_Sessao, 0, "London", 8, tpTopLeft, nLon1S, nLon1E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon1L, nLondonColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLon1S, nLon1E, 0, nLondonStartEff, nLondonEndEff);
            end;
          if (nLon2E > 0) and (fLon2H > fLon2L) and (Max_Sessoes_Passadas >= 2) then
            begin
              HorizontalLineCustom((fLon2H+fLon2L)/2, nLondonFill, 1, 0, "", 8, tpTopLeft, nLon2S, nLon2E, (fLon2H-fLon2L)/2, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon2H, nLondonColor, Espessura_Borda_Sessao, 0, "London", 8, tpTopLeft, nLon2S, nLon2E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon2L, nLondonColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLon2S, nLon2E, 0, nLondonStartEff, nLondonEndEff);
            end;
          if (nLon3E > 0) and (fLon3H > fLon3L) and (Max_Sessoes_Passadas >= 3) then
            begin
              HorizontalLineCustom((fLon3H+fLon3L)/2, nLondonFill, 1, 0, "", 8, tpTopLeft, nLon3S, nLon3E, (fLon3H-fLon3L)/2, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon3H, nLondonColor, Espessura_Borda_Sessao, 0, "London", 8, tpTopLeft, nLon3S, nLon3E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon3L, nLondonColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLon3S, nLon3E, 0, nLondonStartEff, nLondonEndEff);
            end;
          if (nLon4E > 0) and (fLon4H > fLon4L) and (Max_Sessoes_Passadas >= 4) then
            begin
              HorizontalLineCustom((fLon4H+fLon4L)/2, nLondonFill, 1, 0, "", 8, tpTopLeft, nLon4S, nLon4E, (fLon4H-fLon4L)/2, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon4H, nLondonColor, Espessura_Borda_Sessao, 0, "London", 8, tpTopLeft, nLon4S, nLon4E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon4L, nLondonColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLon4S, nLon4E, 0, nLondonStartEff, nLondonEndEff);
            end;
          if (nLon5E > 0) and (fLon5H > fLon5L) and (Max_Sessoes_Passadas >= 5) then
            begin
              HorizontalLineCustom((fLon5H+fLon5L)/2, nLondonFill, 1, 0, "", 8, tpTopLeft, nLon5S, nLon5E, (fLon5H-fLon5L)/2, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon5H, nLondonColor, Espessura_Borda_Sessao, 0, "London", 8, tpTopLeft, nLon5S, nLon5E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon5L, nLondonColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLon5S, nLon5E, 0, nLondonStartEff, nLondonEndEff);
            end;

          if Mostrar_Niveis_Sessao and (nLon1E > 0) and (fLon1H > fLon1L) then
            begin
              HorizontalLineCustom(fLon1H, nLondonColor, 1, 2, "London High", 8, tpTopRight,
                nLon1E, 0, 0, nLondonEndEff, 2359);
              HorizontalLineCustom(fLon1L, nLondonColor, 1, 2, "London Low", 8, tpBottomRight,
                nLon1E, 0, 0, nLondonEndEff, 2359);
            end;
        end;
    end;

  // =================== NY AM ===================
  fNyAmHigh := fNyAmHigh[1]; fNyAmLow := fNyAmLow[1];
  nNyAmStartDate := nNyAmStartDate[1];
  fAm1H := fAm1H[1]; fAm2H := fAm2H[1]; fAm3H := fAm3H[1]; fAm4H := fAm4H[1]; fAm5H := fAm5H[1];
  fAm1L := fAm1L[1]; fAm2L := fAm2L[1]; fAm3L := fAm3L[1]; fAm4L := fAm4L[1]; fAm5L := fAm5L[1];
  nAm1S := nAm1S[1]; nAm2S := nAm2S[1]; nAm3S := nAm3S[1]; nAm4S := nAm4S[1]; nAm5S := nAm5S[1];
  nAm1E := nAm1E[1]; nAm2E := nAm2E[1]; nAm3E := nAm3E[1]; nAm4E := nAm4E[1]; nAm5E := nAm5E[1];

  if Ativar_NY_AM then
    begin
      if nNyAmStartEff > nNyAmEndEff then
        bInNyAm := (nT >= nNyAmStartEff) or (nT < nNyAmEndEff)
      else
        bInNyAm := (nT >= nNyAmStartEff) and (nT < nNyAmEndEff);

      if bInNyAm and not bInNyAm[1] then
        begin
          fNyAmHigh := High; fNyAmLow := Low;
          if (nNyAmStartEff > nNyAmEndEff) and (nT < nNyAmEndEff) then
            nNyAmStartDate := CalcDate(Date, -1)
          else
            nNyAmStartDate := Date;
        end
      else if bInNyAm then
        begin
          if High > fNyAmHigh then fNyAmHigh := High;
          if Low  < fNyAmLow  then fNyAmLow  := Low;
        end
      else if bInNyAm[1] then
        begin
          fAm5H := fAm4H; fAm5L := fAm4L; nAm5S := nAm4S; nAm5E := nAm4E;
          fAm4H := fAm3H; fAm4L := fAm3L; nAm4S := nAm3S; nAm4E := nAm3E;
          fAm3H := fAm2H; fAm3L := fAm2L; nAm3S := nAm2S; nAm3E := nAm2E;
          fAm2H := fAm1H; fAm2L := fAm1L; nAm2S := nAm1S; nAm2E := nAm1E;
          fAm1H := fNyAmHigh; fAm1L := fNyAmLow; nAm1S := nNyAmStartDate;
          if nNyAmStartEff > nNyAmEndEff then
            nAm1E := CalcDate(nNyAmStartDate, 1)
          else
            nAm1E := nNyAmStartDate;
        end;

      if bInNyAm and LastBarOnChart and (fNyAmHigh > fNyAmLow) then
        begin
          nEndRun := nNyAmStartDate;
          if nNyAmStartEff > nNyAmEndEff then nEndRun := CalcDate(nNyAmStartDate, 1);
          HorizontalLineCustom((fNyAmHigh+fNyAmLow)/2, nNyAmFill, 1, 0,
            "", 8, tpTopLeft, nNyAmStartDate, nEndRun, (fNyAmHigh-fNyAmLow)/2, nNyAmStartEff, nNyAmEndEff);
          HorizontalLineCustom(fNyAmHigh, nNyAmColor, Espessura_Borda_Sessao, 0,
            "NY AM", 8, tpTopLeft, nNyAmStartDate, nEndRun, 0, nNyAmStartEff, nNyAmEndEff);
          HorizontalLineCustom(fNyAmLow, nNyAmColor, Espessura_Borda_Sessao, 0,
            "", 8, tpTopLeft, nNyAmStartDate, nEndRun, 0, nNyAmStartEff, nNyAmEndEff);
        end;

      if LastBarOnChart then
        begin
          if (nAm1E > 0) and (fAm1H > fAm1L) and (Max_Sessoes_Passadas >= 1) then
            begin
              HorizontalLineCustom((fAm1H+fAm1L)/2, nNyAmFill, 1, 0, "", 8, tpTopLeft, nAm1S, nAm1E, (fAm1H-fAm1L)/2, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm1H, nNyAmColor, Espessura_Borda_Sessao, 0, "NY AM", 8, tpTopLeft, nAm1S, nAm1E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm1L, nNyAmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAm1S, nAm1E, 0, nNyAmStartEff, nNyAmEndEff);
            end;
          if (nAm2E > 0) and (fAm2H > fAm2L) and (Max_Sessoes_Passadas >= 2) then
            begin
              HorizontalLineCustom((fAm2H+fAm2L)/2, nNyAmFill, 1, 0, "", 8, tpTopLeft, nAm2S, nAm2E, (fAm2H-fAm2L)/2, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm2H, nNyAmColor, Espessura_Borda_Sessao, 0, "NY AM", 8, tpTopLeft, nAm2S, nAm2E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm2L, nNyAmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAm2S, nAm2E, 0, nNyAmStartEff, nNyAmEndEff);
            end;
          if (nAm3E > 0) and (fAm3H > fAm3L) and (Max_Sessoes_Passadas >= 3) then
            begin
              HorizontalLineCustom((fAm3H+fAm3L)/2, nNyAmFill, 1, 0, "", 8, tpTopLeft, nAm3S, nAm3E, (fAm3H-fAm3L)/2, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm3H, nNyAmColor, Espessura_Borda_Sessao, 0, "NY AM", 8, tpTopLeft, nAm3S, nAm3E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm3L, nNyAmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAm3S, nAm3E, 0, nNyAmStartEff, nNyAmEndEff);
            end;
          if (nAm4E > 0) and (fAm4H > fAm4L) and (Max_Sessoes_Passadas >= 4) then
            begin
              HorizontalLineCustom((fAm4H+fAm4L)/2, nNyAmFill, 1, 0, "", 8, tpTopLeft, nAm4S, nAm4E, (fAm4H-fAm4L)/2, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm4H, nNyAmColor, Espessura_Borda_Sessao, 0, "NY AM", 8, tpTopLeft, nAm4S, nAm4E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm4L, nNyAmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAm4S, nAm4E, 0, nNyAmStartEff, nNyAmEndEff);
            end;
          if (nAm5E > 0) and (fAm5H > fAm5L) and (Max_Sessoes_Passadas >= 5) then
            begin
              HorizontalLineCustom((fAm5H+fAm5L)/2, nNyAmFill, 1, 0, "", 8, tpTopLeft, nAm5S, nAm5E, (fAm5H-fAm5L)/2, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm5H, nNyAmColor, Espessura_Borda_Sessao, 0, "NY AM", 8, tpTopLeft, nAm5S, nAm5E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm5L, nNyAmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nAm5S, nAm5E, 0, nNyAmStartEff, nNyAmEndEff);
            end;

          if Mostrar_Niveis_Sessao and (nAm1E > 0) and (fAm1H > fAm1L) then
            begin
              HorizontalLineCustom(fAm1H, nNyAmColor, 1, 2, "NY AM High", 8, tpTopRight,
                nAm1E, 0, 0, nNyAmEndEff, 2359);
              HorizontalLineCustom(fAm1L, nNyAmColor, 1, 2, "NY AM Low", 8, tpBottomRight,
                nAm1E, 0, 0, nNyAmEndEff, 2359);
            end;
        end;
    end;

  // =================== NY LUNCH ===================
  fNyLunchHigh := fNyLunchHigh[1]; fNyLunchLow := fNyLunchLow[1];
  nNyLunchStartDate := nNyLunchStartDate[1];
  fLu1H := fLu1H[1]; fLu2H := fLu2H[1]; fLu3H := fLu3H[1]; fLu4H := fLu4H[1]; fLu5H := fLu5H[1];
  fLu1L := fLu1L[1]; fLu2L := fLu2L[1]; fLu3L := fLu3L[1]; fLu4L := fLu4L[1]; fLu5L := fLu5L[1];
  nLu1S := nLu1S[1]; nLu2S := nLu2S[1]; nLu3S := nLu3S[1]; nLu4S := nLu4S[1]; nLu5S := nLu5S[1];
  nLu1E := nLu1E[1]; nLu2E := nLu2E[1]; nLu3E := nLu3E[1]; nLu4E := nLu4E[1]; nLu5E := nLu5E[1];

  if Ativar_NY_Lunch then
    begin
      if nNyLunchStartEff > nNyLunchEndEff then
        bInNyLunch := (nT >= nNyLunchStartEff) or (nT < nNyLunchEndEff)
      else
        bInNyLunch := (nT >= nNyLunchStartEff) and (nT < nNyLunchEndEff);

      if bInNyLunch and not bInNyLunch[1] then
        begin
          fNyLunchHigh := High; fNyLunchLow := Low;
          if (nNyLunchStartEff > nNyLunchEndEff) and (nT < nNyLunchEndEff) then
            nNyLunchStartDate := CalcDate(Date, -1)
          else
            nNyLunchStartDate := Date;
        end
      else if bInNyLunch then
        begin
          if High > fNyLunchHigh then fNyLunchHigh := High;
          if Low  < fNyLunchLow  then fNyLunchLow  := Low;
        end
      else if bInNyLunch[1] then
        begin
          fLu5H := fLu4H; fLu5L := fLu4L; nLu5S := nLu4S; nLu5E := nLu4E;
          fLu4H := fLu3H; fLu4L := fLu3L; nLu4S := nLu3S; nLu4E := nLu3E;
          fLu3H := fLu2H; fLu3L := fLu2L; nLu3S := nLu2S; nLu3E := nLu2E;
          fLu2H := fLu1H; fLu2L := fLu1L; nLu2S := nLu1S; nLu2E := nLu1E;
          fLu1H := fNyLunchHigh; fLu1L := fNyLunchLow; nLu1S := nNyLunchStartDate;
          if nNyLunchStartEff > nNyLunchEndEff then
            nLu1E := CalcDate(nNyLunchStartDate, 1)
          else
            nLu1E := nNyLunchStartDate;
        end;

      if bInNyLunch and LastBarOnChart and (fNyLunchHigh > fNyLunchLow) then
        begin
          nEndRun := nNyLunchStartDate;
          if nNyLunchStartEff > nNyLunchEndEff then nEndRun := CalcDate(nNyLunchStartDate, 1);
          HorizontalLineCustom((fNyLunchHigh+fNyLunchLow)/2, nNyLunchFill, 1, 0,
            "", 8, tpTopLeft, nNyLunchStartDate, nEndRun, (fNyLunchHigh-fNyLunchLow)/2, nNyLunchStartEff, nNyLunchEndEff);
          HorizontalLineCustom(fNyLunchHigh, nNyLunchColor, Espessura_Borda_Sessao, 0,
            "NY Lunch", 8, tpTopLeft, nNyLunchStartDate, nEndRun, 0, nNyLunchStartEff, nNyLunchEndEff);
          HorizontalLineCustom(fNyLunchLow, nNyLunchColor, Espessura_Borda_Sessao, 0,
            "", 8, tpTopLeft, nNyLunchStartDate, nEndRun, 0, nNyLunchStartEff, nNyLunchEndEff);
        end;

      if LastBarOnChart then
        begin
          if (nLu1E > 0) and (fLu1H > fLu1L) and (Max_Sessoes_Passadas >= 1) then
            begin
              HorizontalLineCustom((fLu1H+fLu1L)/2, nNyLunchFill, 1, 0, "", 8, tpTopLeft, nLu1S, nLu1E, (fLu1H-fLu1L)/2, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu1H, nNyLunchColor, Espessura_Borda_Sessao, 0, "NY Lunch", 8, tpTopLeft, nLu1S, nLu1E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu1L, nNyLunchColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLu1S, nLu1E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;
          if (nLu2E > 0) and (fLu2H > fLu2L) and (Max_Sessoes_Passadas >= 2) then
            begin
              HorizontalLineCustom((fLu2H+fLu2L)/2, nNyLunchFill, 1, 0, "", 8, tpTopLeft, nLu2S, nLu2E, (fLu2H-fLu2L)/2, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu2H, nNyLunchColor, Espessura_Borda_Sessao, 0, "NY Lunch", 8, tpTopLeft, nLu2S, nLu2E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu2L, nNyLunchColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLu2S, nLu2E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;
          if (nLu3E > 0) and (fLu3H > fLu3L) and (Max_Sessoes_Passadas >= 3) then
            begin
              HorizontalLineCustom((fLu3H+fLu3L)/2, nNyLunchFill, 1, 0, "", 8, tpTopLeft, nLu3S, nLu3E, (fLu3H-fLu3L)/2, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu3H, nNyLunchColor, Espessura_Borda_Sessao, 0, "NY Lunch", 8, tpTopLeft, nLu3S, nLu3E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu3L, nNyLunchColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLu3S, nLu3E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;
          if (nLu4E > 0) and (fLu4H > fLu4L) and (Max_Sessoes_Passadas >= 4) then
            begin
              HorizontalLineCustom((fLu4H+fLu4L)/2, nNyLunchFill, 1, 0, "", 8, tpTopLeft, nLu4S, nLu4E, (fLu4H-fLu4L)/2, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu4H, nNyLunchColor, Espessura_Borda_Sessao, 0, "NY Lunch", 8, tpTopLeft, nLu4S, nLu4E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu4L, nNyLunchColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLu4S, nLu4E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;
          if (nLu5E > 0) and (fLu5H > fLu5L) and (Max_Sessoes_Passadas >= 5) then
            begin
              HorizontalLineCustom((fLu5H+fLu5L)/2, nNyLunchFill, 1, 0, "", 8, tpTopLeft, nLu5S, nLu5E, (fLu5H-fLu5L)/2, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu5H, nNyLunchColor, Espessura_Borda_Sessao, 0, "NY Lunch", 8, tpTopLeft, nLu5S, nLu5E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu5L, nNyLunchColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nLu5S, nLu5E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;

          if Mostrar_Niveis_Sessao and (nLu1E > 0) and (fLu1H > fLu1L) then
            begin
              HorizontalLineCustom(fLu1H, nNyLunchColor, 1, 2, "NY Lunch High", 8, tpTopRight,
                nLu1E, 0, 0, nNyLunchEndEff, 2359);
              HorizontalLineCustom(fLu1L, nNyLunchColor, 1, 2, "NY Lunch Low", 8, tpBottomRight,
                nLu1E, 0, 0, nNyLunchEndEff, 2359);
            end;
        end;
    end;

  // =================== NY PM ===================
  fNyPmHigh := fNyPmHigh[1]; fNyPmLow := fNyPmLow[1];
  nNyPmStartDate := nNyPmStartDate[1];
  fPm1H := fPm1H[1]; fPm2H := fPm2H[1]; fPm3H := fPm3H[1]; fPm4H := fPm4H[1]; fPm5H := fPm5H[1];
  fPm1L := fPm1L[1]; fPm2L := fPm2L[1]; fPm3L := fPm3L[1]; fPm4L := fPm4L[1]; fPm5L := fPm5L[1];
  nPm1S := nPm1S[1]; nPm2S := nPm2S[1]; nPm3S := nPm3S[1]; nPm4S := nPm4S[1]; nPm5S := nPm5S[1];
  nPm1E := nPm1E[1]; nPm2E := nPm2E[1]; nPm3E := nPm3E[1]; nPm4E := nPm4E[1]; nPm5E := nPm5E[1];

  if Ativar_NY_PM then
    begin
      if nNyPmStartEff > nNyPmEndEff then
        bInNyPm := (nT >= nNyPmStartEff) or (nT < nNyPmEndEff)
      else
        bInNyPm := (nT >= nNyPmStartEff) and (nT < nNyPmEndEff);

      if bInNyPm and not bInNyPm[1] then
        begin
          fNyPmHigh := High; fNyPmLow := Low;
          if (nNyPmStartEff > nNyPmEndEff) and (nT < nNyPmEndEff) then
            nNyPmStartDate := CalcDate(Date, -1)
          else
            nNyPmStartDate := Date;
        end
      else if bInNyPm then
        begin
          if High > fNyPmHigh then fNyPmHigh := High;
          if Low  < fNyPmLow  then fNyPmLow  := Low;
        end
      else if bInNyPm[1] then
        begin
          fPm5H := fPm4H; fPm5L := fPm4L; nPm5S := nPm4S; nPm5E := nPm4E;
          fPm4H := fPm3H; fPm4L := fPm3L; nPm4S := nPm3S; nPm4E := nPm3E;
          fPm3H := fPm2H; fPm3L := fPm2L; nPm3S := nPm2S; nPm3E := nPm2E;
          fPm2H := fPm1H; fPm2L := fPm1L; nPm2S := nPm1S; nPm2E := nPm1E;
          fPm1H := fNyPmHigh; fPm1L := fNyPmLow; nPm1S := nNyPmStartDate;
          if nNyPmStartEff > nNyPmEndEff then
            nPm1E := CalcDate(nNyPmStartDate, 1)
          else
            nPm1E := nNyPmStartDate;
        end;

      if bInNyPm and LastBarOnChart and (fNyPmHigh > fNyPmLow) then
        begin
          nEndRun := nNyPmStartDate;
          if nNyPmStartEff > nNyPmEndEff then nEndRun := CalcDate(nNyPmStartDate, 1);
          HorizontalLineCustom((fNyPmHigh+fNyPmLow)/2, nNyPmFill, 1, 0,
            "", 8, tpTopLeft, nNyPmStartDate, nEndRun, (fNyPmHigh-fNyPmLow)/2, nNyPmStartEff, nNyPmEndEff);
          HorizontalLineCustom(fNyPmHigh, nNyPmColor, Espessura_Borda_Sessao, 0,
            "NY PM", 8, tpTopLeft, nNyPmStartDate, nEndRun, 0, nNyPmStartEff, nNyPmEndEff);
          HorizontalLineCustom(fNyPmLow, nNyPmColor, Espessura_Borda_Sessao, 0,
            "", 8, tpTopLeft, nNyPmStartDate, nEndRun, 0, nNyPmStartEff, nNyPmEndEff);
        end;

      if LastBarOnChart then
        begin
          if (nPm1E > 0) and (fPm1H > fPm1L) and (Max_Sessoes_Passadas >= 1) then
            begin
              HorizontalLineCustom((fPm1H+fPm1L)/2, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm1S, nPm1E, (fPm1H-fPm1L)/2, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm1H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm1S, nPm1E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm1L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm1S, nPm1E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm2E > 0) and (fPm2H > fPm2L) and (Max_Sessoes_Passadas >= 2) then
            begin
              HorizontalLineCustom((fPm2H+fPm2L)/2, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm2S, nPm2E, (fPm2H-fPm2L)/2, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm2H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm2S, nPm2E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm2L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm2S, nPm2E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm3E > 0) and (fPm3H > fPm3L) and (Max_Sessoes_Passadas >= 3) then
            begin
              HorizontalLineCustom((fPm3H+fPm3L)/2, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm3S, nPm3E, (fPm3H-fPm3L)/2, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm3H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm3S, nPm3E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm3L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm3S, nPm3E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm4E > 0) and (fPm4H > fPm4L) and (Max_Sessoes_Passadas >= 4) then
            begin
              HorizontalLineCustom((fPm4H+fPm4L)/2, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm4S, nPm4E, (fPm4H-fPm4L)/2, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm4H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm4S, nPm4E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm4L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm4S, nPm4E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm5E > 0) and (fPm5H > fPm5L) and (Max_Sessoes_Passadas >= 5) then
            begin
              HorizontalLineCustom((fPm5H+fPm5L)/2, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm5S, nPm5E, (fPm5H-fPm5L)/2, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm5H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm5S, nPm5E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm5L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm5S, nPm5E, 0, nNyPmStartEff, nNyPmEndEff);
            end;

          if Mostrar_Niveis_Sessao and (nPm1E > 0) and (fPm1H > fPm1L) then
            begin
              HorizontalLineCustom(fPm1H, nNyPmColor, 1, 2, "NY PM High", 8, tpTopRight,
                nPm1E, 0, 0, nNyPmEndEff, 2359);
              HorizontalLineCustom(fPm1L, nNyPmColor, 1, 2, "NY PM Low", 8, tpBottomRight,
                nPm1E, 0, 0, nNyPmEndEff, 2359);
            end;
        end;
    end;
end;
