// =========================================================================
// PSYCH LEVELS - Linhas horizontais em niveis redondos de preco
// =========================================================================
// Desenha uma linha em cada multiplo do Passo, em tres estilos:
//   - Regular:   multiplos do Passo (ex.: 29350)
//   - Destaque:  multiplos de Destaque_A_Cada (ex.: 29300)
//   - Maior:     multiplos de Maior_A_Cada (ex.: 29000)
//
// As linhas cobrem Niveis_Acima_Abaixo niveis em volta do preco e se
// estendem quando o preco anda. Cada nivel e desenhado uma unica vez:
// HorizontalLineCustom e aditivo e o Profit nao apaga o que ja desenhou.
// O intervalo desenhado e lido do valor atual e do [1], o que funciona
// tanto se o Profit mantiver a variavel entre ticks quanto se zerar.
// =========================================================================

input
  Tema_Escuro(true);
  Passo(50.0);
  Destaque_A_Cada(100.0);
  Maior_A_Cada(1000.0);
  Niveis_Acima_Abaixo(40);
  Precos_Regular(false);         // Escreve o preco nas linhas de cada tipo
  Precos_Destaque(true);
  Precos_Maior(true);
  Precos_A_Esquerda(false);      // false = preco na ponta direita da linha
  Casas_Decimais(0);

  Estilo_Regular(2);             // 0=solido, 1=traco longo, 2=traco curto
  Espessura_Regular(1);
  Estilo_Destaque(0);
  Espessura_Destaque(1);
  Estilo_Maior(0);
  Espessura_Maior(2);

var
  nRegularColor, nHighlightColor, nMajorColor : Integer;
  nCenter, nWantLow, nWantHigh, nFrom, nTo, i : Integer;
  nDrawnLow, nDrawnHigh : Integer;
  fLevel, fTolerance : Float;
  sLabel : String;
  nTextPos : Integer;
  bAlreadyDrawn, bMajor, bHighlight : Boolean;

begin
  if Tema_Escuro then begin
    nRegularColor := RGB(70, 70, 70);
    nHighlightColor := RGB(120, 120, 120);
    nMajorColor := RGB(190, 190, 190);
  end else begin
    nRegularColor := RGB(190, 190, 190);
    nHighlightColor := RGB(140, 140, 140);
    nMajorColor := RGB(70, 70, 70);
  end;

  if nDrawnHigh[1] > nDrawnHigh then
    nDrawnHigh := nDrawnHigh[1];
  if nDrawnLow[1] > 0 then begin
    if (nDrawnLow = 0) or (nDrawnLow[1] < nDrawnLow) then
      nDrawnLow := nDrawnLow[1];
  end;

  nTextPos := tpTopRight;
  if Precos_A_Esquerda then
    nTextPos := tpTopLeft;

  if LastBarOnChart and (Passo > 0) then begin
    nCenter := Round(Close / Passo);
    nWantLow := nCenter - Niveis_Acima_Abaixo;
    nWantHigh := nCenter + Niveis_Acima_Abaixo;
    if nWantLow < 1 then
      nWantLow := 1;

    // Tambem cobre o vao entre o intervalo ja desenhado e o novo, se o preco saltou.
    nFrom := nWantLow;
    nTo := nWantHigh;
    if nDrawnHigh > 0 then begin
      if nDrawnLow < nFrom then
        nFrom := nDrawnLow;
      if nDrawnHigh > nTo then
        nTo := nDrawnHigh;
    end;

    for i := nFrom to nTo do begin
      bAlreadyDrawn := (nDrawnHigh > 0) and (i >= nDrawnLow) and (i <= nDrawnHigh);
      if not bAlreadyDrawn then begin
        fLevel := i * Passo;
        fTolerance := fLevel * 0.0000000001;

        bMajor := false;
        if Maior_A_Cada > 0 then
          bMajor := Abs(fLevel - Round(fLevel / Maior_A_Cada) * Maior_A_Cada) <= fTolerance;
        bHighlight := false;
        if Destaque_A_Cada > 0 then
          bHighlight := Abs(fLevel - Round(fLevel / Destaque_A_Cada) * Destaque_A_Cada) <= fTolerance;

        sLabel := "";
        if (bMajor and Precos_Maior) or ((not bMajor) and bHighlight and Precos_Destaque)
           or ((not bMajor) and (not bHighlight) and Precos_Regular) then
          sLabel := FloatToString(fLevel, Casas_Decimais);

        if bMajor then
          HorizontalLineCustom(fLevel, nMajorColor, Espessura_Maior, Estilo_Maior, sLabel, 8, nTextPos)
        else if bHighlight then
          HorizontalLineCustom(fLevel, nHighlightColor, Espessura_Destaque, Estilo_Destaque, sLabel, 8, nTextPos)
        else
          HorizontalLineCustom(fLevel, nRegularColor, Espessura_Regular, Estilo_Regular, sLabel, 8, nTextPos);
      end;
    end;

    if (nDrawnLow = 0) or (nWantLow < nDrawnLow) then
      nDrawnLow := nWantLow;
    if nWantHigh > nDrawnHigh then
      nDrawnHigh := nWantHigh;
  end;
end;
