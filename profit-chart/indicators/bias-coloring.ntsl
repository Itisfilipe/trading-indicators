// =========================================================================
// BIAS INDICATOR - Regra de Coloracao
// =========================================================================
// Paints bricks based on position vs EMA:
//   - Green: Buy bias (brick opened and closed above EMA)
//   - Dark:  Sell bias (brick opened and closed below EMA)
//   - Brick crossing EMA keeps the previous bias
//
// IMPORTANT: This is a COLORING RULE, not an indicator!
// To apply: Right-click chart -> "Inserir Regra de Coloracao" -> Select this
// =========================================================================

input
  // EMA period for bias detection. Default: 55
  EMA_Period(55);

  // Buy bias color
  Bull_Color(clGreen);

  // Sell bias color
  Bear_Color(clRed);

var
  fEMA: Float;
  nBias: Integer; // 1 = buy, -1 = sell, 0 = undefined

begin
  fEMA := MediaExp(EMA_Period, Close);

  // Brick entirely above EMA -> buy bias
  if (Open > fEMA) and (Close > fEMA) then
    nBias := 1

  // Brick entirely below EMA -> sell bias
  else if (Open < fEMA) and (Close < fEMA) then
    nBias := -1;

  // Brick crossing EMA -> keeps previous bias (nBias unchanged)

  if nBias = 1 then
    PaintBar(Bull_Color)
  else if nBias = -1 then
    PaintBar(Bear_Color);

end;
