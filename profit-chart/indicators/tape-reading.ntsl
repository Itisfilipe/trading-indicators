// ============================================================================
// Tape Reading - Aggression Balance & Volume
// ============================================================================
//
// Shows aggression balance magnitude as a histogram above zero and
// volume as a histogram below zero, with MA-driven color intensity.
//
// Plot 1 (Histogram): |AgressionVolBuy - AgressionVolSell| (always above zero)
//   - Bright green: buying dominance, magnitude above MA (strong buying)
//   - Dim green:    buying dominance, magnitude below MA (weak buying)
//   - Bright red:   selling dominance, magnitude above MA (strong selling)
//   - Dim red:      selling dominance, magnitude below MA (weak selling)
//
// Plot 2 (Histogram): -Quantity scaled to aggression magnitude (always below zero)
//   - Bright blue: quantity >= its MA (high activity)
//   - Dim blue:    quantity <  its MA (low activity)
//
// Plot 3 (Line): SMA of aggression magnitude (white, always positive)
// Plot 4 (Line): -SMA of aggression magnitude (white, always negative, = scaled vol MA)
//
// Volume bars are scaled by (maSaldo / maVol) so both histograms have
// the same visual proportions. The MA lines are symmetric at +/- maSaldo.
//
// Inputs:
//   Tape_Days_Saldo - Dias para media do saldo de agressao (padrao 3)
//   Tape_Days_Vol   - Dias para media do volume (padrao 3)
// ============================================================================

input
  // Numero de dias para media do saldo de agressao
  Tape_Days_Saldo(3);

  // Numero de dias para media do volume
  Tape_Days_Vol(3);

var
  saldo : Float;
  absSaldo : Float;
  vol : Float;
  maSaldo : Float;
  maVol : Float;
  scale : Float;

  // Calculo de barras por dia
  nBarsToday: Integer;
  nBarsPerDay: Integer;
  nPeriodSaldo: Integer;
  nPeriodVol: Integer;
begin
  // Conta barras por dia para periodo dinamico da media
  if Date <> Date[1] then begin
    nBarsPerDay := nBarsToday;
    nBarsToday := 1;
  end else
    nBarsToday := nBarsToday + 1;

  if nBarsPerDay > 0 then begin
    nPeriodSaldo := nBarsPerDay * Tape_Days_Saldo;
    nPeriodVol := nBarsPerDay * Tape_Days_Vol;
  end else begin
    nPeriodSaldo := 500;
    nPeriodVol := 500;
  end;

  saldo := AgressionVolBuy - AgressionVolSell;
  if saldo >= 0 then
    absSaldo := saldo
  else
    absSaldo := -saldo;
  vol := QuantityVol(False, True);

  maSaldo := Media(nPeriodSaldo, absSaldo);
  maVol := Media(nPeriodVol, vol);

  // Fator de escala: normaliza volume para magnitude da agressao
  if maVol > 0 then
    scale := maSaldo / maVol
  else
    scale := 1;

  // --- Plot 1: Histograma do saldo de agressao (sempre acima de zero) ---
  // Verde = dominancia compradora, Vermelho = dominancia vendedora
  // Claro = magnitude acima da media (forte), Escuro = abaixo da media (fraco)
  SetPlotType(1, 1);
  if saldo >= 0 then
  begin
    if absSaldo >= maSaldo then
      SetPlotColor(1, RGB(0, 255, 0))     // Verde claro: compra forte
    else
      SetPlotColor(1, RGB(0, 160, 0));     // Verde escuro: compra fraca
  end
  else
  begin
    if absSaldo >= maSaldo then
      SetPlotColor(1, RGB(255, 0, 0))     // Vermelho claro: venda forte
    else
      SetPlotColor(1, RGB(180, 0, 0));     // Vermelho escuro: venda fraca
  end;
  Plot(absSaldo);

  // --- Plot 2: Histograma de quantidade (sempre abaixo de zero) ---
  // Claro = quantidade acima da media (alta atividade), Escuro = abaixo da media (baixa atividade)
  SetPlotType(2, 1);
  if vol >= maVol then
    SetPlotColor(2, RGB(0, 220, 255))     // Azul claro: alta atividade
  else
    SetPlotColor(2, RGB(0, 130, 200));     // Azul escuro: baixa atividade
  Plot2(-vol * scale);

  // --- Plot 3: Media do saldo de agressao (linha branca, territorio positivo) ---
  SetPlotColor(3, RGB(255, 255, 255));
  Plot3(maSaldo);

  // --- Plot 4: Media de volume escalada (linha branca, territorio negativo = -maSaldo) ---
  SetPlotColor(4, RGB(255, 255, 255));
  Plot4(-maSaldo);
end;
