// ============================================================================
// Tape Reading - Saldo de Agressao & Volume
// ============================================================================
//
// Mostra a forca dos compradores vs vendedores e o volume de contratos.
//
// Como ler:
//   ACIMA do zero = agressao (quem esta empurrando o preco)
//     - Verde = compradores dominando
//     - Vermelho = vendedores dominando
//     - Barra acima da linha branca = agressao ACIMA da media (forte)
//     - Barra cinza = agressao abaixo da media
//
//   ABAIXO do zero = volume de contratos
//     - Azul claro = volume acima da media (mercado ativo)
//     - Cinza = volume abaixo da media (mercado parado)
//
//   Linhas brancas = referencia da media (valor 1.0)
//   Valores normalizados: 1.0 = na media, 2.0 = 2x a media
// ============================================================================

input
  // Periodo da media do saldo de agressao. Padrao: 500
  Tape_MA_Saldo(500);

  // Periodo da media do volume. Padrao: 300
  Tape_MA_Vol(300);

  // Tema escuro (true) ou claro (false)
  Tema_Escuro(true);

var
  saldo: Float;         // saldo de agressao (compra - venda)
  absSaldo: Float;      // valor absoluto do saldo
  vol: Float;           // volume de contratos
  maSaldo: Float;       // media do saldo
  maVol: Float;         // media do volume
  fNormSaldo: Float;    // saldo normalizado (multiplo da media)
  fNormVol: Float;      // volume normalizado (multiplo da media)

  // Cores do tema
  nBuyStrong: Integer;
  nBuyWeak: Integer;
  nSellStrong: Integer;
  nSellWeak: Integer;
  nVolHigh: Integer;
  nVolLow: Integer;
  nLineColor: Integer;

begin
  // -----------------------------------------------------------------------
  // Define cores com base no tema
  // -----------------------------------------------------------------------
  if Tema_Escuro then begin
    nBuyStrong := RGB(61, 226, 149);     // verde do candle
    nBuyWeak := RGB(66, 78, 72);          // cinza esverdeado
    nSellStrong := RGB(226, 43, 61);    // vermelho do candle
    nSellWeak := RGB(80, 66, 68);         // cinza avermelhado
    nVolHigh := RGB(0, 200, 255);         // azul claro
    nVolLow := RGB(64, 72, 82);           // cinza azulado
    nLineColor := RGB(200, 200, 200);     // cinza claro
  end else begin
    nBuyStrong := RGB(0, 255, 0);         // verde vivo
    nBuyWeak := RGB(196, 210, 202);       // cinza esverdeado
    nSellStrong := RGB(255, 0, 0);        // vermelho vivo
    nSellWeak := RGB(214, 196, 198);      // cinza avermelhado
    nVolHigh := RGB(0, 220, 255);         // azul claro
    nVolLow := RGB(196, 204, 214);        // cinza azulado
    nLineColor := RGB(255, 255, 255);     // branco
  end;

  // -----------------------------------------------------------------------
  // Calcula saldo de agressao e volume
  // -----------------------------------------------------------------------
  saldo := AgressionVolBuy - AgressionVolSell;
  if saldo >= 0 then
    absSaldo := saldo
  else
    absSaldo := -saldo;
  vol := QuantityVol(False, True);

  maSaldo := Media(Tape_MA_Saldo, absSaldo);
  maVol := Media(Tape_MA_Vol, vol);

  // -----------------------------------------------------------------------
  // Normaliza como multiplo da media
  // Valor 1.0 = na media, 2.0 = 2x acima da media
  // -----------------------------------------------------------------------
  if maSaldo > 0 then
    fNormSaldo := absSaldo / maSaldo
  else
    fNormSaldo := 0;

  if maVol > 0 then
    fNormVol := vol / maVol
  else
    fNormVol := 0;

  // -----------------------------------------------------------------------
  // Histograma de agressao (acima do zero)
  // Verde = compradores, Vermelho = vendedores
  // Cor viva = acima da media, cinza = abaixo da media
  // -----------------------------------------------------------------------
  SetPlotType(1, 1);
  if saldo >= 0 then begin
    if fNormSaldo >= 1 then
      SetPlotColor(1, nBuyStrong)
    else
      SetPlotColor(1, nBuyWeak);
  end else begin
    if fNormSaldo >= 1 then
      SetPlotColor(1, nSellStrong)
    else
      SetPlotColor(1, nSellWeak);
  end;
  Plot(fNormSaldo);

  // -----------------------------------------------------------------------
  // Histograma de volume (abaixo do zero)
  // Azul claro = volume alto, cinza = volume baixo
  // -----------------------------------------------------------------------
  SetPlotType(2, 1);
  if fNormVol >= 1 then
    SetPlotColor(2, nVolHigh)
  else
    SetPlotColor(2, nVolLow);
  Plot2(-fNormVol);

  // -----------------------------------------------------------------------
  // Linhas de referencia nas medias (+1 e -1)
  // -----------------------------------------------------------------------
  SetPlotColor(3, nLineColor);
  Plot3(1);

  SetPlotColor(4, nLineColor);
  Plot4(-1);

end;
