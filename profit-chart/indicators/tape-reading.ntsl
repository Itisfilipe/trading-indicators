// ============================================================================
// Tape Reading - Saldo de Agressao & Volume
// ============================================================================
//
// Exibe a magnitude do saldo de agressao como histograma acima do zero
// e volume como histograma abaixo do zero, com intensidade de cor pela media.
//
// Ambos normalizados como multiplo da media (1.0 = na media, 2.0 = 2x).
//
// Plot 1 (Histograma): Agressao normalizada (acima do zero)
//   - Verde claro: dominancia compradora, acima da media (compra forte)
//   - Verde escuro: dominancia compradora, abaixo da media (compra fraca)
//   - Vermelho claro: dominancia vendedora, acima da media (venda forte)
//   - Vermelho escuro: dominancia vendedora, abaixo da media (venda fraca)
//
// Plot 2 (Histograma): Volume normalizado (abaixo do zero)
//   - Azul claro: acima da media (alta atividade)
//   - Azul escuro: abaixo da media (baixa atividade)
//
// Plot 3 (Linha): Referencia +1 (media da agressao)
// Plot 4 (Linha): Referencia -1 (media do volume)
//
// Inputs:
//   Tape_MA_Saldo - Periodo da media do saldo de agressao (padrao 500)
//   Tape_MA_Vol   - Periodo da media do volume (padrao 300)
// ============================================================================

input
  // Periodo da media do saldo de agressao. Padrao: 500
  Tape_MA_Saldo(500);

  // Periodo da media do volume. Padrao: 300
  Tape_MA_Vol(300);

var
  saldo : Float;
  absSaldo : Float;
  vol : Float;
  maSaldo : Float;
  maVol : Float;
  fNormSaldo : Float;
  fNormVol : Float;

begin
  saldo := AgressionVolBuy - AgressionVolSell;
  if saldo >= 0 then
    absSaldo := saldo
  else
    absSaldo := -saldo;
  vol := QuantityVol(False, True);

  maSaldo := Media(Tape_MA_Saldo, absSaldo);
  maVol := Media(Tape_MA_Vol, vol);

  // Normaliza como multiplo da media (1.0 = na media, 2.0 = 2x a media)
  if maSaldo > 0 then
    fNormSaldo := absSaldo / maSaldo
  else
    fNormSaldo := 0;

  if maVol > 0 then
    fNormVol := vol / maVol
  else
    fNormVol := 0;

  // --- Plot 1: Agressao normalizada (acima de zero) ---
  // Verde = dominancia compradora, Vermelho = dominancia vendedora
  // Claro = acima da media (forte), Escuro = abaixo da media (fraco)
  SetPlotType(1, 1);
  if saldo >= 0 then begin
    if fNormSaldo >= 1 then
      SetPlotColor(1, RGB(0, 255, 0))
    else
      SetPlotColor(1, RGB(0, 160, 0));
  end else begin
    if fNormSaldo >= 1 then
      SetPlotColor(1, RGB(255, 0, 0))
    else
      SetPlotColor(1, RGB(180, 0, 0));
  end;
  Plot(fNormSaldo);

  // --- Plot 2: Volume normalizado (abaixo de zero) ---
  // Claro = acima da media (alta atividade), Escuro = abaixo da media
  SetPlotType(2, 1);
  if fNormVol >= 1 then
    SetPlotColor(2, RGB(0, 220, 255))
  else
    SetPlotColor(2, RGB(0, 130, 200));
  Plot2(-fNormVol);

  // --- Plot 3: Linha de referencia +1 (media da agressao) ---
  SetPlotColor(3, RGB(255, 255, 255));
  Plot3(1);

  // --- Plot 4: Linha de referencia -1 (media do volume) ---
  SetPlotColor(4, RGB(255, 255, 255));
  Plot4(-1);
end;
