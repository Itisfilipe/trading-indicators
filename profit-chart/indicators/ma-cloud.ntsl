// =========================================================================
// MOVING AVERAGES CLOUD - Nuvem de Medias Moveis
// =========================================================================
// Exibe 2 EMAs que formam uma "nuvem" entre elas.
//
// O que faz:
//   - Verde quando a EMA rapida esta acima da lenta (tendencia de alta)
//   - Vermelho quando a EMA rapida esta abaixo da lenta (tendencia de baixa)
//   - Cinza quando o preco contradiz a tendencia (sinal de cautela)
//
// Para ativar o preenchimento da nuvem:
//   1. Clique direito em uma das linhas no grafico
//   2. Selecione "Propriedades"
//   3. Aba "Preenchimento" -> Marque "Preencher entre linhas"
//   4. Selecione Plot 1 e Plot 2 como limites
// =========================================================================

input
  // Periodo da EMA rapida (reage mais rapido ao preco). Padrao: 21
  Periodo_EMA_Rapida(21);

  // Periodo da EMA lenta (suaviza o movimento). Padrao: 42
  Periodo_EMA_Lenta(42);

  // Tema escuro (true) ou claro (false)
  Tema_Escuro(false);

var
  fEmaFast: Float;      // EMA rapida
  fEmaSlow: Float;      // EMA lenta
  fEmaMax: Float;       // a maior das duas EMAs
  fEmaMin: Float;       // a menor das duas EMAs
  nCurrentColor: Integer;

  // Cores do tema
  nBullColor: Integer;
  nBearColor: Integer;
  nNeutralColor: Integer;

begin
  // -----------------------------------------------------------------------
  // Define cores com base no tema
  // -----------------------------------------------------------------------
  if Tema_Escuro then begin
    nBullColor := RGB(0, 200, 0);         // verde vivo
    nBearColor := RGB(200, 0, 0);         // vermelho vivo
    nNeutralColor := RGB(80, 80, 80);     // cinza escuro
  end else begin
    nBullColor := RGB(0, 180, 80);        // verde
    nBearColor := RGB(220, 50, 50);       // vermelho
    nNeutralColor := RGB(128, 128, 128);  // cinza
  end;

  // -----------------------------------------------------------------------
  // Calcula as duas EMAs
  // -----------------------------------------------------------------------
  fEmaFast := MediaExp(Periodo_EMA_Rapida, Close);
  fEmaSlow := MediaExp(Periodo_EMA_Lenta, Close);

  if fEmaFast > fEmaSlow then begin
    fEmaMax := fEmaFast;
    fEmaMin := fEmaSlow;
  end else begin
    fEmaMax := fEmaSlow;
    fEmaMin := fEmaFast;
  end;

  // -----------------------------------------------------------------------
  // Escolhe a cor:
  //   - Verde se tendencia de alta E preco confirma (acima da menor EMA)
  //   - Vermelho se tendencia de baixa E preco confirma (abaixo da maior EMA)
  //   - Cinza se o preco contradiz a tendencia (cuidado!)
  // -----------------------------------------------------------------------
  if (fEmaFast > fEmaSlow) and (Close >= fEmaMin) then
    nCurrentColor := nBullColor
  else if (fEmaFast < fEmaSlow) and (Close <= fEmaMax) then
    nCurrentColor := nBearColor
  else
    nCurrentColor := nNeutralColor;

  // -----------------------------------------------------------------------
  // Desenha as duas EMAs com a mesma cor
  // -----------------------------------------------------------------------
  PlotN(1, fEmaFast);
  SetPlotColor(1, nCurrentColor);
  SetPlotWidth(1, 2);

  PlotN(2, fEmaSlow);
  SetPlotColor(2, nCurrentColor);
  SetPlotWidth(2, 2);

end;
