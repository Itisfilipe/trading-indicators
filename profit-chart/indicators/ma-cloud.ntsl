// =========================================================================
// MOVING AVERAGES CLOUD - Nuvem de Medias Moveis
// =========================================================================
// Exibe 2 EMAs com coloracao dinamica baseada no alinhamento:
//   - VERDE: Alinhamento de alta (rapida > lenta) e preco confirma
//   - VERMELHO: Alinhamento de baixa (rapida < lenta) e preco confirma
//   - CINZA: Preco contradiz a tendencia
//
// =========================================================================
// COMO ATIVAR O PREENCHIMENTO DA NUVEM (feito na interface):
// =========================================================================
// 1. Aplique este indicador no grafico
// 2. Clique direito em uma das linhas EMA no grafico
// 3. Selecione "Propriedades" ou "Editar"
// 4. Va na aba "Preenchimento"
// 5. Marque "Preencher entre linhas"
// 6. Selecione "Plot 1" e "Plot 2" como limites
// 7. Escolha uma cor de preenchimento
// =========================================================================

input
  // Periodo da media movel exponencial rapida. Padrao: 21
  Periodo_EMA_Rapida(21);

  // Periodo da media movel exponencial lenta. Padrao: 42
  Periodo_EMA_Lenta(42);

var
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaMax: Float;
  fEmaMin: Float;
  nCurrentColor: Integer;

begin
  // -----------------------------------------------------------------------
  // Calcula EMAs
  // -----------------------------------------------------------------------
  fEmaFast := MediaExp(Periodo_EMA_Rapida, Close);
  fEmaSlow := MediaExp(Periodo_EMA_Lenta, Close);

  if fEmaFast > fEmaSlow then begin
    fEmaMax := fEmaFast;
    fEmaMin := fEmaSlow;
  end else begin
    fEmaMax := fEmaSlow;
    fEmaMin := fEmaFast;
  end;

  // -----------------------------------------------------------------------
  // Determina cor (cinza quando preco contradiz a tendencia)
  // -----------------------------------------------------------------------
  if (fEmaFast > fEmaSlow) and (Close >= fEmaMin) then
    nCurrentColor := RGB(0, 180, 80)
  else if (fEmaFast < fEmaSlow) and (Close <= fEmaMax) then
    nCurrentColor := RGB(220, 50, 50)
  else
    nCurrentColor := RGB(128, 128, 128);

  // -----------------------------------------------------------------------
  // Plota EMAs
  // -----------------------------------------------------------------------
  PlotN(1, fEmaFast);
  SetPlotColor(1, nCurrentColor);
  SetPlotWidth(1, 2);

  PlotN(2, fEmaSlow);
  SetPlotColor(2, nCurrentColor);
  SetPlotWidth(2, 2);

end;
