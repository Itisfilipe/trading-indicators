// =========================================================================
// CONFLUENCE COLORING - Coloring Rule (Regra de Coloracao)
// =========================================================================
// Colors candle bars based on multiple signal rules. Each rule produces a
// bullish/bearish boolean. The color mapping combines them:
//
// Colors:
//   - STRONG ENTRY: tape + both MACDs + EMA pullback (bright blue)
//   - WEAK ENTRY:   tape + one MACD + EMA pullback (dark blue)
//
// Current rules:
//   1. Major MACD histogram (longer-term direction)
//   2. Minor MACD histogram (short-term confirmation)
//   3. Tape reading (volume + aggression aligned with candle direction)
//   4. EMA pullback entry (direction change near an EMA, not past it)
//
// To add a new rule:
//   1. Add inputs for the new indicator
//   2. Add variables for the calculation
//   3. Calculate the indicator and set a boolean signal (bXxxBullish)
//   4. Update the color mapping section
//
// IMPORTANT: This is a COLORING RULE, not an indicator!
// To apply: Right-click chart -> "Inserir Regra de Coloracao" -> Select this
// =========================================================================

input
  // ----- Major MACD (longer-term) -----

  // Major MACD fast EMA period. Default: 200
  Major_MACD_Fast(200);

  // Major MACD slow EMA period. Default: 800
  Major_MACD_Slow(800);

  // Major MACD signal line period. Default: 50
  Major_MACD_Signal(50);

  // ----- Minor MACD (short-term) -----

  // Minor MACD fast EMA period. Default: 72
  Minor_MACD_Fast(72);

  // Minor MACD slow EMA period. Default: 200
  Minor_MACD_Slow(200);

  // Minor MACD signal line period. Default: 34
  Minor_MACD_Signal(34);

  // ----- Tape Reading -----

  // Tape aggression balance MA period. Default: 305
  Tape_MA_Balance(305);

  // Tape volume MA period. Default: 305
  Tape_MA_Volume(305);

  // ----- EMA Trend Filter -----

  // Fast EMA period for trend filter. Default: 21
  EMA_Fast(21);

  // Slow EMA period for trend filter. Default: 42
  EMA_Slow(42);

  // ----- Enable/Disable Rules (0 = disabled, 1 = enabled) -----

  // Enable major MACD filter. Default: 1
  Enable_Major_MACD(1);

  // Enable minor MACD filter. Default: 1
  Enable_Minor_MACD(1);

  // Enable tape reading filter. Default: 1
  Enable_Tape(1);

  // Loose tape: trigger if volume OR aggression above average (ignores direction). Default: 0
  Tape_Loose(0);

  // Enable EMA pullback entry (core trigger). Default: 1
  Enable_EMA(1);

  // Require pullback (opposite brick in last 3) before entry. Default: 1
  Enable_Pullback(1);

  // Require pullback bricks stay on correct side of slow EMA. Default: 1
  Enable_Not_Crossed(1);

var
  // Major MACD components
  fMajorMacdLine: Float;
  fMajorSignalLine: Float;
  fMajorHistogram: Float;

  // Minor MACD components
  fMinorMacdLine: Float;
  fMinorSignalLine: Float;
  fMinorHistogram: Float;

  // Tape reading components
  fBalance: Float;
  fAbsBalance: Float;
  fVol: Float;
  fMaBalance: Float;
  fMaVol: Float;

  // EMA alignment components
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaUpper: Float;
  fEmaLower: Float;
  bBrickTouchesEma: Boolean;

  // Signal booleans
  bMajorBullish: Boolean;
  bMinorBullish: Boolean;
  bTapeHighlight: Boolean;
  bTapeBullish: Boolean;
  bEmaBullish: Boolean;
  bEmaBearish: Boolean;

  // MACD confluence (enable-aware)
  bMacdAllBull: Boolean;
  bMacdAnyBull: Boolean;
  bMacdAllBear: Boolean;
  bMacdAnyBear: Boolean;

  // Final trigger results
  bStrongBull: Boolean;
  bStrongBear: Boolean;
  bWeakBull: Boolean;
  bWeakBear: Boolean;

begin
  // -----------------------------------------------------------------------
  // Rule 1: Major MACD Histogram
  // -----------------------------------------------------------------------
  fMajorMacdLine := MediaExp(Major_MACD_Fast, Close) - MediaExp(Major_MACD_Slow, Close);
  fMajorSignalLine := MediaExp(Major_MACD_Signal, fMajorMacdLine);
  fMajorHistogram := fMajorMacdLine - fMajorSignalLine;
  bMajorBullish := fMajorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Rule 2: Minor MACD Histogram
  // -----------------------------------------------------------------------
  fMinorMacdLine := MediaExp(Minor_MACD_Fast, Close) - MediaExp(Minor_MACD_Slow, Close);
  fMinorSignalLine := MediaExp(Minor_MACD_Signal, fMinorMacdLine);
  fMinorHistogram := fMinorMacdLine - fMinorSignalLine;
  bMinorBullish := fMinorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Rule 3: Tape Reading (volume + aggression aligned with candle)
  // -----------------------------------------------------------------------
  fBalance := AgressionVolBuy - AgressionVolSell;
  bTapeBullish := fBalance >= 0;
  if bTapeBullish then
    fAbsBalance := fBalance
  else
    fAbsBalance := -fBalance;
  fVol := QuantityVol(False, True);
  fMaBalance := Media(Tape_MA_Balance, fAbsBalance);
  fMaVol := Media(Tape_MA_Volume, fVol);

  // Highlight when volume AND aggression are both above their MAs
  // AND aggression direction aligns with candle direction
  if Enable_Tape < 1 then begin
    bTapeHighlight := True;
    bTapeBullish := Close >= Open;
  end else if Tape_Loose >= 1 then begin
    bTapeHighlight := (fVol >= fMaVol) or (fAbsBalance >= fMaBalance);
    bTapeBullish := Close >= Open;
  end else begin
    bTapeHighlight := (fVol >= fMaVol) and (fAbsBalance >= fMaBalance)
      and (  (bTapeBullish and (Close >= Open))
          or ((not bTapeBullish) and (Close < Open)));
  end;

  // -----------------------------------------------------------------------
  // Rule 4: EMA Pullback Entry
  // -----------------------------------------------------------------------
  // Detects: trend bricks -> opposite bricks (pullback) -> first trend brick
  // near an EMA. The entry brick must not open and close past the EMAs.
  fEmaFast := MediaExp(EMA_Fast, Close);
  fEmaSlow := MediaExp(EMA_Slow, Close);

  // EMA zone boundaries
  if fEmaFast >= fEmaSlow then begin
    fEmaUpper := fEmaFast;
    fEmaLower := fEmaSlow;
  end else begin
    fEmaUpper := fEmaSlow;
    fEmaLower := fEmaFast;
  end;

  // Brick touches or crosses the EMA zone (overlap between [Low,High] and [EmaLower,EmaUpper])
  bBrickTouchesEma := (Low <= fEmaUpper) and (High >= fEmaLower);

  // Bullish pullback entry:
  //   - Uptrend (fast EMA > slow EMA)
  //   - Current brick is green
  //   - Brick touches or crosses the EMA zone
  //   - [toggleable] Pullback within last 3 bricks
  //   - [toggleable] Not crossed: Close above slow EMA, no brick entirely below it
  bEmaBullish := (fEmaFast > fEmaSlow)
    and (Close >= Open)
    and bBrickTouchesEma
    and ((Enable_Pullback < 1) or (Close[1] < Open[1]) or (Close[2] < Open[2]) or (Close[3] < Open[3]))
    and ((Enable_Not_Crossed < 1) or (Close >= fEmaSlow))
    and ((Enable_Not_Crossed < 1) or (Open[1] >= fEmaSlow[1]) or (Close[1] >= fEmaSlow[1]))
    and ((Enable_Not_Crossed < 1) or (Open[2] >= fEmaSlow[2]) or (Close[2] >= fEmaSlow[2]))
    and ((Enable_Not_Crossed < 1) or (Open[3] >= fEmaSlow[3]) or (Close[3] >= fEmaSlow[3]));

  // Bearish pullback entry (mirror):
  //   - Downtrend (fast EMA < slow EMA)
  //   - Current brick is red
  //   - Brick touches or crosses the EMA zone
  //   - [toggleable] Pullback within last 3 bricks
  //   - [toggleable] Not crossed: Close below slow EMA, no brick entirely above it
  bEmaBearish := (fEmaFast < fEmaSlow)
    and (Close < Open)
    and bBrickTouchesEma
    and ((Enable_Pullback < 1) or (Close[1] >= Open[1]) or (Close[2] >= Open[2]) or (Close[3] >= Open[3]))
    and ((Enable_Not_Crossed < 1) or (Close <= fEmaSlow))
    and ((Enable_Not_Crossed < 1) or (Open[1] <= fEmaSlow[1]) or (Close[1] <= fEmaSlow[1]))
    and ((Enable_Not_Crossed < 1) or (Open[2] <= fEmaSlow[2]) or (Close[2] <= fEmaSlow[2]))
    and ((Enable_Not_Crossed < 1) or (Open[3] <= fEmaSlow[3]) or (Close[3] <= fEmaSlow[3]));

  // -----------------------------------------------------------------------
  // MACD Confluence (enable-aware)
  // -----------------------------------------------------------------------
  // "All" = every enabled MACD agrees (disabled ones are ignored, not counted)
  // "Any" = at least one enabled MACD agrees (or both disabled = no filter)
  bMacdAllBull := ((Enable_Major_MACD < 1) or bMajorBullish)
    and ((Enable_Minor_MACD < 1) or bMinorBullish);
  bMacdAnyBull := ((Enable_Major_MACD >= 1) and bMajorBullish)
    or ((Enable_Minor_MACD >= 1) and bMinorBullish)
    or ((Enable_Major_MACD < 1) and (Enable_Minor_MACD < 1));

  bMacdAllBear := ((Enable_Major_MACD < 1) or (not bMajorBullish))
    and ((Enable_Minor_MACD < 1) or (not bMinorBullish));
  bMacdAnyBear := ((Enable_Major_MACD >= 1) and (not bMajorBullish))
    or ((Enable_Minor_MACD >= 1) and (not bMinorBullish))
    or ((Enable_Major_MACD < 1) and (Enable_Minor_MACD < 1));

  // -----------------------------------------------------------------------
  // Final Trigger Computation
  // -----------------------------------------------------------------------
  bStrongBull := (Enable_EMA >= 1) and bEmaBullish
    and bTapeHighlight and bTapeBullish and bMacdAllBull;
  bStrongBear := (Enable_EMA >= 1) and bEmaBearish
    and bTapeHighlight and (not bTapeBullish) and bMacdAllBear;
  bWeakBull := (Enable_EMA >= 1) and bEmaBullish
    and bTapeHighlight and bTapeBullish and bMacdAnyBull;
  bWeakBear := (Enable_EMA >= 1) and bEmaBearish
    and bTapeHighlight and (not bTapeBullish) and bMacdAnyBear;

  // -----------------------------------------------------------------------
  // Color Mapping
  // -----------------------------------------------------------------------
  if bStrongBull or bStrongBear then
    PaintBar(RGB(0, 120, 255))
  else if bWeakBull or bWeakBear then
    PaintBar(RGB(0, 80, 160));

end;
