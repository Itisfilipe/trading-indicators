// =========================================================================
// CONFLUENCE COLORING - Regra de Coloracao
// =========================================================================
// Pinta candles/bricks com base em multiplas regras de confluencia.
//
// Tipos de sinal:
//   - STRONG: a favor do MACD maior + tape a favor + pullback na EMA (azul / vermelho)
//   - SCALP:  contra MACD maior + MACD menor confirma + tape a favor (azul / vermelho suave)
//   - REJ:    a favor do MACD maior + tape contra + pavio confirma rejeicao
//   - REJS:   contra MACD maior + MACD menor confirma + tape contra + pavio
//
// Regras:
//   1. MACD maior (regime de tendencia — strong vs scalp)
//   2. MACD menor (habilita scalps contra-tendencia)
//   3. Tape reading (volume + agressao acima da media de N dias)
//   4. Pullback na EMA (brick na zona das EMAs apos pullback)
//
// IMPORTANTE: Criar como REGRA DE COLORACAO (nao como Indicador)
// Editor de Estrategias -> Nova Estrategia -> Coloracao
// =========================================================================

input
  // ----- MACD Maior (tendencia de longo prazo) -----

  // Periodo da EMA rapida do MACD maior. Padrao: 200
  Major_MACD_Fast(200);

  // Periodo da EMA lenta do MACD maior. Padrao: 800
  Major_MACD_Slow(800);

  // Periodo da linha de sinal do MACD maior. Padrao: 50
  Major_MACD_Signal(50);

  // ----- MACD Menor (curto prazo) -----

  // Periodo da EMA rapida do MACD menor. Padrao: 72
  Minor_MACD_Fast(72);

  // Periodo da EMA lenta do MACD menor. Padrao: 200
  Minor_MACD_Slow(200);

  // Periodo da linha de sinal do MACD menor. Padrao: 34
  Minor_MACD_Signal(34);

  // ----- Tape Reading -----

  // Periodo da media de agressao do tape. Padrao: 500
  Tape_MA_Saldo(500);

  // Periodo da media de volume do tape. Padrao: 300
  Tape_MA_Vol(300);

  // ----- Filtro de Tendencia (EMAs) -----

  // Periodo da EMA rapida. Padrao: 21
  EMA_Fast(21);

  // Periodo da EMA lenta. Padrao: 42
  EMA_Slow(42);

  // ----- Ativar/Desativar Regras -----

  // Exigir volume acima da media para tape
  Tape_Require_Volume(true);

  // Exigir agressao acima da media para tape
  Tape_Require_Aggression(true);

  // Razao minima pavio/corpo para rejeicao. Padrao: 1.5
  Rej_Wick_Ratio(1.5);

  // Ativar entrada por pullback na EMA (gatilho principal)
  Enable_EMA(true);

  // Exigir pullback (brick oposto nos ultimos 3) antes da entrada
  Enable_Pullback(true);

  // Cor da tendencia baseada no MACD maior (true) ou menor (false)
  Trend_Follow_Major(true);

  // Tema escuro (true) ou claro (false)
  Tema_Escuro(false);

var
  // Componentes do MACD maior
  fMajorMacdLine: Float;
  fMajorSignalLine: Float;
  fMajorHistogram: Float;

  // Componentes do MACD menor
  fMinorMacdLine: Float;
  fMinorSignalLine: Float;
  fMinorHistogram: Float;

  // Componentes do tape reading
  fBalance: Float;
  fAbsBalance: Float;
  fVol: Float;
  fMaBalance: Float;
  fMaVol: Float;

  // Componentes de alinhamento EMA
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaUpper: Float;
  fEmaLower: Float;
  bBrickTouchesEma: Boolean;
  nCrossed: Integer;

  // Sinais booleanos
  bMajorBullish: Boolean;
  bMinorBullish: Boolean;
  bTapeHighlight: Boolean;
  bTapeBullish: Boolean;
  bTapeWithTrend: Boolean;
  bEmaBullish: Boolean;
  bEmaBearish: Boolean;

  // Componentes de rejeicao
  fBody: Float;
  fBottomWick: Float;
  fTopWick: Float;
  bRejBullWick: Boolean;
  bRejBearWick: Boolean;

  // Cores do tema
  nTriggerBull: Integer;
  nTriggerBear: Integer;
  nScalpBullColor: Integer;
  nScalpBearColor: Integer;
  nTrendStrong: Integer;
  nTrendStrongBear: Integer;
  nTrendSoft: Integer;
  nTrendSoftBear: Integer;

  // Resultados finais dos gatilhos
  bStrongBull: Boolean;
  bStrongBear: Boolean;
  bScalpBull: Boolean;
  bScalpBear: Boolean;
  bRejBull: Boolean;
  bRejBear: Boolean;
  bRejsBull: Boolean;
  bRejsBear: Boolean;

begin
  // -----------------------------------------------------------------------
  // Cores do Tema
  // -----------------------------------------------------------------------
  if Tema_Escuro then begin
    nTriggerBull := RGB(0, 120, 255);     // azul
    nTriggerBear := RGB(255, 0, 255);     // fucsia
    nScalpBullColor := RGB(0, 80, 180);   // azul escuro
    nScalpBearColor := RGB(180, 0, 180);  // fucsia escuro
    nTrendStrong := RGB(0, 180, 0);       // verde vivo
    nTrendStrongBear := RGB(200, 0, 0);   // vermelho vivo
    nTrendSoft := RGB(0, 100, 0);         // verde escuro
    nTrendSoftBear := RGB(100, 0, 0);     // vermelho escuro
  end else begin
    nTriggerBull := RGB(0, 120, 255);     // azul
    nTriggerBear := RGB(255, 0, 0);       // vermelho
    nScalpBullColor := RGB(100, 180, 255); // azul claro
    nScalpBearColor := RGB(160, 0, 0);    // vermelho escuro
    nTrendStrong := RGB(0, 120, 0);       // verde
    nTrendStrongBear := RGB(30, 30, 30);  // preto
    nTrendSoft := RGB(140, 210, 140);     // verde claro
    nTrendSoftBear := RGB(130, 130, 130); // cinza
  end;

  // -----------------------------------------------------------------------
  // Regra 1: Histograma MACD Maior
  // -----------------------------------------------------------------------
  fMajorMacdLine := MediaExp(Major_MACD_Fast, Close) - MediaExp(Major_MACD_Slow, Close);
  fMajorSignalLine := MediaExp(Major_MACD_Signal, fMajorMacdLine);
  fMajorHistogram := fMajorMacdLine - fMajorSignalLine;
  bMajorBullish := fMajorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Regra 2: Histograma MACD Menor
  // -----------------------------------------------------------------------
  fMinorMacdLine := MediaExp(Minor_MACD_Fast, Close) - MediaExp(Minor_MACD_Slow, Close);
  fMinorSignalLine := MediaExp(Minor_MACD_Signal, fMinorMacdLine);
  fMinorHistogram := fMinorMacdLine - fMinorSignalLine;
  bMinorBullish := fMinorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Regra 3: Tape Reading (volume + agressao)
  // -----------------------------------------------------------------------
  fBalance := AgressionVolBuy - AgressionVolSell;
  bTapeBullish := fBalance >= 0;
  if bTapeBullish then
    fAbsBalance := fBalance
  else
    fAbsBalance := -fBalance;
  fVol := QuantityVol(False, True);
  fMaBalance := Media(Tape_MA_Saldo, fAbsBalance);
  fMaVol := Media(Tape_MA_Vol, fVol);

  // Tape ativo: volume e agressao acima da media
  bTapeHighlight := (not Tape_Require_Volume or (fVol >= fMaVol))
    and (not Tape_Require_Aggression or (fAbsBalance >= fMaBalance));

  // Direcao do tape: agressao alinhada com o candle?
  bTapeWithTrend := (bTapeBullish and (Close >= Open))
    or ((not bTapeBullish) and (Close < Open));

  // Rejeicao: agressao contra tendencia + pavio >= razao * corpo
  if Close >= Open then
    fBody := Close - Open
  else
    fBody := Open - Close;
  if fBody = 0 then
    fBody := 1;

  // Pavio inferior: da borda inferior do corpo ate Low (rejeicao de compra)
  if Open <= Close then
    fBottomWick := Open - Low
  else
    fBottomWick := Close - Low;

  // Pavio superior: da borda superior do corpo ate High (rejeicao de venda)
  if Open <= Close then
    fTopWick := High - Close
  else
    fTopWick := High - Open;

  bRejBullWick := (not bTapeWithTrend) and bTapeHighlight
    and (fBottomWick >= Rej_Wick_Ratio * fBody);
  bRejBearWick := (not bTapeWithTrend) and bTapeHighlight
    and (fTopWick >= Rej_Wick_Ratio * fBody);

  // -----------------------------------------------------------------------
  // Regra 4: Entrada por Pullback na EMA
  // -----------------------------------------------------------------------
  // Detecta: bricks na tendencia -> bricks opostos (pullback) -> primeiro
  // brick na direcao da tendencia tocando a zona das EMAs.
  fEmaFast := MediaExp(EMA_Fast, Close);
  fEmaSlow := MediaExp(EMA_Slow, Close);

  // Limites da zona das EMAs
  if fEmaFast >= fEmaSlow then begin
    fEmaUpper := fEmaFast;
    fEmaLower := fEmaSlow;
  end else begin
    fEmaUpper := fEmaSlow;
    fEmaLower := fEmaFast;
  end;

  // Brick toca ou cruza a zona das EMAs
  bBrickTouchesEma := (Low <= fEmaUpper) and (High >= fEmaLower);

  // Entrada de compra por pullback:
  //   - Tendencia de alta (EMA rapida > EMA lenta)
  //   - Brick atual e verde
  //   - Brick toca a zona das EMAs
  //   - [opcao] Pullback nos ultimos 3 bricks
  //   - Close acima da EMA lenta
  //   - No maximo 1 brick inteiramente abaixo da EMA lenta
  nCrossed := 0;
  if (Open[1] < fEmaSlow[1]) and (Close[1] < fEmaSlow[1]) then
    nCrossed := nCrossed + 1;
  if (Open[2] < fEmaSlow[2]) and (Close[2] < fEmaSlow[2]) then
    nCrossed := nCrossed + 1;
  if (Open[3] < fEmaSlow[3]) and (Close[3] < fEmaSlow[3]) then
    nCrossed := nCrossed + 1;

  bEmaBullish := (fEmaFast > fEmaSlow)
    and (Close >= Open)
    and bBrickTouchesEma
    and ((not Enable_Pullback) or (Close[1] < Open[1]) or (Close[2] < Open[2]) or (Close[3] < Open[3]))
    and (Close >= fEmaSlow)
    and (nCrossed <= 1);

  // Entrada de venda por pullback (espelho):
  //   - Tendencia de baixa (EMA rapida < EMA lenta)
  //   - Brick atual e vermelho
  //   - Brick toca a zona das EMAs
  //   - [opcao] Pullback nos ultimos 3 bricks
  //   - Close abaixo da EMA lenta
  //   - No maximo 1 brick inteiramente acima da EMA lenta
  nCrossed := 0;
  if (Open[1] > fEmaSlow[1]) and (Close[1] > fEmaSlow[1]) then
    nCrossed := nCrossed + 1;
  if (Open[2] > fEmaSlow[2]) and (Close[2] > fEmaSlow[2]) then
    nCrossed := nCrossed + 1;
  if (Open[3] > fEmaSlow[3]) and (Close[3] > fEmaSlow[3]) then
    nCrossed := nCrossed + 1;

  bEmaBearish := (fEmaFast < fEmaSlow)
    and (Close < Open)
    and bBrickTouchesEma
    and ((not Enable_Pullback) or (Close[1] >= Open[1]) or (Close[2] >= Open[2]) or (Close[3] >= Open[3]))
    and (Close <= fEmaSlow)
    and (nCrossed <= 1);

  // -----------------------------------------------------------------------
  // Calculo Final dos Gatilhos
  // -----------------------------------------------------------------------
  // Strong: direcao do sinal a favor do MACD maior (menor irrelevante)
  // Scalp: direcao contra MACD maior, menor confirmou a virada
  bStrongBull := Enable_EMA and bEmaBullish
    and bTapeHighlight and bTapeWithTrend
    and bMajorBullish;
  bStrongBear := Enable_EMA and bEmaBearish
    and bTapeHighlight and bTapeWithTrend
    and (not bMajorBullish);
  bScalpBull := Enable_EMA and bEmaBullish
    and bTapeHighlight and bTapeWithTrend
    and (not bMajorBullish) and bMinorBullish;
  bScalpBear := Enable_EMA and bEmaBearish
    and bTapeHighlight and bTapeWithTrend
    and bMajorBullish and (not bMinorBullish);

  // Rejeicao: mesma logica strong/scalp + agressao contra + pavio confirma
  bRejBull := Enable_EMA and bEmaBullish and bRejBullWick
    and bMajorBullish;
  bRejBear := Enable_EMA and bEmaBearish and bRejBearWick
    and (not bMajorBullish);
  bRejsBull := Enable_EMA and bEmaBullish and bRejBullWick
    and (not bMajorBullish) and bMinorBullish;
  bRejsBear := Enable_EMA and bEmaBearish and bRejBearWick
    and bMajorBullish and (not bMinorBullish);

  // -----------------------------------------------------------------------
  // Mapeamento de Cores
  // -----------------------------------------------------------------------

  // Gatilhos normais (agressao a favor)
  if bStrongBull then
    PaintBar(nTriggerBull)
  else if bStrongBear then
    PaintBar(nTriggerBear)
  else if bScalpBull then
    PaintBar(nScalpBullColor)
  else if bScalpBear then
    PaintBar(nScalpBearColor)

  // Gatilhos de rejeicao (mesmas cores, labels diferenciam)
  else if bRejBull then
    PaintBar(nTriggerBull)
  else if bRejBear then
    PaintBar(nTriggerBear)
  else if bRejsBull then
    PaintBar(nScalpBullColor)
  else if bRejsBear then
    PaintBar(nScalpBearColor)

  // Tendencia: ambos MACDs alinhados (forte)
  else if bMajorBullish and bMinorBullish then
    PaintBar(nTrendStrong)
  else if (not bMajorBullish) and (not bMinorBullish) then
    PaintBar(nTrendStrongBear)

  // Tendencia: um MACD discorda (suave)
  else if Trend_Follow_Major and bMajorBullish then
    PaintBar(nTrendSoft)
  else if Trend_Follow_Major and (not bMajorBullish) then
    PaintBar(nTrendSoftBear)
  else if bMinorBullish then
    PaintBar(nTrendSoft)
  else
    PaintBar(nTrendSoftBear);

end;
