// =========================================================================
// CONFLUENCE COLORING - Coloring Rule (Regra de Coloracao)
// =========================================================================
// Colors candle bars based on multiple signal rules. Each rule produces a
// bullish/bearish boolean. The color mapping combines them:
//
// Colors:
//   - STRONG: both MACDs + tape + EMA pullback (bright blue / red)
//   - SCALP:  minor MACD + tape + EMA pullback, major disagrees (dim blue / red)
//
// Current rules:
//   1. Major MACD histogram (longer-term direction)
//   2. Minor MACD histogram (short-term confirmation)
//   3. Tape reading (volume + aggression aligned with candle direction)
//   4. EMA pullback entry (direction change near an EMA, not past it)
//
// To add a new rule:
//   1. Add inputs for the new indicator
//   2. Add variables for the calculation
//   3. Calculate the indicator and set a boolean signal (bXxxBullish)
//   4. Update the color mapping section
//
// IMPORTANT: This is a COLORING RULE, not an indicator!
// To apply: Right-click chart -> "Inserir Regra de Coloracao" -> Select this
// =========================================================================

input
  // ----- Major MACD (longer-term) -----

  // Major MACD fast EMA period. Default: 200
  Major_MACD_Fast(200);

  // Major MACD slow EMA period. Default: 800
  Major_MACD_Slow(800);

  // Major MACD signal line period. Default: 50
  Major_MACD_Signal(50);

  // ----- Minor MACD (short-term) -----

  // Minor MACD fast EMA period. Default: 72
  Minor_MACD_Fast(72);

  // Minor MACD slow EMA period. Default: 200
  Minor_MACD_Slow(200);

  // Minor MACD signal line period. Default: 34
  Minor_MACD_Signal(34);

  // ----- Tape Reading -----

  // Tape aggression balance MA period. Default: 305
  Tape_MA_Balance(305);

  // Tape volume MA period. Default: 305
  Tape_MA_Volume(305);

  // ----- EMA Trend Filter -----

  // Fast EMA period for trend filter. Default: 21
  EMA_Fast(21);

  // Slow EMA period for trend filter. Default: 42
  EMA_Slow(42);

  // ----- Enable/Disable Rules -----

  // Require volume above average for tape
  Tape_Require_Volume(true);

  // Require aggression above average for tape
  Tape_Require_Aggression(true);

  // Require aggression direction aligned with candle for tape
  Tape_Require_Direction(false);

  // Enable EMA pullback entry (core trigger)
  Enable_EMA(true);

  // Require pullback (opposite brick in last 3) before entry
  Enable_Pullback(true);

var
  // Major MACD components
  fMajorMacdLine: Float;
  fMajorSignalLine: Float;
  fMajorHistogram: Float;

  // Minor MACD components
  fMinorMacdLine: Float;
  fMinorSignalLine: Float;
  fMinorHistogram: Float;

  // Tape reading components
  fBalance: Float;
  fAbsBalance: Float;
  fVol: Float;
  fMaBalance: Float;
  fMaVol: Float;

  // EMA alignment components
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaUpper: Float;
  fEmaLower: Float;
  bBrickTouchesEma: Boolean;
  nCrossed: Integer;

  // Signal booleans
  bMajorBullish: Boolean;
  bMinorBullish: Boolean;
  bTapeHighlight: Boolean;
  bTapeBullish: Boolean;
  bEmaBullish: Boolean;
  bEmaBearish: Boolean;

  // Final trigger results
  bStrongBull: Boolean;
  bStrongBear: Boolean;
  bScalpBull: Boolean;
  bScalpBear: Boolean;

begin
  // -----------------------------------------------------------------------
  // Rule 1: Major MACD Histogram
  // -----------------------------------------------------------------------
  fMajorMacdLine := MediaExp(Major_MACD_Fast, Close) - MediaExp(Major_MACD_Slow, Close);
  fMajorSignalLine := MediaExp(Major_MACD_Signal, fMajorMacdLine);
  fMajorHistogram := fMajorMacdLine - fMajorSignalLine;
  bMajorBullish := fMajorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Rule 2: Minor MACD Histogram
  // -----------------------------------------------------------------------
  fMinorMacdLine := MediaExp(Minor_MACD_Fast, Close) - MediaExp(Minor_MACD_Slow, Close);
  fMinorSignalLine := MediaExp(Minor_MACD_Signal, fMinorMacdLine);
  fMinorHistogram := fMinorMacdLine - fMinorSignalLine;
  bMinorBullish := fMinorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Rule 3: Tape Reading (volume + aggression aligned with candle)
  // -----------------------------------------------------------------------
  fBalance := AgressionVolBuy - AgressionVolSell;
  bTapeBullish := fBalance >= 0;
  if bTapeBullish then
    fAbsBalance := fBalance
  else
    fAbsBalance := -fBalance;
  fVol := QuantityVol(False, True);
  fMaBalance := Media(Tape_MA_Balance, fAbsBalance);
  fMaVol := Media(Tape_MA_Volume, fVol);

  // Tape highlight: each condition is independently toggleable
  bTapeHighlight := (not Tape_Require_Volume or (fVol >= fMaVol))
    and (not Tape_Require_Aggression or (fAbsBalance >= fMaBalance))
    and (not Tape_Require_Direction
      or (bTapeBullish and (Close >= Open))
      or ((not bTapeBullish) and (Close < Open)));

  // When direction is not required, follow candle for color mapping
  if not Tape_Require_Direction then
    bTapeBullish := Close >= Open;

  // -----------------------------------------------------------------------
  // Rule 4: EMA Pullback Entry
  // -----------------------------------------------------------------------
  // Detects: trend bricks -> opposite bricks (pullback) -> first trend brick
  // near an EMA. The entry brick must not open and close past the EMAs.
  fEmaFast := MediaExp(EMA_Fast, Close);
  fEmaSlow := MediaExp(EMA_Slow, Close);

  // EMA zone boundaries
  if fEmaFast >= fEmaSlow then begin
    fEmaUpper := fEmaFast;
    fEmaLower := fEmaSlow;
  end else begin
    fEmaUpper := fEmaSlow;
    fEmaLower := fEmaFast;
  end;

  // Brick touches or crosses the EMA zone (overlap between [Low,High] and [EmaLower,EmaUpper])
  bBrickTouchesEma := (Low <= fEmaUpper) and (High >= fEmaLower);

  // Bullish pullback entry:
  //   - Uptrend (fast EMA > slow EMA)
  //   - Current brick is green
  //   - Brick touches or crosses the EMA zone
  //   - [toggleable] Pullback within last 3 bricks
  //   - Close above slow EMA
  //   - At most 1 lookback brick entirely below slow EMA
  nCrossed := 0;
  if (Open[1] < fEmaSlow[1]) and (Close[1] < fEmaSlow[1]) then
    nCrossed := nCrossed + 1;
  if (Open[2] < fEmaSlow[2]) and (Close[2] < fEmaSlow[2]) then
    nCrossed := nCrossed + 1;
  if (Open[3] < fEmaSlow[3]) and (Close[3] < fEmaSlow[3]) then
    nCrossed := nCrossed + 1;

  bEmaBullish := (fEmaFast > fEmaSlow)
    and (Close >= Open)
    and bBrickTouchesEma
    and ((not Enable_Pullback) or (Close[1] < Open[1]) or (Close[2] < Open[2]) or (Close[3] < Open[3]))
    and (Close >= fEmaSlow)
    and (nCrossed <= 1);

  // Bearish pullback entry (mirror):
  //   - Downtrend (fast EMA < slow EMA)
  //   - Current brick is red
  //   - Brick touches or crosses the EMA zone
  //   - [toggleable] Pullback within last 3 bricks
  //   - Close below slow EMA
  //   - At most 1 lookback brick entirely above slow EMA
  nCrossed := 0;
  if (Open[1] > fEmaSlow[1]) and (Close[1] > fEmaSlow[1]) then
    nCrossed := nCrossed + 1;
  if (Open[2] > fEmaSlow[2]) and (Close[2] > fEmaSlow[2]) then
    nCrossed := nCrossed + 1;
  if (Open[3] > fEmaSlow[3]) and (Close[3] > fEmaSlow[3]) then
    nCrossed := nCrossed + 1;

  bEmaBearish := (fEmaFast < fEmaSlow)
    and (Close < Open)
    and bBrickTouchesEma
    and ((not Enable_Pullback) or (Close[1] >= Open[1]) or (Close[2] >= Open[2]) or (Close[3] >= Open[3]))
    and (Close <= fEmaSlow)
    and (nCrossed <= 1);

  // -----------------------------------------------------------------------
  // Final Trigger Computation
  // -----------------------------------------------------------------------
  // Strong: both MACDs aligned. Scalp: only minor aligned.
  bStrongBull := Enable_EMA and bEmaBullish
    and bTapeHighlight and bTapeBullish
    and bMajorBullish and bMinorBullish;
  bStrongBear := Enable_EMA and bEmaBearish
    and bTapeHighlight and (not bTapeBullish)
    and (not bMajorBullish) and (not bMinorBullish);
  bScalpBull := Enable_EMA and bEmaBullish
    and bTapeHighlight and bTapeBullish
    and (not bMajorBullish) and bMinorBullish;
  bScalpBear := Enable_EMA and bEmaBearish
    and bTapeHighlight and (not bTapeBullish)
    and bMajorBullish and (not bMinorBullish);

  // -----------------------------------------------------------------------
  // Color Mapping
  // -----------------------------------------------------------------------
  if bStrongBull then
    PaintBar(RGB(0, 120, 255))
  else if bStrongBear then
    PaintBar(RGB(255, 0, 0))
  else if bScalpBull then
    PaintBar(RGB(0, 80, 160))
  else if bScalpBear then
    PaintBar(RGB(160, 0, 0));

end;
