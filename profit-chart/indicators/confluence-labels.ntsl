// =========================================================================
// CONFLUENCE LABELS - Indicator (companion to Confluence Coloring)
// =========================================================================
// Plots text labels on bricks where the confluence trigger fires.
// Uses the same logic and inputs as the coloring rule.
//
// Bullish trigger: label below the brick
// Bearish trigger: label above the brick
//
// IMPORTANT: Keep inputs in sync with confluence-coloring.ntsl!
// To apply: Right-click chart -> "Inserir Indicador" -> Select this
// =========================================================================

input
  // ----- Major MACD (longer-term) -----

  // Major MACD fast EMA period. Default: 200
  Major_MACD_Fast(200);

  // Major MACD slow EMA period. Default: 800
  Major_MACD_Slow(800);

  // Major MACD signal line period. Default: 50
  Major_MACD_Signal(50);

  // ----- Minor MACD (short-term) -----

  // Minor MACD fast EMA period. Default: 72
  Minor_MACD_Fast(72);

  // Minor MACD slow EMA period. Default: 200
  Minor_MACD_Slow(200);

  // Minor MACD signal line period. Default: 34
  Minor_MACD_Signal(34);

  // ----- Tape Reading -----

  // Tape aggression balance MA period. Default: 305
  Tape_MA_Balance(305);

  // Tape volume MA period. Default: 305
  Tape_MA_Volume(305);

  // ----- EMA Trend Filter -----

  // Fast EMA period for trend filter. Default: 21
  EMA_Fast(21);

  // Slow EMA period for trend filter. Default: 42
  EMA_Slow(42);

  // ----- Enable/Disable Rules (0 = disabled, 1 = enabled) -----

  // Enable major MACD filter. Default: 1
  Enable_Major_MACD(1);

  // Enable minor MACD filter. Default: 1
  Enable_Minor_MACD(1);

  // Enable tape reading filter. Default: 1
  Enable_Tape(1);

  // Loose tape: trigger if volume OR aggression above average (ignores direction). Default: 0
  Tape_Loose(1);

  // Enable EMA pullback entry (core trigger). Default: 1
  Enable_EMA(1);

  // Require pullback (opposite brick in last 3) before entry. Default: 1
  Enable_Pullback(1);

  // Require pullback bricks stay on correct side of slow EMA. Default: 1
  Enable_Not_Crossed(1);

  // ----- Label Settings -----

  // Label font size. Default: 8
  Label_Size(8);

  // Label color: 0 = black, 1 = white. Default: 0
  Label_White(0);

var
  // Major MACD components
  fMajorMacdLine: Float;
  fMajorSignalLine: Float;
  fMajorHistogram: Float;

  // Minor MACD components
  fMinorMacdLine: Float;
  fMinorSignalLine: Float;
  fMinorHistogram: Float;

  // Tape reading components
  fBalance: Float;
  fAbsBalance: Float;
  fVol: Float;
  fMaBalance: Float;
  fMaVol: Float;

  // EMA alignment components
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaUpper: Float;
  fEmaLower: Float;
  bBrickTouchesEma: Boolean;

  // Signal booleans
  bMajorBullish: Boolean;
  bMinorBullish: Boolean;
  bTapeHighlight: Boolean;
  bTapeBullish: Boolean;
  bEmaBullish: Boolean;
  bEmaBearish: Boolean;

  // MACD confluence (enable-aware)
  bMacdBull: Boolean;
  bMacdBear: Boolean;

  // Final trigger results
  bTriggerBull: Boolean;
  bTriggerBear: Boolean;

  // Label color
  nLabelColor: Integer;

begin
  // -----------------------------------------------------------------------
  // Rule 1: Major MACD Histogram
  // -----------------------------------------------------------------------
  fMajorMacdLine := MediaExp(Major_MACD_Fast, Close) - MediaExp(Major_MACD_Slow, Close);
  fMajorSignalLine := MediaExp(Major_MACD_Signal, fMajorMacdLine);
  fMajorHistogram := fMajorMacdLine - fMajorSignalLine;
  bMajorBullish := fMajorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Rule 2: Minor MACD Histogram
  // -----------------------------------------------------------------------
  fMinorMacdLine := MediaExp(Minor_MACD_Fast, Close) - MediaExp(Minor_MACD_Slow, Close);
  fMinorSignalLine := MediaExp(Minor_MACD_Signal, fMinorMacdLine);
  fMinorHistogram := fMinorMacdLine - fMinorSignalLine;
  bMinorBullish := fMinorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Rule 3: Tape Reading (volume + aggression aligned with candle)
  // -----------------------------------------------------------------------
  fBalance := AgressionVolBuy - AgressionVolSell;
  bTapeBullish := fBalance >= 0;
  if bTapeBullish then
    fAbsBalance := fBalance
  else
    fAbsBalance := -fBalance;
  fVol := QuantityVol(False, True);
  fMaBalance := Media(Tape_MA_Balance, fAbsBalance);
  fMaVol := Media(Tape_MA_Volume, fVol);

  if Enable_Tape < 1 then begin
    bTapeHighlight := True;
    bTapeBullish := Close >= Open;
  end else if Tape_Loose >= 1 then begin
    bTapeHighlight := (fVol >= fMaVol) or (fAbsBalance >= fMaBalance);
    bTapeBullish := Close >= Open;
  end else begin
    bTapeHighlight := (fVol >= fMaVol) and (fAbsBalance >= fMaBalance)
      and (  (bTapeBullish and (Close >= Open))
          or ((not bTapeBullish) and (Close < Open)));
  end;

  // -----------------------------------------------------------------------
  // Rule 4: EMA Pullback Entry
  // -----------------------------------------------------------------------
  fEmaFast := MediaExp(EMA_Fast, Close);
  fEmaSlow := MediaExp(EMA_Slow, Close);

  if fEmaFast >= fEmaSlow then begin
    fEmaUpper := fEmaFast;
    fEmaLower := fEmaSlow;
  end else begin
    fEmaUpper := fEmaSlow;
    fEmaLower := fEmaFast;
  end;

  bBrickTouchesEma := (Low <= fEmaUpper) and (High >= fEmaLower);

  bEmaBullish := (fEmaFast > fEmaSlow)
    and (Close >= Open)
    and bBrickTouchesEma
    and ((Enable_Pullback < 1) or (Close[1] < Open[1]) or (Close[2] < Open[2]) or (Close[3] < Open[3]))
    and ((Enable_Not_Crossed < 1) or (Close >= fEmaSlow))
    and ((Enable_Not_Crossed < 1) or (Open[1] >= fEmaSlow[1]) or (Close[1] >= fEmaSlow[1]))
    and ((Enable_Not_Crossed < 1) or (Open[2] >= fEmaSlow[2]) or (Close[2] >= fEmaSlow[2]))
    and ((Enable_Not_Crossed < 1) or (Open[3] >= fEmaSlow[3]) or (Close[3] >= fEmaSlow[3]));

  bEmaBearish := (fEmaFast < fEmaSlow)
    and (Close < Open)
    and bBrickTouchesEma
    and ((Enable_Pullback < 1) or (Close[1] >= Open[1]) or (Close[2] >= Open[2]) or (Close[3] >= Open[3]))
    and ((Enable_Not_Crossed < 1) or (Close <= fEmaSlow))
    and ((Enable_Not_Crossed < 1) or (Open[1] <= fEmaSlow[1]) or (Close[1] <= fEmaSlow[1]))
    and ((Enable_Not_Crossed < 1) or (Open[2] <= fEmaSlow[2]) or (Close[2] <= fEmaSlow[2]))
    and ((Enable_Not_Crossed < 1) or (Open[3] <= fEmaSlow[3]) or (Close[3] <= fEmaSlow[3]));

  // -----------------------------------------------------------------------
  // MACD Confluence (enable-aware)
  // -----------------------------------------------------------------------
  bMacdBull := ((Enable_Major_MACD < 1) or bMajorBullish)
    and ((Enable_Minor_MACD < 1) or bMinorBullish);
  bMacdBear := ((Enable_Major_MACD < 1) or (not bMajorBullish))
    and ((Enable_Minor_MACD < 1) or (not bMinorBullish));

  // -----------------------------------------------------------------------
  // Final Trigger Computation
  // -----------------------------------------------------------------------
  bTriggerBull := (Enable_EMA >= 1) and bEmaBullish
    and bTapeHighlight and bTapeBullish and bMacdBull;
  bTriggerBear := (Enable_EMA >= 1) and bEmaBearish
    and bTapeHighlight and (not bTapeBullish) and bMacdBear;

  // -----------------------------------------------------------------------
  // Labels
  // -----------------------------------------------------------------------
  if Label_White >= 1 then
    nLabelColor := clWhite
  else
    nLabelColor := clBlack;

  if bTriggerBull then
    PlotText("BUY", nLabelColor, 0, Label_Size)
  else if bTriggerBear then
    PlotText("SELL", nLabelColor, 2, Label_Size);

end;
