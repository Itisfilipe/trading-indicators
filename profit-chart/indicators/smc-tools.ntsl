// =========================================================================
// SMC TOOLS - Sessoes/Killzones, Linhas de Abertura e Niveis de Liquidez
// =========================================================================
// Ferramentas para Smart Money Concepts:
//
//   1. Killzones / Sessoes desenhadas como caixas (borda superior + inferior):
//        - Asia / London / NY AM / NY Lunch / NY PM
//      Cada sessao com cor propria e horarios configuraveis.
//      Mantem ate Max_Past_Sessions caixas passadas por tipo (ring buffer)
//      redesenhadas em LastBarOnChart para evitar duplicacao em ticks.
//      Extensao high/low (R/S) projetada para a direita a partir da sessao
//      mais recente (slot 1) - pontos de liquidez.
//
//   2. Linhas HORIZONTAIS de abertura (preco Open na hora alvo):
//        - Midnight Open / Weekly Open / 8:30 Open / 9:30 Open
//
//   3. Modo de horario:
//      - Times_In_NY = true (default): inputs em NY clock; o indicador soma
//        NY_To_BR_Offset minutos pra converter pra BR (a plataforma usa BR).
//        Default = 60 (DST abr-out). Mude para 120 no EST (nov-mar).
//      - Times_In_NY = false: inputs em hora do Brasil direto.
//
// Observacoes:
//   - Pensado para graficos baseados em tempo (1m, 5m, 15m).
//   - Horas no formato HHMM (Integer): 9:30 -> 930, midnight -> 0.
//   - NTSL zera series nao atribuidas a cada barra; carry-forward explicito
//     (var := var[1]) propaga estado entre barras.
// =========================================================================

input
  Tema_Escuro(false);

  // ----- Modo de horario -----
  Times_In_NY(true);             // true = horarios em NY (com offset); false = BR direto
  NY_To_BR_Offset(60);           // minutos (60 = NY DST abr-out, 120 = NY EST nov-mar)

  // ----- Sessoes / Killzones (defaults em NY time) -----
  Enable_Asia(true);
  Asia_Start(2000);              // 20:00 NY
  Asia_End(0);                   // 00:00 NY - cruza meia-noite

  Enable_London(true);
  London_Start(200);             // 02:00 NY
  London_End(500);               // 05:00 NY

  Enable_NY_AM(true);
  NY_AM_Start(800);              // 08:00 NY
  NY_AM_End(1100);               // 11:00 NY

  Enable_NY_Lunch(true);
  NY_Lunch_Start(1200);          // 12:00 NY
  NY_Lunch_End(1300);            // 13:00 NY

  Enable_NY_PM(true);
  NY_PM_Start(1330);             // 13:30 NY
  NY_PM_End(1600);               // 16:00 NY

  Show_Session_Levels(true);     // estende high/low (R/S) da sessao mais recente
  Session_Border_Width(1);

  // ----- Linhas HORIZONTAIS de abertura (defaults em NY time) -----
  Midnight_Enable(true);
  Midnight_Time(0);              // 00:00 NY
  Midnight_Label("MO");

  Weekly_Enable(true);
  Weekly_Label("WO");

  Open830_Enable(true);
  Open830_Time(830);             // 08:30 NY
  Open830_Label("8:30");

  Open930_Enable(true);
  Open930_Time(930);             // 09:30 NY
  Open930_Label("9:30");

  Line_Style(2);                 // 0=solido, 1=traco longo, 2=traco curto
  Line_Width(1);
  Line_End_Time(1800);           // Fim das linhas intraday (18:00 NY)
  Max_Past_Sessions(5);          // Slots historicos por tipo (max 5 implementado)

var
  // Efetivos em BR (apos conversao Times_In_NY)
  nAsiaStartEff,    nAsiaEndEff    : Integer;
  nLondonStartEff,  nLondonEndEff  : Integer;
  nNyAmStartEff,    nNyAmEndEff    : Integer;
  nNyLunchStartEff, nNyLunchEndEff : Integer;
  nNyPmStartEff,    nNyPmEndEff    : Integer;
  nMidnightEff, nOpen830Eff, nOpen930Eff   : Integer;
  nLineEndEff                              : Integer;

  // Sessao em andamento (running)
  bInAsia, bInLondon, bInNyAm, bInNyLunch, bInNyPm : Boolean;
  fAsiaHigh, fAsiaLow         : Float;
  fLondonHigh, fLondonLow     : Float;
  fNyAmHigh, fNyAmLow         : Float;
  fNyLunchHigh, fNyLunchLow   : Float;
  fNyPmHigh, fNyPmLow         : Float;
  nAsiaStartDate, nLondonStartDate, nNyAmStartDate,
  nNyLunchStartDate, nNyPmStartDate : Integer;

  // Ring buffer (slot 1 = mais recente, slot 5 = mais antiga)
  fAsia1H, fAsia2H, fAsia3H, fAsia4H, fAsia5H : Float;
  fAsia1L, fAsia2L, fAsia3L, fAsia4L, fAsia5L : Float;
  nAsia1S, nAsia2S, nAsia3S, nAsia4S, nAsia5S : Integer;
  nAsia1E, nAsia2E, nAsia3E, nAsia4E, nAsia5E : Integer;

  fLon1H, fLon2H, fLon3H, fLon4H, fLon5H : Float;
  fLon1L, fLon2L, fLon3L, fLon4L, fLon5L : Float;
  nLon1S, nLon2S, nLon3S, nLon4S, nLon5S : Integer;
  nLon1E, nLon2E, nLon3E, nLon4E, nLon5E : Integer;

  fAm1H, fAm2H, fAm3H, fAm4H, fAm5H : Float;
  fAm1L, fAm2L, fAm3L, fAm4L, fAm5L : Float;
  nAm1S, nAm2S, nAm3S, nAm4S, nAm5S : Integer;
  nAm1E, nAm2E, nAm3E, nAm4E, nAm5E : Integer;

  fLu1H, fLu2H, fLu3H, fLu4H, fLu5H : Float;
  fLu1L, fLu2L, fLu3L, fLu4L, fLu5L : Float;
  nLu1S, nLu2S, nLu3S, nLu4S, nLu5S : Integer;
  nLu1E, nLu2E, nLu3E, nLu4E, nLu5E : Integer;

  fPm1H, fPm2H, fPm3H, fPm4H, fPm5H : Float;
  fPm1L, fPm2L, fPm3L, fPm4L, fPm5L : Float;
  nPm1S, nPm2S, nPm3S, nPm4S, nPm5S : Integer;
  nPm1E, nPm2E, nPm3E, nPm4E, nPm5E : Integer;

  // Cores
  nAsiaColor, nLondonColor, nNyAmColor, nNyLunchColor, nNyPmColor : Integer;
  nHorizColor                                                     : Integer;

  // Auxiliares
  nT : Integer;
  nWeekStartDate : Integer;
  fWeeklyOpenPrice : Float;

begin
  // =================== CORES ===================
  if Tema_Escuro then
    begin
      nAsiaColor     := RGB(220, 200,  40);
      nLondonColor   := RGB( 80, 130, 255);
      nNyAmColor     := RGB(255,  80,  80);
      nNyLunchColor  := RGB(150, 200, 255);
      nNyPmColor     := RGB(200, 130, 255);
      nHorizColor    := RGB(230, 230, 230);
    end
  else
    begin
      nAsiaColor     := RGB(220, 180,  20);
      nLondonColor   := RGB( 60, 100, 220);
      nNyAmColor     := RGB(220,  60,  60);
      nNyLunchColor  := RGB(110, 170, 230);
      nNyPmColor     := RGB(160,  80, 200);
      nHorizColor    := RGB(0, 0, 0);
    end;

  // =================== TIMES EFETIVOS ===================
  if Times_In_NY then
    begin
      nAsiaStartEff    := CalcTime(Asia_Start,    NY_To_BR_Offset);
      nAsiaEndEff      := CalcTime(Asia_End,      NY_To_BR_Offset);
      nLondonStartEff  := CalcTime(London_Start,  NY_To_BR_Offset);
      nLondonEndEff    := CalcTime(London_End,    NY_To_BR_Offset);
      nNyAmStartEff    := CalcTime(NY_AM_Start,   NY_To_BR_Offset);
      nNyAmEndEff      := CalcTime(NY_AM_End,     NY_To_BR_Offset);
      nNyLunchStartEff := CalcTime(NY_Lunch_Start, NY_To_BR_Offset);
      nNyLunchEndEff   := CalcTime(NY_Lunch_End,   NY_To_BR_Offset);
      nNyPmStartEff    := CalcTime(NY_PM_Start,   NY_To_BR_Offset);
      nNyPmEndEff      := CalcTime(NY_PM_End,     NY_To_BR_Offset);
      nMidnightEff     := CalcTime(Midnight_Time, NY_To_BR_Offset);
      nOpen830Eff      := CalcTime(Open830_Time,  NY_To_BR_Offset);
      nOpen930Eff      := CalcTime(Open930_Time,  NY_To_BR_Offset);
      nLineEndEff      := CalcTime(Line_End_Time, NY_To_BR_Offset);
    end
  else
    begin
      nAsiaStartEff    := Asia_Start;
      nAsiaEndEff      := Asia_End;
      nLondonStartEff  := London_Start;
      nLondonEndEff    := London_End;
      nNyAmStartEff    := NY_AM_Start;
      nNyAmEndEff      := NY_AM_End;
      nNyLunchStartEff := NY_Lunch_Start;
      nNyLunchEndEff   := NY_Lunch_End;
      nNyPmStartEff    := NY_PM_Start;
      nNyPmEndEff      := NY_PM_End;
      nMidnightEff     := Midnight_Time;
      nOpen830Eff      := Open830_Time;
      nOpen930Eff      := Open930_Time;
      nLineEndEff      := Line_End_Time;
    end;

  nT := Time;

  // =================== ASIA ===================
  // Carry-forward de TUDO (running + slots)
  fAsiaHigh := fAsiaHigh[1]; fAsiaLow := fAsiaLow[1];
  nAsiaStartDate := nAsiaStartDate[1];
  fAsia1H := fAsia1H[1]; fAsia2H := fAsia2H[1]; fAsia3H := fAsia3H[1]; fAsia4H := fAsia4H[1]; fAsia5H := fAsia5H[1];
  fAsia1L := fAsia1L[1]; fAsia2L := fAsia2L[1]; fAsia3L := fAsia3L[1]; fAsia4L := fAsia4L[1]; fAsia5L := fAsia5L[1];
  nAsia1S := nAsia1S[1]; nAsia2S := nAsia2S[1]; nAsia3S := nAsia3S[1]; nAsia4S := nAsia4S[1]; nAsia5S := nAsia5S[1];
  nAsia1E := nAsia1E[1]; nAsia2E := nAsia2E[1]; nAsia3E := nAsia3E[1]; nAsia4E := nAsia4E[1]; nAsia5E := nAsia5E[1];

  if Enable_Asia then
    begin
      if nAsiaStartEff > nAsiaEndEff then
        bInAsia := (nT >= nAsiaStartEff) or (nT < nAsiaEndEff)
      else
        bInAsia := (nT >= nAsiaStartEff) and (nT < nAsiaEndEff);

      if bInAsia and not bInAsia[1] then
        begin
          fAsiaHigh := High;
          fAsiaLow  := Low;
          if (nAsiaStartEff > nAsiaEndEff) and (nT < nAsiaEndEff) then
            nAsiaStartDate := CalcDate(Date, -1)
          else
            nAsiaStartDate := Date;
        end
      else if bInAsia then
        begin
          if High > fAsiaHigh then fAsiaHigh := High;
          if Low  < fAsiaLow  then fAsiaLow  := Low;
        end
      else if bInAsia[1] then
        begin
          // Shift ring buffer
          fAsia5H := fAsia4H; fAsia5L := fAsia4L; nAsia5S := nAsia4S; nAsia5E := nAsia4E;
          fAsia4H := fAsia3H; fAsia4L := fAsia3L; nAsia4S := nAsia3S; nAsia4E := nAsia3E;
          fAsia3H := fAsia2H; fAsia3L := fAsia2L; nAsia3S := nAsia2S; nAsia3E := nAsia2E;
          fAsia2H := fAsia1H; fAsia2L := fAsia1L; nAsia2S := nAsia1S; nAsia2E := nAsia1E;
          fAsia1H := fAsiaHigh; fAsia1L := fAsiaLow; nAsia1S := nAsiaStartDate;
          if nAsiaStartEff > nAsiaEndEff then
            nAsia1E := CalcDate(nAsiaStartDate, 1)
          else
            nAsia1E := nAsiaStartDate;
        end;

      // Running box: bordas superior + inferior (sem preenchimento -> sem linha central)
      if bInAsia then
        begin
          HorizontalLineCustom(fAsiaHigh, nAsiaColor, Session_Border_Width, 0,
            "Asia", 8, tpTopLeft, nAsiaStartDate, Date, 0, nAsiaStartEff, nT);
          HorizontalLineCustom(fAsiaLow, nAsiaColor, Session_Border_Width, 0,
            "", 8, tpTopLeft, nAsiaStartDate, Date, 0, nAsiaStartEff, nT);
        end;

      // Slots passados redesenhados so na ultima barra (evita acumulo)
      if LastBarOnChart then
        begin
          if (nAsia1E > 0) and (Max_Past_Sessions >= 1) then
            begin
              HorizontalLineCustom(fAsia1H, nAsiaColor, Session_Border_Width, 0, "Asia", 8, tpTopLeft, nAsia1S, nAsia1E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia1L, nAsiaColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAsia1S, nAsia1E, 0, nAsiaStartEff, nAsiaEndEff);
            end;
          if (nAsia2E > 0) and (Max_Past_Sessions >= 2) then
            begin
              HorizontalLineCustom(fAsia2H, nAsiaColor, Session_Border_Width, 0, "Asia", 8, tpTopLeft, nAsia2S, nAsia2E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia2L, nAsiaColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAsia2S, nAsia2E, 0, nAsiaStartEff, nAsiaEndEff);
            end;
          if (nAsia3E > 0) and (Max_Past_Sessions >= 3) then
            begin
              HorizontalLineCustom(fAsia3H, nAsiaColor, Session_Border_Width, 0, "Asia", 8, tpTopLeft, nAsia3S, nAsia3E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia3L, nAsiaColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAsia3S, nAsia3E, 0, nAsiaStartEff, nAsiaEndEff);
            end;
          if (nAsia4E > 0) and (Max_Past_Sessions >= 4) then
            begin
              HorizontalLineCustom(fAsia4H, nAsiaColor, Session_Border_Width, 0, "Asia", 8, tpTopLeft, nAsia4S, nAsia4E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia4L, nAsiaColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAsia4S, nAsia4E, 0, nAsiaStartEff, nAsiaEndEff);
            end;
          if (nAsia5E > 0) and (Max_Past_Sessions >= 5) then
            begin
              HorizontalLineCustom(fAsia5H, nAsiaColor, Session_Border_Width, 0, "Asia", 8, tpTopLeft, nAsia5S, nAsia5E, 0, nAsiaStartEff, nAsiaEndEff);
              HorizontalLineCustom(fAsia5L, nAsiaColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAsia5S, nAsia5E, 0, nAsiaStartEff, nAsiaEndEff);
            end;

          // S/R extensao da sessao mais recente (slot 1)
          if Show_Session_Levels and (nAsia1E > 0) then
            begin
              HorizontalLineCustom(fAsia1H, nAsiaColor, 1, 2, "Asia R", 8, tpTopRight,
                nAsia1E, 0, 0, nAsiaEndEff, nLineEndEff);
              HorizontalLineCustom(fAsia1L, nAsiaColor, 1, 2, "Asia S", 8, tpBottomRight,
                nAsia1E, 0, 0, nAsiaEndEff, nLineEndEff);
            end;
        end;
    end;

  // =================== LONDON ===================
  fLondonHigh := fLondonHigh[1]; fLondonLow := fLondonLow[1];
  nLondonStartDate := nLondonStartDate[1];
  fLon1H := fLon1H[1]; fLon2H := fLon2H[1]; fLon3H := fLon3H[1]; fLon4H := fLon4H[1]; fLon5H := fLon5H[1];
  fLon1L := fLon1L[1]; fLon2L := fLon2L[1]; fLon3L := fLon3L[1]; fLon4L := fLon4L[1]; fLon5L := fLon5L[1];
  nLon1S := nLon1S[1]; nLon2S := nLon2S[1]; nLon3S := nLon3S[1]; nLon4S := nLon4S[1]; nLon5S := nLon5S[1];
  nLon1E := nLon1E[1]; nLon2E := nLon2E[1]; nLon3E := nLon3E[1]; nLon4E := nLon4E[1]; nLon5E := nLon5E[1];

  if Enable_London then
    begin
      if nLondonStartEff > nLondonEndEff then
        bInLondon := (nT >= nLondonStartEff) or (nT < nLondonEndEff)
      else
        bInLondon := (nT >= nLondonStartEff) and (nT < nLondonEndEff);

      if bInLondon and not bInLondon[1] then
        begin
          fLondonHigh := High; fLondonLow := Low;
          if (nLondonStartEff > nLondonEndEff) and (nT < nLondonEndEff) then
            nLondonStartDate := CalcDate(Date, -1)
          else
            nLondonStartDate := Date;
        end
      else if bInLondon then
        begin
          if High > fLondonHigh then fLondonHigh := High;
          if Low  < fLondonLow  then fLondonLow  := Low;
        end
      else if bInLondon[1] then
        begin
          fLon5H := fLon4H; fLon5L := fLon4L; nLon5S := nLon4S; nLon5E := nLon4E;
          fLon4H := fLon3H; fLon4L := fLon3L; nLon4S := nLon3S; nLon4E := nLon3E;
          fLon3H := fLon2H; fLon3L := fLon2L; nLon3S := nLon2S; nLon3E := nLon2E;
          fLon2H := fLon1H; fLon2L := fLon1L; nLon2S := nLon1S; nLon2E := nLon1E;
          fLon1H := fLondonHigh; fLon1L := fLondonLow; nLon1S := nLondonStartDate;
          if nLondonStartEff > nLondonEndEff then
            nLon1E := CalcDate(nLondonStartDate, 1)
          else
            nLon1E := nLondonStartDate;
        end;

      if bInLondon then
        begin
          HorizontalLineCustom(fLondonHigh, nLondonColor, Session_Border_Width, 0,
            "Lon", 8, tpTopLeft, nLondonStartDate, Date, 0, nLondonStartEff, nT);
          HorizontalLineCustom(fLondonLow, nLondonColor, Session_Border_Width, 0,
            "", 8, tpTopLeft, nLondonStartDate, Date, 0, nLondonStartEff, nT);
        end;

      if LastBarOnChart then
        begin
          if (nLon1E > 0) and (Max_Past_Sessions >= 1) then
            begin
              HorizontalLineCustom(fLon1H, nLondonColor, Session_Border_Width, 0, "Lon", 8, tpTopLeft, nLon1S, nLon1E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon1L, nLondonColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLon1S, nLon1E, 0, nLondonStartEff, nLondonEndEff);
            end;
          if (nLon2E > 0) and (Max_Past_Sessions >= 2) then
            begin
              HorizontalLineCustom(fLon2H, nLondonColor, Session_Border_Width, 0, "Lon", 8, tpTopLeft, nLon2S, nLon2E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon2L, nLondonColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLon2S, nLon2E, 0, nLondonStartEff, nLondonEndEff);
            end;
          if (nLon3E > 0) and (Max_Past_Sessions >= 3) then
            begin
              HorizontalLineCustom(fLon3H, nLondonColor, Session_Border_Width, 0, "Lon", 8, tpTopLeft, nLon3S, nLon3E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon3L, nLondonColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLon3S, nLon3E, 0, nLondonStartEff, nLondonEndEff);
            end;
          if (nLon4E > 0) and (Max_Past_Sessions >= 4) then
            begin
              HorizontalLineCustom(fLon4H, nLondonColor, Session_Border_Width, 0, "Lon", 8, tpTopLeft, nLon4S, nLon4E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon4L, nLondonColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLon4S, nLon4E, 0, nLondonStartEff, nLondonEndEff);
            end;
          if (nLon5E > 0) and (Max_Past_Sessions >= 5) then
            begin
              HorizontalLineCustom(fLon5H, nLondonColor, Session_Border_Width, 0, "Lon", 8, tpTopLeft, nLon5S, nLon5E, 0, nLondonStartEff, nLondonEndEff);
              HorizontalLineCustom(fLon5L, nLondonColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLon5S, nLon5E, 0, nLondonStartEff, nLondonEndEff);
            end;

          if Show_Session_Levels and (nLon1E > 0) then
            begin
              HorizontalLineCustom(fLon1H, nLondonColor, 1, 2, "Lon R", 8, tpTopRight,
                nLon1E, 0, 0, nLondonEndEff, nLineEndEff);
              HorizontalLineCustom(fLon1L, nLondonColor, 1, 2, "Lon S", 8, tpBottomRight,
                nLon1E, 0, 0, nLondonEndEff, nLineEndEff);
            end;
        end;
    end;

  // =================== NY AM ===================
  fNyAmHigh := fNyAmHigh[1]; fNyAmLow := fNyAmLow[1];
  nNyAmStartDate := nNyAmStartDate[1];
  fAm1H := fAm1H[1]; fAm2H := fAm2H[1]; fAm3H := fAm3H[1]; fAm4H := fAm4H[1]; fAm5H := fAm5H[1];
  fAm1L := fAm1L[1]; fAm2L := fAm2L[1]; fAm3L := fAm3L[1]; fAm4L := fAm4L[1]; fAm5L := fAm5L[1];
  nAm1S := nAm1S[1]; nAm2S := nAm2S[1]; nAm3S := nAm3S[1]; nAm4S := nAm4S[1]; nAm5S := nAm5S[1];
  nAm1E := nAm1E[1]; nAm2E := nAm2E[1]; nAm3E := nAm3E[1]; nAm4E := nAm4E[1]; nAm5E := nAm5E[1];

  if Enable_NY_AM then
    begin
      if nNyAmStartEff > nNyAmEndEff then
        bInNyAm := (nT >= nNyAmStartEff) or (nT < nNyAmEndEff)
      else
        bInNyAm := (nT >= nNyAmStartEff) and (nT < nNyAmEndEff);

      if bInNyAm and not bInNyAm[1] then
        begin
          fNyAmHigh := High; fNyAmLow := Low;
          if (nNyAmStartEff > nNyAmEndEff) and (nT < nNyAmEndEff) then
            nNyAmStartDate := CalcDate(Date, -1)
          else
            nNyAmStartDate := Date;
        end
      else if bInNyAm then
        begin
          if High > fNyAmHigh then fNyAmHigh := High;
          if Low  < fNyAmLow  then fNyAmLow  := Low;
        end
      else if bInNyAm[1] then
        begin
          fAm5H := fAm4H; fAm5L := fAm4L; nAm5S := nAm4S; nAm5E := nAm4E;
          fAm4H := fAm3H; fAm4L := fAm3L; nAm4S := nAm3S; nAm4E := nAm3E;
          fAm3H := fAm2H; fAm3L := fAm2L; nAm3S := nAm2S; nAm3E := nAm2E;
          fAm2H := fAm1H; fAm2L := fAm1L; nAm2S := nAm1S; nAm2E := nAm1E;
          fAm1H := fNyAmHigh; fAm1L := fNyAmLow; nAm1S := nNyAmStartDate;
          if nNyAmStartEff > nNyAmEndEff then
            nAm1E := CalcDate(nNyAmStartDate, 1)
          else
            nAm1E := nNyAmStartDate;
        end;

      if bInNyAm then
        begin
          HorizontalLineCustom(fNyAmHigh, nNyAmColor, Session_Border_Width, 0,
            "AM", 8, tpTopLeft, nNyAmStartDate, Date, 0, nNyAmStartEff, nT);
          HorizontalLineCustom(fNyAmLow, nNyAmColor, Session_Border_Width, 0,
            "", 8, tpTopLeft, nNyAmStartDate, Date, 0, nNyAmStartEff, nT);
        end;

      if LastBarOnChart then
        begin
          if (nAm1E > 0) and (Max_Past_Sessions >= 1) then
            begin
              HorizontalLineCustom(fAm1H, nNyAmColor, Session_Border_Width, 0, "AM", 8, tpTopLeft, nAm1S, nAm1E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm1L, nNyAmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAm1S, nAm1E, 0, nNyAmStartEff, nNyAmEndEff);
            end;
          if (nAm2E > 0) and (Max_Past_Sessions >= 2) then
            begin
              HorizontalLineCustom(fAm2H, nNyAmColor, Session_Border_Width, 0, "AM", 8, tpTopLeft, nAm2S, nAm2E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm2L, nNyAmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAm2S, nAm2E, 0, nNyAmStartEff, nNyAmEndEff);
            end;
          if (nAm3E > 0) and (Max_Past_Sessions >= 3) then
            begin
              HorizontalLineCustom(fAm3H, nNyAmColor, Session_Border_Width, 0, "AM", 8, tpTopLeft, nAm3S, nAm3E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm3L, nNyAmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAm3S, nAm3E, 0, nNyAmStartEff, nNyAmEndEff);
            end;
          if (nAm4E > 0) and (Max_Past_Sessions >= 4) then
            begin
              HorizontalLineCustom(fAm4H, nNyAmColor, Session_Border_Width, 0, "AM", 8, tpTopLeft, nAm4S, nAm4E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm4L, nNyAmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAm4S, nAm4E, 0, nNyAmStartEff, nNyAmEndEff);
            end;
          if (nAm5E > 0) and (Max_Past_Sessions >= 5) then
            begin
              HorizontalLineCustom(fAm5H, nNyAmColor, Session_Border_Width, 0, "AM", 8, tpTopLeft, nAm5S, nAm5E, 0, nNyAmStartEff, nNyAmEndEff);
              HorizontalLineCustom(fAm5L, nNyAmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nAm5S, nAm5E, 0, nNyAmStartEff, nNyAmEndEff);
            end;

          if Show_Session_Levels and (nAm1E > 0) then
            begin
              HorizontalLineCustom(fAm1H, nNyAmColor, 1, 2, "AM R", 8, tpTopRight,
                nAm1E, 0, 0, nNyAmEndEff, nLineEndEff);
              HorizontalLineCustom(fAm1L, nNyAmColor, 1, 2, "AM S", 8, tpBottomRight,
                nAm1E, 0, 0, nNyAmEndEff, nLineEndEff);
            end;
        end;
    end;

  // =================== NY LUNCH ===================
  fNyLunchHigh := fNyLunchHigh[1]; fNyLunchLow := fNyLunchLow[1];
  nNyLunchStartDate := nNyLunchStartDate[1];
  fLu1H := fLu1H[1]; fLu2H := fLu2H[1]; fLu3H := fLu3H[1]; fLu4H := fLu4H[1]; fLu5H := fLu5H[1];
  fLu1L := fLu1L[1]; fLu2L := fLu2L[1]; fLu3L := fLu3L[1]; fLu4L := fLu4L[1]; fLu5L := fLu5L[1];
  nLu1S := nLu1S[1]; nLu2S := nLu2S[1]; nLu3S := nLu3S[1]; nLu4S := nLu4S[1]; nLu5S := nLu5S[1];
  nLu1E := nLu1E[1]; nLu2E := nLu2E[1]; nLu3E := nLu3E[1]; nLu4E := nLu4E[1]; nLu5E := nLu5E[1];

  if Enable_NY_Lunch then
    begin
      if nNyLunchStartEff > nNyLunchEndEff then
        bInNyLunch := (nT >= nNyLunchStartEff) or (nT < nNyLunchEndEff)
      else
        bInNyLunch := (nT >= nNyLunchStartEff) and (nT < nNyLunchEndEff);

      if bInNyLunch and not bInNyLunch[1] then
        begin
          fNyLunchHigh := High; fNyLunchLow := Low;
          if (nNyLunchStartEff > nNyLunchEndEff) and (nT < nNyLunchEndEff) then
            nNyLunchStartDate := CalcDate(Date, -1)
          else
            nNyLunchStartDate := Date;
        end
      else if bInNyLunch then
        begin
          if High > fNyLunchHigh then fNyLunchHigh := High;
          if Low  < fNyLunchLow  then fNyLunchLow  := Low;
        end
      else if bInNyLunch[1] then
        begin
          fLu5H := fLu4H; fLu5L := fLu4L; nLu5S := nLu4S; nLu5E := nLu4E;
          fLu4H := fLu3H; fLu4L := fLu3L; nLu4S := nLu3S; nLu4E := nLu3E;
          fLu3H := fLu2H; fLu3L := fLu2L; nLu3S := nLu2S; nLu3E := nLu2E;
          fLu2H := fLu1H; fLu2L := fLu1L; nLu2S := nLu1S; nLu2E := nLu1E;
          fLu1H := fNyLunchHigh; fLu1L := fNyLunchLow; nLu1S := nNyLunchStartDate;
          if nNyLunchStartEff > nNyLunchEndEff then
            nLu1E := CalcDate(nNyLunchStartDate, 1)
          else
            nLu1E := nNyLunchStartDate;
        end;

      if bInNyLunch then
        begin
          HorizontalLineCustom(fNyLunchHigh, nNyLunchColor, Session_Border_Width, 0,
            "Lunch", 8, tpTopLeft, nNyLunchStartDate, Date, 0, nNyLunchStartEff, nT);
          HorizontalLineCustom(fNyLunchLow, nNyLunchColor, Session_Border_Width, 0,
            "", 8, tpTopLeft, nNyLunchStartDate, Date, 0, nNyLunchStartEff, nT);
        end;

      if LastBarOnChart then
        begin
          if (nLu1E > 0) and (Max_Past_Sessions >= 1) then
            begin
              HorizontalLineCustom(fLu1H, nNyLunchColor, Session_Border_Width, 0, "Lunch", 8, tpTopLeft, nLu1S, nLu1E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu1L, nNyLunchColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLu1S, nLu1E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;
          if (nLu2E > 0) and (Max_Past_Sessions >= 2) then
            begin
              HorizontalLineCustom(fLu2H, nNyLunchColor, Session_Border_Width, 0, "Lunch", 8, tpTopLeft, nLu2S, nLu2E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu2L, nNyLunchColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLu2S, nLu2E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;
          if (nLu3E > 0) and (Max_Past_Sessions >= 3) then
            begin
              HorizontalLineCustom(fLu3H, nNyLunchColor, Session_Border_Width, 0, "Lunch", 8, tpTopLeft, nLu3S, nLu3E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu3L, nNyLunchColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLu3S, nLu3E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;
          if (nLu4E > 0) and (Max_Past_Sessions >= 4) then
            begin
              HorizontalLineCustom(fLu4H, nNyLunchColor, Session_Border_Width, 0, "Lunch", 8, tpTopLeft, nLu4S, nLu4E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu4L, nNyLunchColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLu4S, nLu4E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;
          if (nLu5E > 0) and (Max_Past_Sessions >= 5) then
            begin
              HorizontalLineCustom(fLu5H, nNyLunchColor, Session_Border_Width, 0, "Lunch", 8, tpTopLeft, nLu5S, nLu5E, 0, nNyLunchStartEff, nNyLunchEndEff);
              HorizontalLineCustom(fLu5L, nNyLunchColor, Session_Border_Width, 0, "", 8, tpTopLeft, nLu5S, nLu5E, 0, nNyLunchStartEff, nNyLunchEndEff);
            end;

          if Show_Session_Levels and (nLu1E > 0) then
            begin
              HorizontalLineCustom(fLu1H, nNyLunchColor, 1, 2, "Lunch R", 8, tpTopRight,
                nLu1E, 0, 0, nNyLunchEndEff, nLineEndEff);
              HorizontalLineCustom(fLu1L, nNyLunchColor, 1, 2, "Lunch S", 8, tpBottomRight,
                nLu1E, 0, 0, nNyLunchEndEff, nLineEndEff);
            end;
        end;
    end;

  // =================== NY PM ===================
  fNyPmHigh := fNyPmHigh[1]; fNyPmLow := fNyPmLow[1];
  nNyPmStartDate := nNyPmStartDate[1];
  fPm1H := fPm1H[1]; fPm2H := fPm2H[1]; fPm3H := fPm3H[1]; fPm4H := fPm4H[1]; fPm5H := fPm5H[1];
  fPm1L := fPm1L[1]; fPm2L := fPm2L[1]; fPm3L := fPm3L[1]; fPm4L := fPm4L[1]; fPm5L := fPm5L[1];
  nPm1S := nPm1S[1]; nPm2S := nPm2S[1]; nPm3S := nPm3S[1]; nPm4S := nPm4S[1]; nPm5S := nPm5S[1];
  nPm1E := nPm1E[1]; nPm2E := nPm2E[1]; nPm3E := nPm3E[1]; nPm4E := nPm4E[1]; nPm5E := nPm5E[1];

  if Enable_NY_PM then
    begin
      if nNyPmStartEff > nNyPmEndEff then
        bInNyPm := (nT >= nNyPmStartEff) or (nT < nNyPmEndEff)
      else
        bInNyPm := (nT >= nNyPmStartEff) and (nT < nNyPmEndEff);

      if bInNyPm and not bInNyPm[1] then
        begin
          fNyPmHigh := High; fNyPmLow := Low;
          if (nNyPmStartEff > nNyPmEndEff) and (nT < nNyPmEndEff) then
            nNyPmStartDate := CalcDate(Date, -1)
          else
            nNyPmStartDate := Date;
        end
      else if bInNyPm then
        begin
          if High > fNyPmHigh then fNyPmHigh := High;
          if Low  < fNyPmLow  then fNyPmLow  := Low;
        end
      else if bInNyPm[1] then
        begin
          fPm5H := fPm4H; fPm5L := fPm4L; nPm5S := nPm4S; nPm5E := nPm4E;
          fPm4H := fPm3H; fPm4L := fPm3L; nPm4S := nPm3S; nPm4E := nPm3E;
          fPm3H := fPm2H; fPm3L := fPm2L; nPm3S := nPm2S; nPm3E := nPm2E;
          fPm2H := fPm1H; fPm2L := fPm1L; nPm2S := nPm1S; nPm2E := nPm1E;
          fPm1H := fNyPmHigh; fPm1L := fNyPmLow; nPm1S := nNyPmStartDate;
          if nNyPmStartEff > nNyPmEndEff then
            nPm1E := CalcDate(nNyPmStartDate, 1)
          else
            nPm1E := nNyPmStartDate;
        end;

      if bInNyPm then
        begin
          HorizontalLineCustom(fNyPmHigh, nNyPmColor, Session_Border_Width, 0,
            "PM", 8, tpTopLeft, nNyPmStartDate, Date, 0, nNyPmStartEff, nT);
          HorizontalLineCustom(fNyPmLow, nNyPmColor, Session_Border_Width, 0,
            "", 8, tpTopLeft, nNyPmStartDate, Date, 0, nNyPmStartEff, nT);
        end;

      if LastBarOnChart then
        begin
          if (nPm1E > 0) and (Max_Past_Sessions >= 1) then
            begin
              HorizontalLineCustom(fPm1H, nNyPmColor, Session_Border_Width, 0, "PM", 8, tpTopLeft, nPm1S, nPm1E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm1L, nNyPmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nPm1S, nPm1E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm2E > 0) and (Max_Past_Sessions >= 2) then
            begin
              HorizontalLineCustom(fPm2H, nNyPmColor, Session_Border_Width, 0, "PM", 8, tpTopLeft, nPm2S, nPm2E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm2L, nNyPmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nPm2S, nPm2E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm3E > 0) and (Max_Past_Sessions >= 3) then
            begin
              HorizontalLineCustom(fPm3H, nNyPmColor, Session_Border_Width, 0, "PM", 8, tpTopLeft, nPm3S, nPm3E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm3L, nNyPmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nPm3S, nPm3E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm4E > 0) and (Max_Past_Sessions >= 4) then
            begin
              HorizontalLineCustom(fPm4H, nNyPmColor, Session_Border_Width, 0, "PM", 8, tpTopLeft, nPm4S, nPm4E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm4L, nNyPmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nPm4S, nPm4E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm5E > 0) and (Max_Past_Sessions >= 5) then
            begin
              HorizontalLineCustom(fPm5H, nNyPmColor, Session_Border_Width, 0, "PM", 8, tpTopLeft, nPm5S, nPm5E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm5L, nNyPmColor, Session_Border_Width, 0, "", 8, tpTopLeft, nPm5S, nPm5E, 0, nNyPmStartEff, nNyPmEndEff);
            end;

          if Show_Session_Levels and (nPm1E > 0) then
            begin
              HorizontalLineCustom(fPm1H, nNyPmColor, 1, 2, "PM R", 8, tpTopRight,
                nPm1E, 0, 0, nNyPmEndEff, nLineEndEff);
              HorizontalLineCustom(fPm1L, nNyPmColor, 1, 2, "PM S", 8, tpBottomRight,
                nPm1E, 0, 0, nNyPmEndEff, nLineEndEff);
            end;
        end;
    end;

  // =================== LINHAS HORIZONTAIS DE ABERTURA ===================

  // Midnight Open
  if Midnight_Enable and (nT >= nMidnightEff) and
     ((Date <> Date[1]) or (Time[1] < nMidnightEff)) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    HorizontalLineCustom(Open, nHorizColor, Line_Width, Line_Style,
      Midnight_Label, 8, tpTopRight, Date, Date, 0, nT, nLineEndEff);

  // 8:30 Open
  if Open830_Enable and
     (((Date = Date[1]) and (Time[1] < nOpen830Eff) and (nT >= nOpen830Eff)) or
      ((Date <> Date[1]) and (nT = nOpen830Eff))) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    HorizontalLineCustom(Open, nHorizColor, Line_Width, Line_Style,
      Open830_Label, 8, tpTopRight, Date, Date, 0, nT, nLineEndEff);

  // 9:30 Open
  if Open930_Enable and
     (((Date = Date[1]) and (Time[1] < nOpen930Eff) and (nT >= nOpen930Eff)) or
      ((Date <> Date[1]) and (nT = nOpen930Eff))) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    HorizontalLineCustom(Open, nHorizColor, Line_Width, Line_Style,
      Open930_Label, 8, tpTopRight, Date, Date, 0, nT, nLineEndEff);

  // Weekly Open
  nWeekStartDate   := nWeekStartDate[1];
  fWeeklyOpenPrice := fWeeklyOpenPrice[1];

  if Weekly_Enable then
    begin
      if FirstWorkingDayOfWeek(Date) <> nWeekStartDate then
        begin
          nWeekStartDate   := FirstWorkingDayOfWeek(Date);
          fWeeklyOpenPrice := OpenW(0);
        end;

      if (fWeeklyOpenPrice > 0) and
         (nWeekStartDate >= CalcDate(LastCalcDate, -7 * Max_Past_Sessions)) then
        HorizontalLineCustom(fWeeklyOpenPrice, nHorizColor, Line_Width, Line_Style,
          Weekly_Label, 8, tpTopRight,
          nWeekStartDate, LastWorkingDayOfWeek(nWeekStartDate), 0, 0, nLineEndEff);
    end;

end;
