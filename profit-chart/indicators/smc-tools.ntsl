        end;
    end;

  // =================== NY PM ===================
  fNyPmHigh := fNyPmHigh[1]; fNyPmLow := fNyPmLow[1];
  nNyPmStartDate := nNyPmStartDate[1];
  fPm1H := fPm1H[1]; fPm2H := fPm2H[1]; fPm3H := fPm3H[1]; fPm4H := fPm4H[1]; fPm5H := fPm5H[1];
  fPm1L := fPm1L[1]; fPm2L := fPm2L[1]; fPm3L := fPm3L[1]; fPm4L := fPm4L[1]; fPm5L := fPm5L[1];
  nPm1S := nPm1S[1]; nPm2S := nPm2S[1]; nPm3S := nPm3S[1]; nPm4S := nPm4S[1]; nPm5S := nPm5S[1];
  nPm1E := nPm1E[1]; nPm2E := nPm2E[1]; nPm3E := nPm3E[1]; nPm4E := nPm4E[1]; nPm5E := nPm5E[1];

  if Ativar_NY_PM then
    begin
      if nNyPmStartEff > nNyPmEndEff then
        bInNyPm := (nT >= nNyPmStartEff) or (nT < nNyPmEndEff)
      else
        bInNyPm := (nT >= nNyPmStartEff) and (nT < nNyPmEndEff);

      if bInNyPm and not bInNyPm[1] then
        begin
          fNyPmHigh := High; fNyPmLow := Low;
          if (nNyPmStartEff > nNyPmEndEff) and (nT < nNyPmEndEff) then
            nNyPmStartDate := CalcDate(Date, -1)
          else
            nNyPmStartDate := Date;
        end
      else if bInNyPm then
        begin
          if High > fNyPmHigh then fNyPmHigh := High;
          if Low  < fNyPmLow  then fNyPmLow  := Low;
        end
      else if bInNyPm[1] then
        begin
          fPm5H := fPm4H; fPm5L := fPm4L; nPm5S := nPm4S; nPm5E := nPm4E;
          fPm4H := fPm3H; fPm4L := fPm3L; nPm4S := nPm3S; nPm4E := nPm3E;
          fPm3H := fPm2H; fPm3L := fPm2L; nPm3S := nPm2S; nPm3E := nPm2E;
          fPm2H := fPm1H; fPm2L := fPm1L; nPm2S := nPm1S; nPm2E := nPm1E;
          fPm1H := fNyPmHigh; fPm1L := fNyPmLow; nPm1S := nNyPmStartDate;
          if nNyPmStartEff > nNyPmEndEff then
            nPm1E := CalcDate(nNyPmStartDate, 1)
          else
            nPm1E := nNyPmStartDate;
        end;

      if bInNyPm and LastBarOnChart then
        begin
          HorizontalLineCustom((3*fNyPmHigh+fNyPmLow)/4, nNyPmFill, 1, 0,
            "", 8, tpTopLeft, nNyPmStartDate, Date, (fNyPmHigh-fNyPmLow)/4, nNyPmStartEff, nT);
          HorizontalLineCustom((fNyPmHigh+3*fNyPmLow)/4, nNyPmFill, 1, 0,
            "", 8, tpTopLeft, nNyPmStartDate, Date, (fNyPmHigh-fNyPmLow)/4, nNyPmStartEff, nT);
          HorizontalLineCustom(fNyPmHigh, nNyPmColor, Espessura_Borda_Sessao, 0,
            "NY PM", 8, tpTopLeft, nNyPmStartDate, Date, 0, nNyPmStartEff, nT);
          HorizontalLineCustom(fNyPmLow, nNyPmColor, Espessura_Borda_Sessao, 0,
            "", 8, tpTopLeft, nNyPmStartDate, Date, 0, nNyPmStartEff, nT);
        end;

      if LastBarOnChart then
        begin
          if (nPm1E > 0) and (Max_Sessoes_Passadas >= 1) then
            begin
              HorizontalLineCustom((3*fPm1H+fPm1L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm1S, nPm1E, (fPm1H-fPm1L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom((fPm1H+3*fPm1L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm1S, nPm1E, (fPm1H-fPm1L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm1H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm1S, nPm1E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm1L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm1S, nPm1E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm2E > 0) and (Max_Sessoes_Passadas >= 2) then
            begin
              HorizontalLineCustom((3*fPm2H+fPm2L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm2S, nPm2E, (fPm2H-fPm2L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom((fPm2H+3*fPm2L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm2S, nPm2E, (fPm2H-fPm2L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm2H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm2S, nPm2E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm2L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm2S, nPm2E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm3E > 0) and (Max_Sessoes_Passadas >= 3) then
            begin
              HorizontalLineCustom((3*fPm3H+fPm3L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm3S, nPm3E, (fPm3H-fPm3L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom((fPm3H+3*fPm3L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm3S, nPm3E, (fPm3H-fPm3L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm3H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm3S, nPm3E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm3L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm3S, nPm3E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm4E > 0) and (Max_Sessoes_Passadas >= 4) then
            begin
              HorizontalLineCustom((3*fPm4H+fPm4L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm4S, nPm4E, (fPm4H-fPm4L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom((fPm4H+3*fPm4L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm4S, nPm4E, (fPm4H-fPm4L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm4H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm4S, nPm4E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm4L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm4S, nPm4E, 0, nNyPmStartEff, nNyPmEndEff);
            end;
          if (nPm5E > 0) and (Max_Sessoes_Passadas >= 5) then
            begin
              HorizontalLineCustom((3*fPm5H+fPm5L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm5S, nPm5E, (fPm5H-fPm5L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom((fPm5H+3*fPm5L)/4, nNyPmFill, 1, 0, "", 8, tpTopLeft, nPm5S, nPm5E, (fPm5H-fPm5L)/4, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm5H, nNyPmColor, Espessura_Borda_Sessao, 0, "NY PM", 8, tpTopLeft, nPm5S, nPm5E, 0, nNyPmStartEff, nNyPmEndEff);
              HorizontalLineCustom(fPm5L, nNyPmColor, Espessura_Borda_Sessao, 0, "", 8, tpTopLeft, nPm5S, nPm5E, 0, nNyPmStartEff, nNyPmEndEff);
            end;

          if Mostrar_Niveis_Sessao and (nPm1E > 0) then
            begin
              HorizontalLineCustom(fPm1H, nNyPmColor, 1, 2, "NY PM High", 8, tpTopRight,
                nPm1E, 0, 0, 0, 2359);
              HorizontalLineCustom(fPm1L, nNyPmColor, 1, 2, "NY PM Low", 8, tpBottomRight,
                nPm1E, 0, 0, 0, 2359);
            end;
        end;
    end;

  // =================== LINHAS HORIZONTAIS DE ABERTURA ===================
  // Cada open type tem ring buffer de 5 slots; deteccao captura (shift + store),
  // redesenho acontece so em LastBarOnChart (mesma estrategia das sessoes).

  // Carry-forward dos slots de opens
  nMd1D := nMd1D[1]; nMd2D := nMd2D[1]; nMd3D := nMd3D[1]; nMd4D := nMd4D[1]; nMd5D := nMd5D[1];
  fMd1P := fMd1P[1]; fMd2P := fMd2P[1]; fMd3P := fMd3P[1]; fMd4P := fMd4P[1]; fMd5P := fMd5P[1];
  n83a1D := n83a1D[1]; n83a2D := n83a2D[1]; n83a3D := n83a3D[1]; n83a4D := n83a4D[1]; n83a5D := n83a5D[1];
  f83a1P := f83a1P[1]; f83a2P := f83a2P[1]; f83a3P := f83a3P[1]; f83a4P := f83a4P[1]; f83a5P := f83a5P[1];
  n93a1D := n93a1D[1]; n93a2D := n93a2D[1]; n93a3D := n93a3D[1]; n93a4D := n93a4D[1]; n93a5D := n93a5D[1];
  f93a1P := f93a1P[1]; f93a2P := f93a2P[1]; f93a3P := f93a3P[1]; f93a4P := f93a4P[1]; f93a5P := f93a5P[1];
  nWk1D := nWk1D[1]; nWk2D := nWk2D[1]; nWk3D := nWk3D[1]; nWk4D := nWk4D[1]; nWk5D := nWk5D[1];
  fWk1P := fWk1P[1]; fWk2P := fWk2P[1]; fWk3P := fWk3P[1]; fWk4P := fWk4P[1]; fWk5P := fWk5P[1];
  nWk1End := nWk1End[1]; nWk2End := nWk2End[1]; nWk3End := nWk3End[1]; nWk4End := nWk4End[1]; nWk5End := nWk5End[1];
  nWeekStartDate   := nWeekStartDate[1];

  // ----- Midnight Open: deteccao + shift -----
  if Ativar_Midnight and (nT >= nMidnightEff) and
     ((Date <> Date[1]) or (Time[1] < nMidnightEff)) and
     (Date <> nMd1D) then
    begin
      nMd5D := nMd4D; nMd4D := nMd3D; nMd3D := nMd2D; nMd2D := nMd1D;
      fMd5P := fMd4P; fMd4P := fMd3P; fMd3P := fMd2P; fMd2P := fMd1P;
      nMd1D := Date;
      fMd1P := Open;
    end;

  // ----- 8:30 Open: deteccao + shift -----
  if Ativar_830 and
     (((Date = Date[1]) and (Time[1] < nOpen830Eff) and (nT >= nOpen830Eff)) or
      ((Date <> Date[1]) and (nT = nOpen830Eff))) and
     (Date <> n83a1D) then
    begin
      n83a5D := n83a4D; n83a4D := n83a3D; n83a3D := n83a2D; n83a2D := n83a1D;
      f83a5P := f83a4P; f83a4P := f83a3P; f83a3P := f83a2P; f83a2P := f83a1P;
      n83a1D := Date;
      f83a1P := Open;
    end;

  // ----- 9:30 Open: deteccao + shift -----
  if Ativar_930 and
     (((Date = Date[1]) and (Time[1] < nOpen930Eff) and (nT >= nOpen930Eff)) or
      ((Date <> Date[1]) and (nT = nOpen930Eff))) and
     (Date <> n93a1D) then
    begin
      n93a5D := n93a4D; n93a4D := n93a3D; n93a3D := n93a2D; n93a2D := n93a1D;
      f93a5P := f93a4P; f93a4P := f93a3P; f93a3P := f93a2P; f93a2P := f93a1P;
      n93a1D := Date;
      f93a1P := Open;
    end;

  // ----- Weekly Open: deteccao + shift -----
  if Ativar_Weekly and (FirstWorkingDayOfWeek(Date) <> nWeekStartDate) then
    begin
      nWeekStartDate := FirstWorkingDayOfWeek(Date);
      nWk5D := nWk4D; nWk4D := nWk3D; nWk3D := nWk2D; nWk2D := nWk1D;
      fWk5P := fWk4P; fWk4P := fWk3P; fWk3P := fWk2P; fWk2P := fWk1P;
      nWk5End := nWk4End; nWk4End := nWk3End; nWk3End := nWk2End; nWk2End := nWk1End;
      nWk1D := nWeekStartDate;
      fWk1P := Open;
      nWk1End := LastWorkingDayOfWeek(nWeekStartDate);
    end;

  // ----- Desenha todos os slots de opens (so em LastBarOnChart) -----
  if LastBarOnChart then
    begin
      // Midnight slots
      if Ativar_Midnight then
        begin
          if (nMd1D > 0) and (Max_Sessoes_Passadas >= 1) then
            HorizontalLineCustom(fMd1P, nHorizColor, Espessura_Linha, Estilo_Linha, Midnight_Label, 8, tpTopRight, nMd1D, nMd1D, 0, nMidnightEff, nLineEndEff);
          if (nMd2D > 0) and (Max_Sessoes_Passadas >= 2) then
            HorizontalLineCustom(fMd2P, nHorizColor, Espessura_Linha, Estilo_Linha, Midnight_Label, 8, tpTopRight, nMd2D, nMd2D, 0, nMidnightEff, nLineEndEff);
          if (nMd3D > 0) and (Max_Sessoes_Passadas >= 3) then
            HorizontalLineCustom(fMd3P, nHorizColor, Espessura_Linha, Estilo_Linha, Midnight_Label, 8, tpTopRight, nMd3D, nMd3D, 0, nMidnightEff, nLineEndEff);
          if (nMd4D > 0) and (Max_Sessoes_Passadas >= 4) then
            HorizontalLineCustom(fMd4P, nHorizColor, Espessura_Linha, Estilo_Linha, Midnight_Label, 8, tpTopRight, nMd4D, nMd4D, 0, nMidnightEff, nLineEndEff);
          if (nMd5D > 0) and (Max_Sessoes_Passadas >= 5) then
            HorizontalLineCustom(fMd5P, nHorizColor, Espessura_Linha, Estilo_Linha, Midnight_Label, 8, tpTopRight, nMd5D, nMd5D, 0, nMidnightEff, nLineEndEff);
        end;

      // 8:30 slots
      if Ativar_830 then
        begin
          if (n83a1D > 0) and (Max_Sessoes_Passadas >= 1) then
            HorizontalLineCustom(f83a1P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_830, 8, tpTopRight, n83a1D, n83a1D, 0, nOpen830Eff, nLineEndEff);
          if (n83a2D > 0) and (Max_Sessoes_Passadas >= 2) then
            HorizontalLineCustom(f83a2P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_830, 8, tpTopRight, n83a2D, n83a2D, 0, nOpen830Eff, nLineEndEff);
          if (n83a3D > 0) and (Max_Sessoes_Passadas >= 3) then
            HorizontalLineCustom(f83a3P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_830, 8, tpTopRight, n83a3D, n83a3D, 0, nOpen830Eff, nLineEndEff);
          if (n83a4D > 0) and (Max_Sessoes_Passadas >= 4) then
            HorizontalLineCustom(f83a4P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_830, 8, tpTopRight, n83a4D, n83a4D, 0, nOpen830Eff, nLineEndEff);
          if (n83a5D > 0) and (Max_Sessoes_Passadas >= 5) then
            HorizontalLineCustom(f83a5P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_830, 8, tpTopRight, n83a5D, n83a5D, 0, nOpen830Eff, nLineEndEff);
        end;

      // 9:30 slots
      if Ativar_930 then
        begin
          if (n93a1D > 0) and (Max_Sessoes_Passadas >= 1) then
            HorizontalLineCustom(f93a1P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_930, 8, tpTopRight, n93a1D, n93a1D, 0, nOpen930Eff, nLineEndEff);
          if (n93a2D > 0) and (Max_Sessoes_Passadas >= 2) then
            HorizontalLineCustom(f93a2P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_930, 8, tpTopRight, n93a2D, n93a2D, 0, nOpen930Eff, nLineEndEff);
          if (n93a3D > 0) and (Max_Sessoes_Passadas >= 3) then
            HorizontalLineCustom(f93a3P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_930, 8, tpTopRight, n93a3D, n93a3D, 0, nOpen930Eff, nLineEndEff);
          if (n93a4D > 0) and (Max_Sessoes_Passadas >= 4) then
            HorizontalLineCustom(f93a4P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_930, 8, tpTopRight, n93a4D, n93a4D, 0, nOpen930Eff, nLineEndEff);
          if (n93a5D > 0) and (Max_Sessoes_Passadas >= 5) then
            HorizontalLineCustom(f93a5P, nHorizColor, Espessura_Linha, Estilo_Linha, Label_930, 8, tpTopRight, n93a5D, n93a5D, 0, nOpen930Eff, nLineEndEff);
        end;

      // Weekly slots
      if Ativar_Weekly then
        begin
          if (nWk1D > 0) and (Max_Sessoes_Passadas >= 1) then
            HorizontalLineCustom(fWk1P, nHorizColor, Espessura_Linha, Estilo_Linha, Weekly_Label, 8, tpTopRight, nWk1D, nWk1End, 0, 0, nLineEndEff);
          if (nWk2D > 0) and (Max_Sessoes_Passadas >= 2) then
            HorizontalLineCustom(fWk2P, nHorizColor, Espessura_Linha, Estilo_Linha, Weekly_Label, 8, tpTopRight, nWk2D, nWk2End, 0, 0, nLineEndEff);
          if (nWk3D > 0) and (Max_Sessoes_Passadas >= 3) then
            HorizontalLineCustom(fWk3P, nHorizColor, Espessura_Linha, Estilo_Linha, Weekly_Label, 8, tpTopRight, nWk3D, nWk3End, 0, 0, nLineEndEff);
          if (nWk4D > 0) and (Max_Sessoes_Passadas >= 4) then
            HorizontalLineCustom(fWk4P, nHorizColor, Espessura_Linha, Estilo_Linha, Weekly_Label, 8, tpTopRight, nWk4D, nWk4End, 0, 0, nLineEndEff);
          if (nWk5D > 0) and (Max_Sessoes_Passadas >= 5) then
            HorizontalLineCustom(fWk5P, nHorizColor, Espessura_Linha, Estilo_Linha, Weekly_Label, 8, tpTopRight, nWk5D, nWk5End, 0, 0, nLineEndEff);
        end;
    end;

end;
