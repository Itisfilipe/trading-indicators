// =========================================================================
// SMC TOOLS - Sessoes/Killzones e Linhas de Abertura
// =========================================================================
// Ferramentas para Smart Money Concepts:
//
//   1. Killzones / Sessoes desenhadas como canais (alta/baixa + linha media):
//        - Sessao Asia
//        - Sessao London
//        - Sessao NY AM
//        - Sessao NY Lunch
//        - Sessao NY PM
//      Cada sessao tem cor propria e horarios configuraveis (horario do Brasil).
//      Defaults equivalem aos killzones de futuros (NY) convertidos para BR
//      durante horario de verao americano (NY DST = BR + 1h).
//
//   2. Linhas de abertura (vertical + horizontal pontilhada):
//        - Midnight Open  (NY midnight = 01:00 BR durante DST)
//        - Weekly Open    (abertura semanal, somente horizontal)
//        - 8:30 Open      (NY 08:30 = 09:30 BR durante DST)
//        - 9:30 Open      (NY 09:30 = 10:30 BR durante DST)
//      A linha horizontal usa o preco de abertura no minuto especificado.
//
// Observacoes:
//   - Este indicador foi pensado para graficos baseados em tempo (1m, 5m, 15m).
//     Em Renko os tempos das barras nao se alinham; verticais podem nao aparecer.
//   - As horas estao no formato HHMM (Integer): 9:30 -> 930, midnight -> 0.
//   - Para horario sem DST (NY EST), some +1h em cada horario configurado.
// =========================================================================

input
  Tema_Escuro(false);

  // ----- Sessoes / Killzones (horario do Brasil) -----
  Enable_Asia(true);
  Asia_Start(2100);              // 21:00 BR  (NY 20:00 EDT)
  Asia_End(100);                 // 01:00 BR  (NY 00:00 EDT) - cruza meia-noite

  Enable_London(true);
  London_Start(300);             // 03:00 BR  (NY 02:00 EDT)
  London_End(600);               // 06:00 BR  (NY 05:00 EDT)

  Enable_NY_AM(true);
  NY_AM_Start(930);              // 09:30 BR  (NY 08:30 EDT)
  NY_AM_End(1200);               // 12:00 BR  (NY 11:00 EDT)

  Enable_NY_Lunch(true);
  NY_Lunch_Start(1300);          // 13:00 BR  (NY 12:00 EDT)
  NY_Lunch_End(1430);            // 14:30 BR  (NY 13:30 EDT)

  Enable_NY_PM(true);
  NY_PM_Start(1430);             // 14:30 BR  (NY 13:30 EDT)
  NY_PM_End(1700);               // 17:00 BR  (NY 16:00 EDT)

  Show_Middle_Line(true);        // linha media pontilhada dentro de cada sessao
  Session_Border_Width(1);

  // ----- Linhas HORIZONTAIS de abertura (preco Open na hora alvo) -----
  // Midnight Open
  Midnight_Enable(true);
  Midnight_Time(100);            // 01:00 BR = NY midnight (DST)
  Midnight_Label("Midnight Open");

  // Weekly Open
  Weekly_Enable(true);
  Weekly_Label("Weekly Open");

  // 8:30 Open
  Open830_Enable(true);
  Open830_Time(930);             // 09:30 BR = NY 08:30 (DST)
  Open830_Label("8:30 Open");

  // 9:30 Open
  Open930_Enable(true);
  Open930_Time(1030);            // 10:30 BR = NY 09:30 (DST)
  Open930_Label("9:30 Open");

  // ----- Linhas VERTICAIS (independentes das horizontais, sem label) -----
  Vert1_Enable(true);
  Vert1_Time(100);               // 01:00 BR

  Vert2_Enable(true);
  Vert2_Time(930);               // 09:30 BR

  Vert3_Enable(true);
  Vert3_Time(1030);              // 10:30 BR

  Line_Style(2);                 // 0=solido, 1=traco longo, 2=traco curto, 3/4=mistos
  Line_Width(1);
  Line_End_Time(1900);           // Hora final BR de cada linha intraday (default 19:00 BR = 18:00 NY DST)
  Max_Past_Sessions(5);          // Quantas sessoes/semanas passadas mostrar (limita acumulo no grafico)

var
  // Estado de sessao (series - retem entre barras)
  bInAsia, bInLondon, bInNyAm, bInNyLunch, bInNyPm : Boolean;

  fAsiaHigh,    fAsiaLow    : Float;
  fLondonHigh,  fLondonLow  : Float;
  fNyAmHigh,    fNyAmLow    : Float;
  fNyLunchHigh, fNyLunchLow : Float;
  fNyPmHigh,    fNyPmLow    : Float;

  nAsiaStartDate    : Integer;
  nLondonStartDate  : Integer;
  nNyAmStartDate    : Integer;
  nNyLunchStartDate : Integer;
  nNyPmStartDate    : Integer;

  // Cores
  nAsiaColor, nLondonColor, nNyAmColor, nNyLunchColor, nNyPmColor : Integer;
  nHorizColor                                                     : Integer;
  nVert1Color, nVert2Color, nVert3Color                           : Integer;

  // Auxiliares
  fMid, fHalfRange : Float;
  nT : Integer;
  nWeekStartDate : Integer;

begin
  // =================== CORES ===================
  if Tema_Escuro then
    begin
      nAsiaColor     := RGB(220, 200,  40);
      nLondonColor   := RGB( 80, 130, 255);
      nNyAmColor     := RGB(255,  80,  80);
      nNyLunchColor  := RGB(150, 200, 255);
      nNyPmColor     := RGB(200, 130, 255);

      // Horizontais: preto/branco unificado (tema escuro = quase branco)
      nHorizColor    := RGB(230, 230, 230);

      nVert1Color    := RGB(180, 180, 180);
      nVert2Color    := RGB(200, 140, 220);
      nVert3Color    := RGB(140, 220, 180);
    end
  else
    begin
      nAsiaColor     := RGB(220, 180,  20);
      nLondonColor   := RGB( 60, 100, 220);
      nNyAmColor     := RGB(220,  60,  60);
      nNyLunchColor  := RGB(110, 170, 230);
      nNyPmColor     := RGB(160,  80, 200);

      // Horizontais: preto solido (tema claro)
      nHorizColor    := RGB(0, 0, 0);

      nVert1Color    := RGB(100, 100, 100);
      nVert2Color    := RGB(140,  60, 180);
      nVert3Color    := RGB( 40, 140,  80);
    end;

  nT := Time;

  // =================== SESSAO ASIA ===================
  if Enable_Asia then
    begin
      // Asia cruza meia-noite quando Start > End
      if Asia_Start > Asia_End then
        bInAsia := (nT >= Asia_Start) or (nT < Asia_End)
      else
        bInAsia := (nT >= Asia_Start) and (nT < Asia_End);

      if bInAsia and not bInAsia[1] then
        begin
          fAsiaHigh := High;
          fAsiaLow  := Low;
          // Se entramos pelo lado pos-meia-noite, a sessao comecou ontem.
          if (Asia_Start > Asia_End) and (nT < Asia_End) then
            nAsiaStartDate := CalcDate(Date, -1)
          else
            nAsiaStartDate := Date;
        end
      else if bInAsia then
        begin
          if High > fAsiaHigh then fAsiaHigh := High;
          if Low  < fAsiaLow  then fAsiaLow  := Low;
        end
      else if bInAsia[1] and not bInAsia and
              (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
        begin
          fMid       := (fAsiaHigh + fAsiaLow) / 2;
          fHalfRange := (fAsiaHigh - fAsiaLow) / 2;
          // Preenchimento (banda) + texto
          HorizontalLineCustom(fMid, nAsiaColor, Session_Border_Width, 0,
            "Asia", 8, tpTopLeft,
            nAsiaStartDate, Date, fHalfRange, Asia_Start, Asia_End);
          // Linha media pontilhada
          if Show_Middle_Line then
            LineSegment(fMid, fMid, nAsiaStartDate, Date, false, "",
              nAsiaColor, 1, 2, 8, tpTopLeft, Asia_Start, Asia_End);
        end;
    end;

  // =================== SESSAO LONDON ===================
  if Enable_London then
    begin
      if London_Start > London_End then
        bInLondon := (nT >= London_Start) or (nT < London_End)
      else
        bInLondon := (nT >= London_Start) and (nT < London_End);

      if bInLondon and not bInLondon[1] then
        begin
          fLondonHigh := High;
          fLondonLow  := Low;
          nLondonStartDate := Date;
        end
      else if bInLondon then
        begin
          if High > fLondonHigh then fLondonHigh := High;
          if Low  < fLondonLow  then fLondonLow  := Low;
        end
      else if bInLondon[1] and not bInLondon and
              (nLondonStartDate >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
        begin
          fMid       := (fLondonHigh + fLondonLow) / 2;
          fHalfRange := (fLondonHigh - fLondonLow) / 2;
          HorizontalLineCustom(fMid, nLondonColor, Session_Border_Width, 0,
            "London", 8, tpTopLeft,
            nLondonStartDate, Date, fHalfRange, London_Start, London_End);
          if Show_Middle_Line then
            LineSegment(fMid, fMid, nLondonStartDate, Date, false, "",
              nLondonColor, 1, 2, 8, tpTopLeft, London_Start, London_End);
        end;
    end;

  // =================== SESSAO NY AM ===================
  if Enable_NY_AM then
    begin
      if NY_AM_Start > NY_AM_End then
        bInNyAm := (nT >= NY_AM_Start) or (nT < NY_AM_End)
      else
        bInNyAm := (nT >= NY_AM_Start) and (nT < NY_AM_End);

      if bInNyAm and not bInNyAm[1] then
        begin
          fNyAmHigh := High;
          fNyAmLow  := Low;
          nNyAmStartDate := Date;
        end
      else if bInNyAm then
        begin
          if High > fNyAmHigh then fNyAmHigh := High;
          if Low  < fNyAmLow  then fNyAmLow  := Low;
        end
      else if bInNyAm[1] and not bInNyAm and
              (nNyAmStartDate >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
        begin
          fMid       := (fNyAmHigh + fNyAmLow) / 2;
          fHalfRange := (fNyAmHigh - fNyAmLow) / 2;
          HorizontalLineCustom(fMid, nNyAmColor, Session_Border_Width, 0,
            "NY AM", 8, tpTopLeft,
            nNyAmStartDate, Date, fHalfRange, NY_AM_Start, NY_AM_End);
          if Show_Middle_Line then
            LineSegment(fMid, fMid, nNyAmStartDate, Date, false, "",
              nNyAmColor, 1, 2, 8, tpTopLeft, NY_AM_Start, NY_AM_End);
        end;
    end;

  // =================== SESSAO NY LUNCH ===================
  if Enable_NY_Lunch then
    begin
      if NY_Lunch_Start > NY_Lunch_End then
        bInNyLunch := (nT >= NY_Lunch_Start) or (nT < NY_Lunch_End)
      else
        bInNyLunch := (nT >= NY_Lunch_Start) and (nT < NY_Lunch_End);

      if bInNyLunch and not bInNyLunch[1] then
        begin
          fNyLunchHigh := High;
          fNyLunchLow  := Low;
          nNyLunchStartDate := Date;
        end
      else if bInNyLunch then
        begin
          if High > fNyLunchHigh then fNyLunchHigh := High;
          if Low  < fNyLunchLow  then fNyLunchLow  := Low;
        end
      else if bInNyLunch[1] and not bInNyLunch and
              (nNyLunchStartDate >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
        begin
          fMid       := (fNyLunchHigh + fNyLunchLow) / 2;
          fHalfRange := (fNyLunchHigh - fNyLunchLow) / 2;
          HorizontalLineCustom(fMid, nNyLunchColor, Session_Border_Width, 0,
            "NY Lunch", 8, tpTopLeft,
            nNyLunchStartDate, Date, fHalfRange, NY_Lunch_Start, NY_Lunch_End);
          if Show_Middle_Line then
            LineSegment(fMid, fMid, nNyLunchStartDate, Date, false, "",
              nNyLunchColor, 1, 2, 8, tpTopLeft, NY_Lunch_Start, NY_Lunch_End);
        end;
    end;

  // =================== SESSAO NY PM ===================
  if Enable_NY_PM then
    begin
      if NY_PM_Start > NY_PM_End then
        bInNyPm := (nT >= NY_PM_Start) or (nT < NY_PM_End)
      else
        bInNyPm := (nT >= NY_PM_Start) and (nT < NY_PM_End);

      if bInNyPm and not bInNyPm[1] then
        begin
          fNyPmHigh := High;
          fNyPmLow  := Low;
          nNyPmStartDate := Date;
        end
      else if bInNyPm then
        begin
          if High > fNyPmHigh then fNyPmHigh := High;
          if Low  < fNyPmLow  then fNyPmLow  := Low;
        end
      else if bInNyPm[1] and not bInNyPm and
              (nNyPmStartDate >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
        begin
          fMid       := (fNyPmHigh + fNyPmLow) / 2;
          fHalfRange := (fNyPmHigh - fNyPmLow) / 2;
          HorizontalLineCustom(fMid, nNyPmColor, Session_Border_Width, 0,
            "NY PM", 8, tpTopLeft,
            nNyPmStartDate, Date, fHalfRange, NY_PM_Start, NY_PM_End);
          if Show_Middle_Line then
            LineSegment(fMid, fMid, nNyPmStartDate, Date, false, "",
              nNyPmColor, 1, 2, 8, tpTopLeft, NY_PM_Start, NY_PM_End);
        end;
    end;

  // =================== LINHAS HORIZONTAIS DE ABERTURA ===================
  // Disparam na primeira barra do dia em que o horario do candle cruza o alvo
  // (ou no inicio de um novo dia, para o caso da meia-noite).
  // Linha horizontal no preco Open da barra, da hora do candle ate Line_End_Time.

  // ----- Midnight Open -----
  if Midnight_Enable and (nT >= Midnight_Time) and
     ((Time[1] < Midnight_Time) or (Date <> Date[1])) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    HorizontalLineCustom(Open, nHorizColor, Line_Width, Line_Style,
      Midnight_Label, 8, tpTopRight,
      Date, Date, 0, nT, Line_End_Time);

  // ----- 8:30 Open -----
  // Dispara somente em cruzamento intraday (mesma data) para evitar pegar
  // 1a barra de um dia que abre depois do alvo como se fosse o preco do alvo.
  if Open830_Enable and (nT >= Open830_Time) and (Time[1] < Open830_Time) and
     (Date = Date[1]) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    HorizontalLineCustom(Open, nHorizColor, Line_Width, Line_Style,
      Open830_Label, 8, tpTopRight,
      Date, Date, 0, nT, Line_End_Time);

  // ----- 9:30 Open -----
  if Open930_Enable and (nT >= Open930_Time) and (Time[1] < Open930_Time) and
     (Date = Date[1]) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    HorizontalLineCustom(Open, nHorizColor, Line_Width, Line_Style,
      Open930_Label, 8, tpTopRight,
      Date, Date, 0, nT, Line_End_Time);

  // ----- Weekly Open -----
  // Desenha uma vez por semana, na primeira barra cuja semana muda.
  // Identidade por inicio-da-semana (evita falha se 2 semanas abrirem no mesmo preco).
  // Limite Max_Past_Sessions interpretado em semanas.
  if Weekly_Enable then
    begin
      nWeekStartDate := FirstWorkingDayOfWeek(Date);
      if (nWeekStartDate <> nWeekStartDate[1]) and
         (Date >= CalcDate(LastCalcDate, -7 * Max_Past_Sessions)) then
        HorizontalLineCustom(OpenW(0), nHorizColor, Line_Width, Line_Style,
          Weekly_Label, 8, tpTopRight,
          nWeekStartDate, CalcDate(nWeekStartDate, 7), 0, 0, Line_End_Time);
    end;

  // =================== LINHAS VERTICAIS ===================
  // Independentes das horizontais. Desenham na barra que cruza o horario alvo.
  // Limite Max_Past_Sessions em dias.

  // ----- Vertical 1 -----
  if Vert1_Enable and (nT >= Vert1_Time) and
     ((Time[1] < Vert1_Time) or (Date <> Date[1])) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    VerticalLineCustom(nVert1Color, Line_Width, Line_Style,
      "", 8, tpTopRight, 0, 0, false);

  // ----- Vertical 2 -----
  if Vert2_Enable and (nT >= Vert2_Time) and
     ((Time[1] < Vert2_Time) or (Date <> Date[1])) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    VerticalLineCustom(nVert2Color, Line_Width, Line_Style,
      "", 8, tpTopRight, 0, 0, false);

  // ----- Vertical 3 -----
  if Vert3_Enable and (nT >= Vert3_Time) and
     ((Time[1] < Vert3_Time) or (Date <> Date[1])) and
     (Date >= CalcDate(LastCalcDate, -Max_Past_Sessions)) then
    VerticalLineCustom(nVert3Color, Line_Width, Line_Style,
      "", 8, tpTopRight, 0, 0, false);
end;
