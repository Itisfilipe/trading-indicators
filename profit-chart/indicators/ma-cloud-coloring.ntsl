// =========================================================================
// MOVING AVERAGES CLOUD - Regra de Coloracao
// =========================================================================
// Pinta candles baseado no alinhamento de 2 EMAs + confirmacao de preco:
//   - VERDE: Alinhamento de alta (rapida > lenta) e preco confirma
//   - VERMELHO: Alinhamento de baixa (rapida < lenta) e preco confirma
//   - CINZA: Preco contradiz a tendencia
//
// IMPORTANTE: Criar como REGRA DE COLORACAO (nao como Indicador)
// Editor de Estrategias -> Nova Estrategia -> Coloracao
// =========================================================================

input
  // Periodo da media movel exponencial rapida. Padrao: 21
  Periodo_EMA_Rapida(21);

  // Periodo da media movel exponencial lenta. Padrao: 42
  Periodo_EMA_Lenta(42);

var
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaMax: Float;
  fEmaMin: Float;

begin
  // -----------------------------------------------------------------------
  // Calcula EMAs
  // -----------------------------------------------------------------------
  fEmaFast := MediaExp(Periodo_EMA_Rapida, Close);
  fEmaSlow := MediaExp(Periodo_EMA_Lenta, Close);

  if fEmaFast > fEmaSlow then begin
    fEmaMax := fEmaFast;
    fEmaMin := fEmaSlow;
  end else begin
    fEmaMax := fEmaSlow;
    fEmaMin := fEmaFast;
  end;

  // -----------------------------------------------------------------------
  // Aplica coloracao (cinza quando preco contradiz a tendencia)
  // -----------------------------------------------------------------------
  if (fEmaFast > fEmaSlow) and (Close >= fEmaMin) then
    PaintBar(RGB(0, 180, 80))
  else if (fEmaFast < fEmaSlow) and (Close <= fEmaMax) then
    PaintBar(RGB(220, 50, 50))
  else
    PaintBar(RGB(128, 128, 128));

end;
