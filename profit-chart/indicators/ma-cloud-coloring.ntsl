// =========================================================================
// MOVING AVERAGES CLOUD - Regra de Coloracao
// =========================================================================
// Pinta os candles com base no alinhamento de 2 EMAs.
//
// O que faz:
//   - Verde se tendencia de alta e preco confirma
//   - Vermelho se tendencia de baixa e preco confirma
//   - Cinza se o preco contradiz a tendencia
//
// IMPORTANTE: Criar como REGRA DE COLORACAO (nao como Indicador)
// Editor de Estrategias -> Nova Estrategia -> Coloracao
// =========================================================================

input
  // Periodo da EMA rapida. Padrao: 17
  Periodo_EMA_Rapida(17);

  // Periodo da EMA lenta. Padrao: 34
  Periodo_EMA_Lenta(34);

  // Pintar de cinza quando o preco contradiz a tendencia? Desligado, fica
  // sempre na cor da tendencia (EMA rapida acima = verde, abaixo = vermelho)
  Exibir_Neutro(true);

  // Tema escuro (true) ou claro (false)
  Tema_Escuro(true);

var
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaMax: Float;
  fEmaMin: Float;

  // Cores do tema
  nBullColor: Integer;
  nBearColor: Integer;
  nNeutralColor: Integer;

begin
  // -----------------------------------------------------------------------
  // Define cores com base no tema
  // -----------------------------------------------------------------------
  if Tema_Escuro then begin
    nBullColor := RGB(61, 226, 149);     // verde do candle
    nBearColor := RGB(226, 43, 61);      // vermelho do candle
    nNeutralColor := RGB(80, 80, 80);     // cinza escuro
  end else begin
    nBullColor := RGB(0, 180, 80);        // verde
    nBearColor := RGB(220, 50, 50);       // vermelho
    nNeutralColor := RGB(128, 128, 128);  // cinza
  end;

  // -----------------------------------------------------------------------
  // Calcula as EMAs
  // -----------------------------------------------------------------------
  fEmaFast := MediaExp(Periodo_EMA_Rapida, Close);
  fEmaSlow := MediaExp(Periodo_EMA_Lenta, Close);

  if fEmaFast > fEmaSlow then begin
    fEmaMax := fEmaFast;
    fEmaMin := fEmaSlow;
  end else begin
    fEmaMax := fEmaSlow;
    fEmaMin := fEmaFast;
  end;

  if not Exibir_Neutro then begin
    if fEmaFast > fEmaSlow then
      nNeutralColor := nBullColor
    else
      nNeutralColor := nBearColor;
  end;

  // -----------------------------------------------------------------------
  // Pinta o candle com base na tendencia
  // -----------------------------------------------------------------------
  if (fEmaFast > fEmaSlow) and (Close >= fEmaMin) then
    PaintBar(nBullColor)
  else if (fEmaFast < fEmaSlow) and (Close <= fEmaMax) then
    PaintBar(nBearColor)
  else
    PaintBar(nNeutralColor);

end;
