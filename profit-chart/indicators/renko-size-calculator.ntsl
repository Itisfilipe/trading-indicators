// =========================================================================
// RENKO SIZE CALCULATOR - Metade do ATR em Ticks
// =========================================================================
// Calcula o tamanho ideal de box Renko baseado na metade do ATR.
//
// O que faz:
//   - Calcula o ATR (volatilidade media) dos ultimos N dias
//   - Divide pela metade e converte em ticks
//   - O resultado e o tamanho sugerido para o box Renko
//
// Como usar:
//   - Aplique em um grafico de tempo (ex: 30s, 1min, 5min)
//   - A linha verde mostra o tamanho sugerido em ticks
//   - Use esse valor para configurar seu grafico Renko
//
// O periodo e definido em DIAS e o indicador calcula automaticamente
// quantos candles isso representa no timeframe atual.
// =========================================================================

input
  // Numero de dias para calcular o ATR. Padrao: 5
  Periodo_Dias(5);

  // Ignorar gaps de abertura (overnight)? Padrao: false
  // Quando ativo, usa apenas High-Low no primeiro candle do dia
  Ignorar_Gaps(false);

  // Mostrar linha do ATR no grafico?
  Exibir_ATR(true);

  // Mostrar numero de candles calculado? (util para debug)
  Exibir_Num_Candles(false);

  // Tema escuro (true) ou claro (false)
  Tema_Escuro(false);

var
  bStarted: Boolean;
  fTickSize: Float;

  // Calculo do True Range
  fTrueRange: Float;
  fHighLow: Float;
  fHighClose: Float;
  fLowClose: Float;

  // Deteccao de sessao
  bIsNewSession: Boolean;

  // Contagem de candles por dia
  nCandlesInCurrentDay: Integer;
  nCandlesPerDay: Integer;
  nDaysCount: Integer;
  nActualPeriod: Integer;

  // Resultados
  fATR: Float;
  nRenkoTicks: Integer;

  // Cores
  nATRColor: Integer;
  nTicksColor: Integer;
  nCandlesColor: Integer;

begin
  // -----------------------------------------------------------------------
  // Define cores com base no tema
  // -----------------------------------------------------------------------
  if not bStarted then begin
    bStarted := True;
    nCandlesPerDay := 0;
    nCandlesInCurrentDay := 0;
    nDaysCount := 0;
  end;

  if Tema_Escuro then begin
    nATRColor := RGB(255, 180, 80);       // laranja claro
    nTicksColor := RGB(0, 255, 100);      // verde vivo
    nCandlesColor := RGB(100, 150, 255);  // azul claro
  end else begin
    nATRColor := RGB(255, 150, 50);       // laranja
    nTicksColor := RGB(100, 255, 100);    // verde
    nCandlesColor := RGB(150, 150, 255);  // azul
  end;

  // -----------------------------------------------------------------------
  // Tamanho do tick do ativo
  // -----------------------------------------------------------------------
  fTickSize := MinPriceIncrement;

  // -----------------------------------------------------------------------
  // Detecta novo dia e conta candles por dia
  // -----------------------------------------------------------------------
  bIsNewSession := (Date <> Date[1]);

  if bIsNewSession then begin
    if nCandlesInCurrentDay > 0 then begin
      nCandlesPerDay := nCandlesInCurrentDay;
      nDaysCount := nDaysCount + 1;
    end;
    nCandlesInCurrentDay := 1;
  end else
    nCandlesInCurrentDay := nCandlesInCurrentDay + 1;

  // -----------------------------------------------------------------------
  // Periodo real = dias x candles por dia
  // -----------------------------------------------------------------------
  if nCandlesPerDay > 0 then
    nActualPeriod := Periodo_Dias * nCandlesPerDay
  else
    nActualPeriod := Periodo_Dias;

  if nActualPeriod < 1 then
    nActualPeriod := 1;

  // -----------------------------------------------------------------------
  // Calcula True Range (volatilidade de cada candle)
  // Se Ignorar_Gaps esta ativo, usa apenas High-Low no primeiro candle
  // do dia para nao distorcer com o gap de abertura
  // -----------------------------------------------------------------------
  fHighLow := High - Low;

  if Ignorar_Gaps and bIsNewSession then
    fTrueRange := fHighLow
  else begin
    fHighClose := ABS(High - Close[1]);
    fLowClose := ABS(Low - Close[1]);
    fTrueRange := fHighLow;
    if fHighClose > fTrueRange then
      fTrueRange := fHighClose;
    if fLowClose > fTrueRange then
      fTrueRange := fLowClose;
  end;

  // -----------------------------------------------------------------------
  // ATR = media exponencial do True Range
  // Tamanho Renko = metade do ATR convertido em ticks
  // -----------------------------------------------------------------------
  fATR := MediaExp(nActualPeriod, fTrueRange);

  if fTickSize > 0 then
    nRenkoTicks := Round((fATR / 2) / fTickSize)
  else
    nRenkoTicks := 0;

  // -----------------------------------------------------------------------
  // Desenha os plots
  // -----------------------------------------------------------------------
  if Exibir_ATR then begin
    PlotN(1, fATR);
    SetPlotColor(1, nATRColor);
    SetPlotWidth(1, 2);
  end;

  PlotN(2, nRenkoTicks);
  SetPlotColor(2, nTicksColor);
  SetPlotWidth(2, 2);

  if Exibir_Num_Candles then begin
    PlotN(3, nActualPeriod);
    SetPlotColor(3, nCandlesColor);
    SetPlotWidth(3, 1);
  end;

end;
