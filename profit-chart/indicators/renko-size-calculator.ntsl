// =========================================================================
// RENKO SIZE CALCULATOR - Metade do ATR em Ticks
// =========================================================================
// Calcula o tamanho ideal de box Renko baseado na metade do ATR.
//
// O que faz:
//   - Calcula o ATR (volatilidade media) dos ultimos N dias
//   - Divide pela metade e converte em ticks
//   - O resultado e o tamanho sugerido para o box Renko
//
// Como usar:
//   - Aplique em um grafico de tempo (ex: 30s, 1min, 5min)
//   - A linha verde mostra o tamanho sugerido em ticks
//   - Use esse valor para configurar seu grafico Renko
//
// O periodo e definido em DIAS e o indicador calcula automaticamente
// quantos candles isso representa no timeframe atual.
//
// RTH (Regular Trading Hours):
//   - Apenas_RTH=true filtra candles fora da janela RTH_Inicio..RTH_Fim
//   - Util pra ativos com sessao prolongada (mini Dow noturno, futuros US)
//     onde o overnight tem volatilidade diferente do pregao regular
//   - Usa EMA manual ao inves de MediaExp para conseguir pular candles
//     fora da janela sem distorcer o calculo
// =========================================================================

input
  // Numero de dias para calcular o ATR. Padrao: 5
  Periodo_Dias(5);

  // Ignorar gaps de abertura (overnight)? Padrao: false
  // Quando ativo, usa apenas High-Low no primeiro candle do dia
  Ignorar_Gaps(false);

  // Calcular ATR apenas com candles do RTH (Regular Trading Hours)?
  // Padrao: false (usa o pregao todo)
  // Defaults configurados para RTH do Nasdaq (cash session 09:30-16:00 NY)
  Apenas_RTH(false);

  // RTH em horario NY? true (default) = soma offset para BR
  Horario_Em_NY(true);
  Offset_NY_Para_BR(60);         // minutos (60 = NY DST abr-out, 120 = EST nov-mar)

  // Janela do RTH (formato HHMM). Default: 09:30 - 16:00 NY (Nasdaq cash)
  RTH_Inicio(930);
  RTH_Fim(1600);

  // Mostrar linha do ATR no grafico?
  Exibir_ATR(true);

  // Mostrar numero de candles calculado? (util para debug)
  Exibir_Num_Candles(false);

  // Tema escuro (true) ou claro (false)
  Tema_Escuro(false);

var
  bStarted: Boolean;
  fTickSize: Float;

  // Calculo do True Range
  fTrueRange: Float;
  fHighLow: Float;
  fHighClose: Float;
  fLowClose: Float;

  // Deteccao de sessao
  bIsNewSession: Boolean;
  bInRTH: Boolean;
  bConsiderar: Boolean;          // Considerar candle no calculo? (true se in-RTH ou Apenas_RTH=false)
  nRTHStartEff, nRTHEndEff: Integer;

  // Contagem de candles por dia
  nCandlesInCurrentDay: Integer;
  nCandlesPerDay: Integer;
  nDaysCount: Integer;
  nActualPeriod: Integer;

  // Resultados
  fATR: Float;
  fK: Float;                     // Constante de suavizacao do EMA manual
  bEmaSeeded: Boolean;
  nRenkoTicks: Integer;

  // Cores
  nATRColor: Integer;
  nTicksColor: Integer;
  nCandlesColor: Integer;

begin
  // -----------------------------------------------------------------------
  // Define cores com base no tema
  // -----------------------------------------------------------------------
  if not bStarted then begin
    bStarted := True;
    nCandlesPerDay := 0;
    nCandlesInCurrentDay := 0;
    nDaysCount := 0;
  end;

  if Tema_Escuro then begin
    nATRColor := RGB(255, 180, 80);       // laranja claro
    nTicksColor := RGB(0, 255, 100);      // verde vivo
    nCandlesColor := RGB(100, 150, 255);  // azul claro
  end else begin
    nATRColor := RGB(255, 150, 50);       // laranja
    nTicksColor := RGB(100, 255, 100);    // verde
    nCandlesColor := RGB(150, 150, 255);  // azul
  end;

  // -----------------------------------------------------------------------
  // Tamanho do tick do ativo
  // -----------------------------------------------------------------------
  fTickSize := MinPriceIncrement;

  // -----------------------------------------------------------------------
  // Detecta novo dia e RTH (convertendo NY -> BR se necessario)
  // -----------------------------------------------------------------------
  if Horario_Em_NY then begin
    nRTHStartEff := CalcTime(RTH_Inicio, Offset_NY_Para_BR);
    nRTHEndEff   := CalcTime(RTH_Fim,    Offset_NY_Para_BR);
  end else begin
    nRTHStartEff := RTH_Inicio;
    nRTHEndEff   := RTH_Fim;
  end;

  bIsNewSession := (Date <> Date[1]);
  bInRTH := (Time >= nRTHStartEff) and (Time < nRTHEndEff);
  bConsiderar := (not Apenas_RTH) or bInRTH;

  // -----------------------------------------------------------------------
  // Conta candles por dia (apenas os que sao considerados)
  // -----------------------------------------------------------------------
  if bIsNewSession then begin
    if nCandlesInCurrentDay > 0 then begin
      nCandlesPerDay := nCandlesInCurrentDay;
      nDaysCount := nDaysCount + 1;
    end;
    if bConsiderar then
      nCandlesInCurrentDay := 1
    else
      nCandlesInCurrentDay := 0;
  end else if bConsiderar then
    nCandlesInCurrentDay := nCandlesInCurrentDay + 1;

  // -----------------------------------------------------------------------
  // Periodo real = dias x candles por dia
  // -----------------------------------------------------------------------
  if nCandlesPerDay > 0 then
    nActualPeriod := Periodo_Dias * nCandlesPerDay
  else
    nActualPeriod := Periodo_Dias;

  if nActualPeriod < 1 then
    nActualPeriod := 1;

  // -----------------------------------------------------------------------
  // Carry-forward do ATR (series zera entre barras quando indexado)
  // -----------------------------------------------------------------------
  fATR := fATR[1];

  // -----------------------------------------------------------------------
  // Calcula True Range e atualiza EMA manual SOMENTE em candles considerados
  // (todos quando Apenas_RTH=false, RTH apenas quando true).
  // EMA manual usado para permitir pular candles fora do RTH sem distorcer.
  // -----------------------------------------------------------------------
  if bConsiderar then begin
    fHighLow := High - Low;

    if Ignorar_Gaps and bIsNewSession then
      fTrueRange := fHighLow
    else begin
      fHighClose := ABS(High - Close[1]);
      fLowClose := ABS(Low - Close[1]);
      fTrueRange := fHighLow;
      if fHighClose > fTrueRange then
        fTrueRange := fHighClose;
      if fLowClose > fTrueRange then
        fTrueRange := fLowClose;
    end;

    fK := 2 / (nActualPeriod + 1);
    if not bEmaSeeded then begin
      fATR := fTrueRange;
      bEmaSeeded := True;
    end else
      fATR := fATR + fK * (fTrueRange - fATR);
  end;

  if fTickSize > 0 then
    nRenkoTicks := Round((fATR / 2) / fTickSize)
  else
    nRenkoTicks := 0;

  // -----------------------------------------------------------------------
  // Desenha os plots
  // -----------------------------------------------------------------------
  if Exibir_ATR then begin
    PlotN(1, fATR);
    SetPlotColor(1, nATRColor);
    SetPlotWidth(1, 2);
  end;

  PlotN(2, nRenkoTicks);
  SetPlotColor(2, nTicksColor);
  SetPlotWidth(2, 2);

  if Exibir_Num_Candles then begin
    PlotN(3, nActualPeriod);
    SetPlotColor(3, nCandlesColor);
    SetPlotWidth(3, 1);
  end;

end;
