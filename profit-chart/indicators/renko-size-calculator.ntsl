// =========================================================================
// RENKO SIZE CALCULATOR - Tamanho de box Renko (metade do ATR em ticks)
// =========================================================================
// Aplique no grafico de tempo que voce quer medir (1min, 5min, 15min...),
// em uma janela separada. Mostra duas linhas, em ticks:
//   - BOX (linha continua): metade do ATR atual. Reage ao dia de hoje.
//   - ESTAVEL (linha tracejada): metade da mediana das medias diarias do
//     True Range. Um dia fora da curva (CPI, payroll) quase nao mexe nela.
// O rotulo no ultimo candle repete os dois valores.
//
// O periodo e definido em DIAS; o indicador conta quantos candles cabem
// em um dia do grafico atual. O primeiro dia completo do grafico e usado
// para aprender essa contagem.
//
// Apenas_RTH=true usa so os candles dentro da janela RTH_Inicio..RTH_Fim,
// util para ativos com sessao noturna (futuros US).
// =========================================================================

input
  Periodo_Dias(5);

  // Ignorar o gap de abertura no primeiro candle do dia
  Ignorar_Gaps(true);

  Apenas_RTH(false);
  Horario_Em_NY(true);
  Offset_NY_Para_BR(60);         // minutos (60 = NY DST abr-out, 120 = EST nov-mar)
  RTH_Inicio(930);
  RTH_Fim(1600);

  Exibir_Estavel(true);
  Exibir_Rotulo(true);
  Tamanho_Fonte(9);
  Tema_Escuro(true);

var
  hasHistory, isNewDay, counted: Boolean;
  rthStart, rthEnd, days, period, slot, i, j, count, first: Integer;
  trueRange, swap: Float;

  candlesPerDay, observedDays, dayCount: Integer;
  daySum, atr, stableAtr: Float;

  dailyMeans: Array[1..128] of Float;
  sorted: Array[1..64] of Float;

  boxTicks, stableTicks, boxColor, stableColor, textColor: Integer;
  labelText: String;

begin
  days := Max(1, Min(Periodo_Dias, 60));
  hasHistory := CurrentBar > 1;
  isNewDay := hasHistory and (Date <> Date[1]);

  if Horario_Em_NY then begin
    rthStart := CalcTime(RTH_Inicio, Offset_NY_Para_BR);
    rthEnd := CalcTime(RTH_Fim, Offset_NY_Para_BR);
  end else begin
    rthStart := RTH_Inicio;
    rthEnd := RTH_Fim;
  end;
  counted := (not Apenas_RTH) or ((Time >= rthStart) and (Time < rthEnd));

  // Profit reexecuta o ultimo candle a cada negocio: todo estado parte do
  // valor do candle anterior, para que reexecutar nao conte duas vezes.
  candlesPerDay := candlesPerDay[1];
  observedDays := observedDays[1];
  dayCount := dayCount[1];
  daySum := daySum[1];
  atr := atr[1];
  stableAtr := stableAtr[1];

  // Virada do dia: o dia que terminou define os candles por dia e, se foi
  // visto por inteiro, entra na mediana. Cada dia grava sempre no mesmo slot.
  if isNewDay then begin
    if dayCount > 0 then begin
      candlesPerDay := dayCount;
      if observedDays > 0 then begin
        slot := Mod(observedDays, 128) + 1;
        dailyMeans[slot] := daySum / dayCount;

        count := Min(days, observedDays);
        first := observedDays - count + 1;
        for i := 1 to count do
          sorted[i] := dailyMeans[Mod(first + i - 1, 128) + 1];
        for i := 1 to count - 1 do
          for j := i + 1 to count do
            if sorted[j] < sorted[i] then begin
              swap := sorted[i];
              sorted[i] := sorted[j];
              sorted[j] := swap;
            end;
        if Mod(count, 2) = 1 then
          stableAtr := sorted[Round((count + 1) / 2)]
        else
          stableAtr := (sorted[Round(count / 2)] + sorted[Round(count / 2) + 1]) / 2;
      end;
    end;
    observedDays := observedDays + 1;
    daySum := 0;
    dayCount := 0;
  end;

  if counted then begin
    if (not hasHistory) or (Ignorar_Gaps and isNewDay) then
      trueRange := High - Low
    else
      trueRange := Max(High, Close[1]) - Min(Low, Close[1]);

    daySum := daySum + trueRange;
    dayCount := dayCount + 1;

    if candlesPerDay > 0 then
      period := days * candlesPerDay
    else
      period := days;
    if atr = 0 then
      atr := trueRange
    else
      atr := atr + (2 / (period + 1)) * (trueRange - atr);
  end;

  if Tema_Escuro then begin
    boxColor := RGB(0, 200, 255);
    stableColor := RGB(255, 200, 60);
    textColor := RGB(235, 235, 235);
  end else begin
    boxColor := RGB(0, 110, 200);
    stableColor := RGB(200, 120, 0);
    textColor := RGB(30, 30, 30);
  end;

  if MinPriceIncrement > 0 then begin
    boxTicks := Round((atr / 2) / MinPriceIncrement);
    stableTicks := Round((stableAtr / 2) / MinPriceIncrement);

    Plot(boxTicks);
    SetPlotColor(1, boxColor);
    SetPlotWidth(1, 2);

    if Exibir_Estavel and (stableTicks > 0) then begin
      Plot2(stableTicks);
      SetPlotColor(2, stableColor);
      SetPlotWidth(2, 2);
      SetPlotStyle(2, 2);
    end;

    if Exibir_Rotulo and LastBarOnChart then begin
      labelText := "box " + FloatToString(boxTicks, 0) + "t";
      if Exibir_Estavel and (stableTicks > 0) then
        labelText := labelText + "   estavel " + FloatToString(stableTicks, 0) + "t";
      PlotText(labelText, textColor, 1, Tamanho_Fonte);
    end;
  end;
end;
