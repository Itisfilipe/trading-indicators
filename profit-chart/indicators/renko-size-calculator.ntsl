// =========================================================================
// RENKO SIZE CALCULATOR - Tamanho de box Renko
// =========================================================================
// Aplique no grafico de tempo que voce quer medir (1min, 5min, 15min...),
// escolhendo NOVA JANELA ao inserir.
//
// Leituras (cada uma liga uma linha e entra no rotulo do ultimo candle):
//   - Mediana (ticks), ligada: metade da mediana das medias diarias do True
//     Range dos ultimos N dias, em ticks. E o box sugerido. So muda na virada
//     do dia, e pode repetir por alguns dias: um dia fora da curva (CPI,
//     payroll) quase nao mexe nela.
//   - Meio ATR (ticks), Meio ATR (pontos), ATR (pontos): ATR atual (media
//     exponencial), reage ao dia de hoje. Desligados por padrao.
//
// Apenas_RTH=true usa so os candles dentro da janela RTH_Inicio..RTH_Fim,
// util para ativos com sessao noturna (futuros US).
// =========================================================================

input
  Periodo_Dias(5);

  // Ignorar o gap de abertura no primeiro candle do dia
  Ignorar_Gaps(true);

  Apenas_RTH(false);
  Horario_Em_NY(true);
  Offset_NY_Para_BR(60);         // minutos (60 = NY DST abr-out, 120 = EST nov-mar)
  RTH_Inicio(930);
  RTH_Fim(1600);

  Exibir_Mediana_Ticks(true);
  Exibir_Meio_ATR_Ticks(false);
  Exibir_Meio_ATR(false);
  Exibir_ATR(false);

  Exibir_Rotulo(true);
  Casas_Decimais(1);
  Tamanho_Fonte(9);
  Tema_Escuro(true);

var
  hasHistory, isNewDay, counted: Boolean;
  rthStart, rthEnd, days, period, slot, i, j, count, first, minutesSincePrior: Integer;
  trueRange, swap: Float;

  chartMinutes, candlesPerDay, observedDays, dayCount, medianDays: Integer;
  daySum, atr, medianAtr: Float;

  dailyMeans: Array[1..128] of Float;
  sorted: Array[1..64] of Float;

  medianTicks, halfAtrTicks, medianColor, atrColor, textColor: Integer;
  labelY: Float;
  labelText: String;

Function ToTicks(Value: Float; TickSize: Float): Integer;
begin
  ToTicks := Round(Value / TickSize);
end;

begin
  days := Max(1, Min(Periodo_Dias, 60));
  hasHistory := CurrentBar > 1;
  isNewDay := hasHistory and (Date <> Date[1]);

  if Horario_Em_NY then begin
    rthStart := CalcTime(RTH_Inicio, Offset_NY_Para_BR);
    rthEnd := CalcTime(RTH_Fim, Offset_NY_Para_BR);
  end else begin
    rthStart := RTH_Inicio;
    rthEnd := RTH_Fim;
  end;
  counted := (not Apenas_RTH) or ((Time >= rthStart) and (Time < rthEnd));

  // Profit reexecuta o ultimo candle a cada negocio: todo estado parte do
  // valor do candle anterior, para que reexecutar nao conte duas vezes.
  chartMinutes := chartMinutes[1];
  candlesPerDay := candlesPerDay[1];
  observedDays := observedDays[1];
  dayCount := dayCount[1];
  daySum := daySum[1];
  atr := atr[1];
  medianAtr := medianAtr[1];
  medianDays := medianDays[1];

  if hasHistory and not isNewDay then begin
    minutesSincePrior := TimeToMinutes(Time) - TimeToMinutes(Time[1]);
    if (minutesSincePrior > 0) and ((chartMinutes = 0) or (minutesSincePrior < chartMinutes)) then
      chartMinutes := minutesSincePrior;
  end;

  // Virada do dia: o dia que terminou define os candles por dia e, se foi
  // visto por inteiro, entra na mediana. Cada dia grava sempre no mesmo slot.
  if isNewDay then begin
    if dayCount > 0 then begin
      candlesPerDay := dayCount;
      if observedDays > 0 then begin
        slot := Mod(observedDays, 128) + 1;
        dailyMeans[slot] := daySum / dayCount;

        count := Min(days, observedDays);
        first := observedDays - count + 1;
        for i := 1 to count do
          sorted[i] := dailyMeans[Mod(first + i - 1, 128) + 1];
        for i := 1 to count - 1 do
          for j := i + 1 to count do
            if sorted[j] < sorted[i] then begin
              swap := sorted[i];
              sorted[i] := sorted[j];
              sorted[j] := swap;
            end;
        if Mod(count, 2) = 1 then
          medianAtr := sorted[Round((count + 1) / 2)]
        else
          medianAtr := (sorted[Round(count / 2)] + sorted[Round(count / 2) + 1]) / 2;
        medianDays := count;
      end;
    end;
    observedDays := observedDays + 1;
    daySum := 0;
    dayCount := 0;
  end;

  if counted then begin
    if (not hasHistory) or (Ignorar_Gaps and isNewDay) then
      trueRange := High - Low
    else
      trueRange := Max(High, Close[1]) - Min(Low, Close[1]);

    daySum := daySum + trueRange;
    dayCount := dayCount + 1;

    if candlesPerDay > 0 then
      period := days * candlesPerDay
    else
      period := days;
    if atr = 0 then
      atr := trueRange
    else
      atr := atr + (2 / (period + 1)) * (trueRange - atr);
  end;

  if Tema_Escuro then begin
    medianColor := RGB(255, 200, 60);
    atrColor := RGB(0, 200, 255);
    textColor := RGB(235, 235, 235);
  end else begin
    medianColor := RGB(200, 120, 0);
    atrColor := RGB(0, 110, 200);
    textColor := RGB(30, 30, 30);
  end;

  if MinPriceIncrement > 0 then begin
    medianTicks := ToTicks(medianAtr / 2, MinPriceIncrement);
    halfAtrTicks := ToTicks(atr / 2, MinPriceIncrement);

    // Os quatro plots sao desenhados em todo candle e escondidos com NoPlot:
    // plot chamado so em alguns candles nao aparece no Profit.
    Plot(medianTicks);
    SetPlotColor(1, medianColor);
    SetPlotWidth(1, 2);
    Plot2(halfAtrTicks);
    SetPlotColor(2, atrColor);
    SetPlotWidth(2, 2);
    Plot3(atr / 2);
    SetPlotColor(3, atrColor);
    SetPlotStyle(3, 2);
    Plot4(atr);
    SetPlotColor(4, atrColor);
    SetPlotStyle(4, 1);
    if (not Exibir_Mediana_Ticks) or (medianAtr = 0) then
      NoPlot(1);
    if not Exibir_Meio_ATR_Ticks then
      NoPlot(2);
    if not Exibir_Meio_ATR then
      NoPlot(3);
    if not Exibir_ATR then
      NoPlot(4);

    if Exibir_Rotulo and LastBarOnChart then begin
      labelY := 0;
      if chartMinutes > 0 then
        labelText := FloatToString(chartMinutes, 0) + " min"
      else
        labelText := "grafico sem tempo fixo";

      if Exibir_Mediana_Ticks then begin
        if medianAtr = 0 then
          labelText := labelText + "  |  mediana: aguardando 2 dias completos"
        else begin
          labelY := medianTicks;
          labelText := labelText + "  |  mediana (" + FloatToString(medianDays, 0) + "d): "
            + FloatToString(medianTicks, 0) + " ticks";
        end;
      end;
      if Exibir_Meio_ATR_Ticks then begin
        if labelY = 0 then
          labelY := halfAtrTicks;
        labelText := labelText + "  |  meio ATR: " + FloatToString(halfAtrTicks, 0) + " ticks";
      end;
      if Exibir_Meio_ATR then begin
        if labelY = 0 then
          labelY := atr / 2;
        labelText := labelText + "  |  meio ATR: " + FloatToString(atr / 2, Casas_Decimais) + " pts";
      end;
      if Exibir_ATR then begin
        if labelY = 0 then
          labelY := atr;
        labelText := labelText + "  |  ATR: " + FloatToString(atr, Casas_Decimais) + " pts";
      end;

      PlotText(labelText, textColor, 3, Tamanho_Fonte, labelY);
    end;
  end;
end;
