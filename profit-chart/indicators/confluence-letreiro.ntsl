// =========================================================================
// CONFLUENCE LETREIRO - Indicador (complemento do Confluence Coloring)
// =========================================================================
// Exibe um letreiro colorido em uma sub-janela separada.
// Barra verde no gatilho de compra, vermelha no de venda, vazio caso contrario.
// Usa a mesma logica e inputs da regra de coloracao.
//
// IMPORTANTE: Manter inputs sincronizados com confluence-coloring.ntsl!
// Para aplicar: Clique direito no grafico -> "Inserir Indicador" -> Selecione este
// Exibir em sub-janela separada (nao sobrepor ao grafico de precos).
// =========================================================================

input
  // ----- MACD Maior (tendencia de longo prazo) -----

  // Periodo da EMA rapida do MACD maior. Padrao: 200
  Major_MACD_Fast(200);

  // Periodo da EMA lenta do MACD maior. Padrao: 800
  Major_MACD_Slow(800);

  // Periodo da linha de sinal do MACD maior. Padrao: 50
  Major_MACD_Signal(50);

  // ----- MACD Menor (curto prazo) -----

  // Periodo da EMA rapida do MACD menor. Padrao: 72
  Minor_MACD_Fast(72);

  // Periodo da EMA lenta do MACD menor. Padrao: 200
  Minor_MACD_Slow(200);

  // Periodo da linha de sinal do MACD menor. Padrao: 34
  Minor_MACD_Signal(34);

  // ----- Tape Reading -----

  // Periodo da media de agressao do tape. Padrao: 500
  Tape_MA_Saldo(500);

  // Periodo da media de volume do tape. Padrao: 300
  Tape_MA_Vol(300);

  // ----- Filtro de Tendencia (EMAs) -----

  // Periodo da EMA rapida. Padrao: 21
  EMA_Fast(21);

  // Periodo da EMA lenta. Padrao: 42
  EMA_Slow(42);

  // ----- Ativar/Desativar Regras -----

  // Exigir volume acima da media para tape
  Tape_Require_Volume(true);

  // Exigir agressao acima da media para tape
  Tape_Require_Aggression(true);

  // Razao minima pavio/corpo para rejeicao. Padrao: 1.5
  Rej_Wick_Ratio(1.5);

  // Ativar entrada por pullback na EMA (gatilho principal)
  Enable_EMA(true);

  // Ignorar regra de pullback (so exige direcao + zona EMA)
  Ignore_Pullback(false);

  // Ativar sinais de scalp (contra tendencia maior, MACD menor confirma)
  Enable_Scalp(false);

  // Tema escuro (true) ou claro (false)
  Tema_Escuro(false);

  // ----- Configuracoes do Letreiro -----

  // Tamanho da fonte. Padrao: 38
  Label_Size(38);

var
  // Componentes do MACD maior
  fMajorMacdLine: Float;
  fMajorSignalLine: Float;
  fMajorHistogram: Float;

  // Componentes do MACD menor
  fMinorMacdLine: Float;
  fMinorSignalLine: Float;
  fMinorHistogram: Float;

  // Componentes do tape reading
  fBalance: Float;
  fAbsBalance: Float;
  fVol: Float;
  fMaBalance: Float;
  fMaVol: Float;

  // Componentes de alinhamento EMA
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaUpper: Float;
  fEmaLower: Float;
  bBrickTouchesEma: Boolean;
  nCrossed: Integer;

  // Sinais booleanos
  bMajorBullish: Boolean;
  bMinorBullish: Boolean;
  bTapeHighlight: Boolean;
  bTapeBullish: Boolean;
  bTapeWithTrend: Boolean;
  bEmaBullish: Boolean;
  bEmaBearish: Boolean;

  // Componentes de rejeicao
  fBody: Float;
  fBottomWick: Float;
  fTopWick: Float;
  bRejBullWick: Boolean;
  bRejBearWick: Boolean;

  // Cores do tema
  nTriggerBull: Integer;
  nTriggerBear: Integer;
  nScalpBullColor: Integer;
  nScalpBearColor: Integer;
  nTextColor: Integer;

  // Resultados finais dos gatilhos
  bStrongBull: Boolean;
  bStrongBear: Boolean;
  bScalpBull: Boolean;
  bScalpBear: Boolean;
  bRejBull: Boolean;
  bRejBear: Boolean;
  bRejsBull: Boolean;
  bRejsBear: Boolean;

begin
  // -----------------------------------------------------------------------
  // Cores do Tema
  // -----------------------------------------------------------------------
  if Tema_Escuro then begin
    nTriggerBull := RGB(0, 120, 255);     // azul
    nTriggerBear := RGB(255, 0, 255);     // fucsia
    nScalpBullColor := RGB(0, 80, 180);   // azul escuro
    nScalpBearColor := RGB(180, 0, 180);  // fucsia escuro
    nTextColor := RGB(255, 255, 255);     // branco
  end else begin
    nTriggerBull := RGB(0, 120, 255);     // azul
    nTriggerBear := RGB(255, 0, 0);       // vermelho
    nScalpBullColor := RGB(100, 180, 255); // azul claro
    nScalpBearColor := RGB(160, 0, 0);    // vermelho escuro
    nTextColor := RGB(0, 0, 0);           // preto
  end;

  // -----------------------------------------------------------------------
  // Regra 1: Histograma MACD Maior
  // -----------------------------------------------------------------------
  fMajorMacdLine := MediaExp(Major_MACD_Fast, Close) - MediaExp(Major_MACD_Slow, Close);
  fMajorSignalLine := MediaExp(Major_MACD_Signal, fMajorMacdLine);
  fMajorHistogram := fMajorMacdLine - fMajorSignalLine;
  bMajorBullish := fMajorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Regra 2: Histograma MACD Menor
  // -----------------------------------------------------------------------
  fMinorMacdLine := MediaExp(Minor_MACD_Fast, Close) - MediaExp(Minor_MACD_Slow, Close);
  fMinorSignalLine := MediaExp(Minor_MACD_Signal, fMinorMacdLine);
  fMinorHistogram := fMinorMacdLine - fMinorSignalLine;
  bMinorBullish := fMinorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Regra 3: Tape Reading (volume + agressao)
  // -----------------------------------------------------------------------
  fBalance := AgressionVolBuy - AgressionVolSell;
  bTapeBullish := fBalance >= 0;
  if bTapeBullish then
    fAbsBalance := fBalance
  else
    fAbsBalance := -fBalance;
  fVol := QuantityVol(False, True);
  fMaBalance := Media(Tape_MA_Saldo, fAbsBalance);
  fMaVol := Media(Tape_MA_Vol, fVol);

  bTapeHighlight := (not Tape_Require_Volume or (fVol >= fMaVol))
    and (not Tape_Require_Aggression or (fAbsBalance >= fMaBalance));

  bTapeWithTrend := (bTapeBullish and (Close >= Open))
    or ((not bTapeBullish) and (Close < Open));

  if Close >= Open then
    fBody := Close - Open
  else
    fBody := Open - Close;
  if fBody = 0 then
    fBody := 1;

  if Open <= Close then
    fBottomWick := Open - Low
  else
    fBottomWick := Close - Low;

  if Open <= Close then
    fTopWick := High - Close
  else
    fTopWick := High - Open;

  bRejBullWick := (not bTapeWithTrend) and bTapeHighlight
    and (fBottomWick >= Rej_Wick_Ratio * fBody);
  bRejBearWick := (not bTapeWithTrend) and bTapeHighlight
    and (fTopWick >= Rej_Wick_Ratio * fBody);

  // -----------------------------------------------------------------------
  // Regra 4: Entrada por Pullback na EMA
  // -----------------------------------------------------------------------
  fEmaFast := MediaExp(EMA_Fast, Close);
  fEmaSlow := MediaExp(EMA_Slow, Close);

  if fEmaFast >= fEmaSlow then begin
    fEmaUpper := fEmaFast;
    fEmaLower := fEmaSlow;
  end else begin
    fEmaUpper := fEmaSlow;
    fEmaLower := fEmaFast;
  end;

  bBrickTouchesEma := (Low <= fEmaUpper) and (High >= fEmaLower);

  nCrossed := 0;
  if (Open[1] < fEmaSlow[1]) and (Close[1] < fEmaSlow[1]) then
    nCrossed := nCrossed + 1;
  if (Open[2] < fEmaSlow[2]) and (Close[2] < fEmaSlow[2]) then
    nCrossed := nCrossed + 1;
  if (Open[3] < fEmaSlow[3]) and (Close[3] < fEmaSlow[3]) then
    nCrossed := nCrossed + 1;
  if (Open[4] < fEmaSlow[4]) and (Close[4] < fEmaSlow[4]) then
    nCrossed := nCrossed + 1;
  if (Open[5] < fEmaSlow[5]) and (Close[5] < fEmaSlow[5]) then
    nCrossed := nCrossed + 1;
  if (Open[6] < fEmaSlow[6]) and (Close[6] < fEmaSlow[6]) then
    nCrossed := nCrossed + 1;

  if Ignore_Pullback then
    bEmaBullish := (fEmaFast > fEmaSlow)
      and (Close >= Open)
      and bBrickTouchesEma
  else begin
    bEmaBullish := (fEmaFast > fEmaSlow)
      and (Close >= Open)
      and bBrickTouchesEma
      and ((Close[1] < Open[1]) or (Close[2] < Open[2]) or (Close[3] < Open[3]) or (Close[4] < Open[4]) or (Close[5] < Open[5]) or (Close[6] < Open[6]))
      and (Close >= fEmaSlow)
      and (nCrossed <= 2);
  end;

  nCrossed := 0;
  if (Open[1] > fEmaSlow[1]) and (Close[1] > fEmaSlow[1]) then
    nCrossed := nCrossed + 1;
  if (Open[2] > fEmaSlow[2]) and (Close[2] > fEmaSlow[2]) then
    nCrossed := nCrossed + 1;
  if (Open[3] > fEmaSlow[3]) and (Close[3] > fEmaSlow[3]) then
    nCrossed := nCrossed + 1;
  if (Open[4] > fEmaSlow[4]) and (Close[4] > fEmaSlow[4]) then
    nCrossed := nCrossed + 1;
  if (Open[5] > fEmaSlow[5]) and (Close[5] > fEmaSlow[5]) then
    nCrossed := nCrossed + 1;
  if (Open[6] > fEmaSlow[6]) and (Close[6] > fEmaSlow[6]) then
    nCrossed := nCrossed + 1;

  if Ignore_Pullback then
    bEmaBearish := (fEmaFast < fEmaSlow)
      and (Close < Open)
      and bBrickTouchesEma
  else begin
    bEmaBearish := (fEmaFast < fEmaSlow)
      and (Close < Open)
      and bBrickTouchesEma
      and ((Close[1] >= Open[1]) or (Close[2] >= Open[2]) or (Close[3] >= Open[3]) or (Close[4] >= Open[4]) or (Close[5] >= Open[5]) or (Close[6] >= Open[6]))
      and (Close <= fEmaSlow)
      and (nCrossed <= 2);
  end;

  // -----------------------------------------------------------------------
  // Calculo Final dos Gatilhos
  // -----------------------------------------------------------------------
  bStrongBull := Enable_EMA and bEmaBullish
    and bTapeHighlight and bTapeWithTrend
    and bMajorBullish;
  bStrongBear := Enable_EMA and bEmaBearish
    and bTapeHighlight and bTapeWithTrend
    and (not bMajorBullish);
  bScalpBull := Enable_Scalp and Enable_EMA and bEmaBullish
    and bTapeHighlight and bTapeWithTrend
    and (not bMajorBullish) and bMinorBullish;
  bScalpBear := Enable_Scalp and Enable_EMA and bEmaBearish
    and bTapeHighlight and bTapeWithTrend
    and bMajorBullish and (not bMinorBullish);

  bRejBull := Enable_EMA and bEmaBullish and bRejBullWick
    and bMajorBullish;
  bRejBear := Enable_EMA and bEmaBearish and bRejBearWick
    and (not bMajorBullish);
  bRejsBull := Enable_Scalp and Enable_EMA and bEmaBullish and bRejBullWick
    and (not bMajorBullish) and bMinorBullish;
  bRejsBear := Enable_Scalp and Enable_EMA and bEmaBearish and bRejBearWick
    and bMajorBullish and (not bMinorBullish);

  // -----------------------------------------------------------------------
  // Letreiro: vazio por padrao, pisca no gatilho
  // -----------------------------------------------------------------------
  if bStrongBull or bRejBull then begin
    Plot(1);
    SetPlotType(1, 1);
    SetPlotWidth(1, 10);
    SetPlotColor(1, nTriggerBull);
    if bRejBull then
      PlotText("BUYR", nTextColor, 1, Label_Size)
    else
      PlotText("BUY", nTextColor, 1, Label_Size);
  end else if bStrongBear or bRejBear then begin
    Plot(1);
    SetPlotType(1, 1);
    SetPlotWidth(1, 10);
    SetPlotColor(1, nTriggerBear);
    if bRejBear then
      PlotText("SELLR", nTextColor, 1, Label_Size)
    else
      PlotText("SELL", nTextColor, 1, Label_Size);
  end else if bScalpBull or bRejsBull then begin
    Plot(1);
    SetPlotType(1, 1);
    SetPlotWidth(1, 10);
    SetPlotColor(1, nScalpBullColor);
    if bRejsBull then
      PlotText("BSCALPR", nTextColor, 1, Label_Size)
    else
      PlotText("BSCALP", nTextColor, 1, Label_Size);
  end else if bScalpBear or bRejsBear then begin
    Plot(1);
    SetPlotType(1, 1);
    SetPlotWidth(1, 10);
    SetPlotColor(1, nScalpBearColor);
    if bRejsBear then
      PlotText("SSCALPR", nTextColor, 1, Label_Size)
    else
      PlotText("SSCALP", nTextColor, 1, Label_Size);
  end else begin
    NoPlot(1);
  end;

end;
