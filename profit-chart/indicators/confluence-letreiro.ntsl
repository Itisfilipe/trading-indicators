// =========================================================================
// CONFLUENCE LETREIRO - Indicator (companion to Confluence Coloring)
// =========================================================================
// Displays a colored histogram banner in a separate sub-window.
// Green bar on bullish trigger, red bar on bearish trigger, gray otherwise.
// Uses the same logic and inputs as the coloring rule.
//
// IMPORTANT: Keep inputs in sync with confluence-coloring.ntsl!
// To apply: Right-click chart -> "Inserir Indicador" -> Select this
// Display in a separate sub-window (not overlaid on the price chart).
// =========================================================================

input
  // ----- Major MACD (longer-term) -----

  // Major MACD fast EMA period. Default: 200
  Major_MACD_Fast(200);

  // Major MACD slow EMA period. Default: 800
  Major_MACD_Slow(800);

  // Major MACD signal line period. Default: 50
  Major_MACD_Signal(50);

  // ----- Minor MACD (short-term) -----

  // Minor MACD fast EMA period. Default: 72
  Minor_MACD_Fast(72);

  // Minor MACD slow EMA period. Default: 200
  Minor_MACD_Slow(200);

  // Minor MACD signal line period. Default: 34
  Minor_MACD_Signal(34);

  // ----- Tape Reading -----

  // Number of days for tape average baseline. Default: 3
  Tape_Days(3);

  // ----- EMA Trend Filter -----

  // Fast EMA period for trend filter. Default: 21
  EMA_Fast(21);

  // Slow EMA period for trend filter. Default: 42
  EMA_Slow(42);

  // ----- Enable/Disable Rules -----

  // Require volume above average for tape
  Tape_Require_Volume(true);

  // Require aggression above average for tape
  Tape_Require_Aggression(true);

  // Minimum wick-to-body ratio for rejection trades. Default: 1.5
  Rej_Wick_Ratio(1.5);

  // Enable EMA pullback entry (core trigger)
  Enable_EMA(true);

  // Require pullback (opposite brick in last 3) before entry
  Enable_Pullback(true);

  // ----- Letreiro Settings -----

  // Label font size. Default: 38
  Label_Size(38);

var
  // Major MACD components
  fMajorMacdLine: Float;
  fMajorSignalLine: Float;
  fMajorHistogram: Float;

  // Minor MACD components
  fMinorMacdLine: Float;
  fMinorSignalLine: Float;
  fMinorHistogram: Float;

  // Tape reading components
  fBalance: Float;
  fAbsBalance: Float;
  fVol: Float;
  fMaBalance: Float;
  fMaVol: Float;
  nBarsToday: Integer;
  nBarsPerDay: Integer;
  nTapePeriod: Integer;

  // EMA alignment components
  fEmaFast: Float;
  fEmaSlow: Float;
  fEmaUpper: Float;
  fEmaLower: Float;
  bBrickTouchesEma: Boolean;
  nCrossed: Integer;

  // Signal booleans
  bMajorBullish: Boolean;
  bMinorBullish: Boolean;
  bTapeHighlight: Boolean;
  bTapeBullish: Boolean;
  bTapeWithTrend: Boolean;
  bEmaBullish: Boolean;
  bEmaBearish: Boolean;

  // Rejection components
  fBody: Float;
  fBottomWick: Float;
  fTopWick: Float;
  bRejBullWick: Boolean;
  bRejBearWick: Boolean;

  // Final trigger results
  bStrongBull: Boolean;
  bStrongBear: Boolean;
  bScalpBull: Boolean;
  bScalpBear: Boolean;
  bRejBull: Boolean;
  bRejBear: Boolean;
  bRejsBull: Boolean;
  bRejsBear: Boolean;

begin
  // -----------------------------------------------------------------------
  // Rule 1: Major MACD Histogram
  // -----------------------------------------------------------------------
  fMajorMacdLine := MediaExp(Major_MACD_Fast, Close) - MediaExp(Major_MACD_Slow, Close);
  fMajorSignalLine := MediaExp(Major_MACD_Signal, fMajorMacdLine);
  fMajorHistogram := fMajorMacdLine - fMajorSignalLine;
  bMajorBullish := fMajorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Rule 2: Minor MACD Histogram
  // -----------------------------------------------------------------------
  fMinorMacdLine := MediaExp(Minor_MACD_Fast, Close) - MediaExp(Minor_MACD_Slow, Close);
  fMinorSignalLine := MediaExp(Minor_MACD_Signal, fMinorMacdLine);
  fMinorHistogram := fMinorMacdLine - fMinorSignalLine;
  bMinorBullish := fMinorHistogram >= 0;

  // -----------------------------------------------------------------------
  // Rule 3: Tape Reading (volume + aggression aligned with candle)
  // -----------------------------------------------------------------------
  if Date <> Date[1] then begin
    nBarsPerDay := nBarsToday;
    nBarsToday := 1;
  end else
    nBarsToday := nBarsToday + 1;

  if nBarsPerDay > 0 then
    nTapePeriod := nBarsPerDay * Tape_Days
  else
    nTapePeriod := 500;

  fBalance := AgressionVolBuy - AgressionVolSell;
  bTapeBullish := fBalance >= 0;
  if bTapeBullish then
    fAbsBalance := fBalance
  else
    fAbsBalance := -fBalance;
  fVol := QuantityVol(False, True);
  fMaBalance := Media(nTapePeriod, fAbsBalance);
  fMaVol := Media(nTapePeriod, fVol);

  bTapeHighlight := (not Tape_Require_Volume or (fVol >= fMaVol))
    and (not Tape_Require_Aggression or (fAbsBalance >= fMaBalance));

  bTapeWithTrend := (bTapeBullish and (Close >= Open))
    or ((not bTapeBullish) and (Close < Open));

  if Close >= Open then
    fBody := Close - Open
  else
    fBody := Open - Close;
  if fBody = 0 then
    fBody := 1;

  if Open <= Close then
    fBottomWick := Open - Low
  else
    fBottomWick := Close - Low;

  if Open <= Close then
    fTopWick := High - Close
  else
    fTopWick := High - Open;

  bRejBullWick := (not bTapeWithTrend) and bTapeHighlight
    and (fBottomWick >= Rej_Wick_Ratio * fBody);
  bRejBearWick := (not bTapeWithTrend) and bTapeHighlight
    and (fTopWick >= Rej_Wick_Ratio * fBody);

  // -----------------------------------------------------------------------
  // Rule 4: EMA Pullback Entry
  // -----------------------------------------------------------------------
  fEmaFast := MediaExp(EMA_Fast, Close);
  fEmaSlow := MediaExp(EMA_Slow, Close);

  if fEmaFast >= fEmaSlow then begin
    fEmaUpper := fEmaFast;
    fEmaLower := fEmaSlow;
  end else begin
    fEmaUpper := fEmaSlow;
    fEmaLower := fEmaFast;
  end;

  bBrickTouchesEma := (Low <= fEmaUpper) and (High >= fEmaLower);

  nCrossed := 0;
  if (Open[1] < fEmaSlow[1]) and (Close[1] < fEmaSlow[1]) then
    nCrossed := nCrossed + 1;
  if (Open[2] < fEmaSlow[2]) and (Close[2] < fEmaSlow[2]) then
    nCrossed := nCrossed + 1;
  if (Open[3] < fEmaSlow[3]) and (Close[3] < fEmaSlow[3]) then
    nCrossed := nCrossed + 1;

  bEmaBullish := (fEmaFast > fEmaSlow)
    and (Close >= Open)
    and bBrickTouchesEma
    and ((not Enable_Pullback) or (Close[1] < Open[1]) or (Close[2] < Open[2]) or (Close[3] < Open[3]))
    and (Close >= fEmaSlow)
    and (nCrossed <= 1);

  nCrossed := 0;
  if (Open[1] > fEmaSlow[1]) and (Close[1] > fEmaSlow[1]) then
    nCrossed := nCrossed + 1;
  if (Open[2] > fEmaSlow[2]) and (Close[2] > fEmaSlow[2]) then
    nCrossed := nCrossed + 1;
  if (Open[3] > fEmaSlow[3]) and (Close[3] > fEmaSlow[3]) then
    nCrossed := nCrossed + 1;

  bEmaBearish := (fEmaFast < fEmaSlow)
    and (Close < Open)
    and bBrickTouchesEma
    and ((not Enable_Pullback) or (Close[1] >= Open[1]) or (Close[2] >= Open[2]) or (Close[3] >= Open[3]))
    and (Close <= fEmaSlow)
    and (nCrossed <= 1);

  // -----------------------------------------------------------------------
  // Final Trigger Computation
  // -----------------------------------------------------------------------
  bStrongBull := Enable_EMA and bEmaBullish
    and bTapeHighlight and bTapeWithTrend
    and bMajorBullish;
  bStrongBear := Enable_EMA and bEmaBearish
    and bTapeHighlight and bTapeWithTrend
    and (not bMajorBullish);
  bScalpBull := Enable_EMA and bEmaBullish
    and bTapeHighlight and bTapeWithTrend
    and (not bMajorBullish) and bMinorBullish;
  bScalpBear := Enable_EMA and bEmaBearish
    and bTapeHighlight and bTapeWithTrend
    and bMajorBullish and (not bMinorBullish);

  bRejBull := Enable_EMA and bEmaBullish and bRejBullWick
    and bMajorBullish;
  bRejBear := Enable_EMA and bEmaBearish and bRejBearWick
    and (not bMajorBullish);
  bRejsBull := Enable_EMA and bEmaBullish and bRejBullWick
    and (not bMajorBullish) and bMinorBullish;
  bRejsBear := Enable_EMA and bEmaBearish and bRejBearWick
    and bMajorBullish and (not bMinorBullish);

  // -----------------------------------------------------------------------
  // Letreiro: nothing by default, flashes on trigger
  // -----------------------------------------------------------------------
  if bStrongBull or bRejBull then begin
    Plot(1);
    SetPlotType(1, 1);
    SetPlotWidth(1, 10);
    SetPlotColor(1, RGB(0, 120, 255));
    if bRejBull then
      PlotText("BUYREJ", clWhite, 1, Label_Size)
    else
      PlotText("BUY", clWhite, 1, Label_Size);
  end else if bStrongBear or bRejBear then begin
    Plot(1);
    SetPlotType(1, 1);
    SetPlotWidth(1, 10);
    SetPlotColor(1, RGB(255, 0, 0));
    if bRejBear then
      PlotText("SELREJ", clWhite, 1, Label_Size)
    else
      PlotText("SELL", clWhite, 1, Label_Size);
  end else if bScalpBull or bRejsBull then begin
    Plot(1);
    SetPlotType(1, 1);
    SetPlotWidth(1, 10);
    SetPlotColor(1, RGB(0, 80, 160));
    if bRejsBull then
      PlotText("BSREJ", clWhite, 1, Label_Size)
    else
      PlotText("BSCAL", clWhite, 1, Label_Size);
  end else if bScalpBear or bRejsBear then begin
    Plot(1);
    SetPlotType(1, 1);
    SetPlotWidth(1, 10);
    SetPlotColor(1, RGB(160, 0, 0));
    if bRejsBear then
      PlotText("SSREJ", clWhite, 1, Label_Size)
    else
      PlotText("SSCAL", clWhite, 1, Label_Size);
  end else begin
    NoPlot(1);
  end;

end;
