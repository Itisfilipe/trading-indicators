// =========================================================================
// DAY OPEN - Linha de abertura do dia
// =========================================================================
// Plota uma linha horizontal no preco de abertura de cada dia.
// OpenD(0) retorna a abertura da sessao atual para cada barra,
// produzindo uma linha escalonada que reseta a cada novo dia.
// =========================================================================

begin
  Plot(OpenD(0));
  SetPlotColor(1, RGB(255, 165, 0));
  SetPlotWidth(1, 2);
  SetPlotStyle(1, 2);
end;
