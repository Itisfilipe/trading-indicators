// -----------------------------------------------------------------------------
// ORM Liquidity
// Author: Filipe Teixeira Amaral
// Version: 1.0
//
// Description:
// The liquidity the Open Reaction Model reads on NQ, in New York time:
// - session and killzone highs and lows: Asia 20:00-00:00, London 02:00-05:00,
//   Pre-market 08:00-09:30, NY AM 09:30-11:30, NY PM 13:30-16:00, with
//   optional boxes;
// - past days (PDH/PDL, the 1D candle without settlement, 18:00 to 17:00),
//   weeks (PWH/PWL), months (PMH/PML) and Mondays (MonH/MonL); only the latest
//   finished period carries the P name, older ones carry their date.
// Each level runs from the candle that made it to the first later candle that
// touches it, or to the last candle while untouched, with its caption glued
// above a high or below a low. Levels at one price ending on one candle share
// a caption ("NY AM Low / PDL").
//
// Notes:
// - Sessions and days come from a 5-minute feed and weeks, months and Mondays
//   from an hourly feed (the chart's own timeframe when larger), so a 1-minute
//   chart shows the whole history even where its own candles do not reach.
//   Where the chart's candles cover a level, its line starts and stops on the
//   exact candle.
// - Session edges must sit on the 5-minute grid.
// - Both history settings stop at 20 so every drawing fits TradingView's
//   500-box limit, session boxes included.
// -----------------------------------------------------------------------------

indicator('ORMLiquidity', 'ORM Liquidity', overlay = true, max_boxes_count = 500)

TZ = 'America/New_York'
MS_PER_MINUTE = 60000
HALF_DAY_MS = 43200000

sessionHistory = input.int(3, 'Sessions of history', minval = 1, maxval = 20)
showBoxes = input.bool(false, 'Session boxes', inline = 'box')
boxTransparency = input.int(90, 'Transparency', minval = 0, maxval = 100, inline = 'box')

periodHistory = input.int(5, 'Periods of history', minval = 1, maxval = 20, tooltip = 'Past days, weeks, months and Mondays kept on the chart.')
dayOn = input.bool(true, 'Day', inline = 'd')
dayColor = input.color(#455a64, '', inline = 'd')
weekOn = input.bool(true, 'Week', inline = 'w')
weekColor = input.color(#455a64, '', inline = 'w')
monthOn = input.bool(true, 'Month', inline = 'm')
monthColor = input.color(#455a64, '', inline = 'm')
mondayOn = input.bool(true, 'Monday', inline = 'mon')
mondayColor = input.color(#455a64, '', inline = 'mon')

win1On = input.bool(true, '', inline = 'w1')
win1Name = input.string('Asia', '', inline = 'w1')
win1Session = input.session('2000-0000', '', inline = 'w1')
win1Color = input.color(#2962ff, '', inline = 'w1')
win2On = input.bool(true, '', inline = 'w2')
win2Name = input.string('London', '', inline = 'w2')
win2Session = input.session('0200-0500', '', inline = 'w2')
win2Color = input.color(#9c27b0, '', inline = 'w2')
win3On = input.bool(true, '', inline = 'w3')
win3Name = input.string('Pre', '', inline = 'w3')
win3Session = input.session('0800-0930', '', inline = 'w3')
win3Color = input.color(#ff9800, '', inline = 'w3')
win4On = input.bool(true, '', inline = 'w4')
win4Name = input.string('NY AM', '', inline = 'w4')
win4Session = input.session('0930-1130', '', inline = 'w4')
win4Color = input.color(#089981, '', inline = 'w4')
win5On = input.bool(true, '', inline = 'w5')
win5Name = input.string('NY PM', '', inline = 'w5')
win5Session = input.session('1330-1600', '', inline = 'w5')
win5Color = input.color(#f23645, '', inline = 'w5')

type Range
    float hi
    int hiTime
    int hiTouched
    float lo
    int loTime
    int loTouched
    bool finished
    int tradingDay

// A period opens when the feed's period candle changes; with mondayOnly, only
// Monday's trading day (Sunday 18:00 to Monday 17:00) is kept.
trackPeriod(string period, bool mondayOnly, int keep) =>
    var ranges = array.new<Range>()
    if timeframe.change(period) and not barstate.isfirst
        if ranges.size() > 0
            previous = ranges.last()
            previous.finished := true
        if not mondayOnly or dayofweek(time_tradingday, 'UTC') == dayofweek.monday
            ranges.push(Range.new(high, time, na, low, time, na, false, time_tradingday))
    else if ranges.size() > 0 and not ranges.last().finished
        current = ranges.last()
        if high > current.hi
            current.hi := high
            current.hiTime := time
        if low < current.lo
            current.lo := low
            current.loTime := time
    keepNow = ranges.size() > 0 and not ranges.last().finished ? keep + 1 : keep
    while ranges.size() > keepNow
        ranges.shift()
    for levelRange in ranges
        if levelRange.finished
            if na(levelRange.hiTouched) and high >= levelRange.hi
                levelRange.hiTouched := time
            if na(levelRange.loTouched) and low <= levelRange.lo
                levelRange.loTouched := time
    barstate.islast ? ranges : na

type Zone
    int startTime
    int endTime
    int lastTime
    float hi
    int hiTime
    int hiTouched
    float lo
    int loTime
    int loTouched

// "HHMM-HHMM" to [start minute, length in ms]; an end before the start runs into the next day.
parseSession(string session) =>
    startMinute = int(str.tonumber(str.substring(session, 0, 2))) * 60 + int(str.tonumber(str.substring(session, 2, 4)))
    endMinute = int(str.tonumber(str.substring(session, 5, 7))) * 60 + int(str.tonumber(str.substring(session, 7, 9)))
    lengthMinutes = (endMinute - startMinute + 1440) % 1440
    [startMinute, (lengthMinutes == 0 ? 1440 : lengthMinutes) * MS_PER_MINUTE]

// The latest moment at or before t whose New York clock reads clockMinute.
latestClock(int t, int clockMinute) =>
    barMinute = hour(t, TZ) * 60 + minute(t, TZ)
    dayStart = timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0)
    base = barMinute >= clockMinute ? t : dayStart - HALF_DAY_MS
    timestamp(TZ, year(base, TZ), month(base, TZ), dayofmonth(base, TZ), int(clockMinute / 60), clockMinute % 60)

trackWindow(int startMinute, int lengthMs, int keep) =>
    var zones = array.new<Zone>()
    windowOpen = latestClock(time, startMinute)
    if time < windowOpen + lengthMs
        if zones.size() == 0 or zones.last().startTime != windowOpen
            zones.push(Zone.new(windowOpen, windowOpen + lengthMs, time, high, time, na, low, time, na))
            if zones.size() > keep
                zones.shift()
        else
            zone = zones.last()
            zone.lastTime := time
            if high > zone.hi
                zone.hi := high
                zone.hiTime := time
            if low < zone.lo
                zone.lo := low
                zone.loTime := time
    for zone in zones
        if time >= zone.endTime
            if na(zone.hiTouched) and high >= zone.hi
                zone.hiTouched := time
            if na(zone.loTouched) and low <= zone.lo
                zone.loTouched := time
    barstate.islast ? zones : na

// A feed below the chart's timeframe would only return its first sub-candle, so the chart's own timeframe takes over.
feedTimeframe(string minimum) =>
    timeframe.in_seconds() > timeframe.in_seconds(minimum) ? timeframe.period : minimum

feed = ticker.modify(syminfo.tickerid, session.extended)
dayFeedTf = feedTimeframe('5')
hourFeedTf = feedTimeframe('60')
dayFeedMs = timeframe.in_seconds(dayFeedTf) * 1000
hourFeedMs = timeframe.in_seconds(hourFeedTf) * 1000
days = request.security(feed, dayFeedTf, trackPeriod('D', false, periodHistory), lookahead = barmerge.lookahead_on)
weeks = request.security(feed, hourFeedTf, trackPeriod('W', false, periodHistory), lookahead = barmerge.lookahead_on)
months = request.security(feed, hourFeedTf, trackPeriod('M', false, periodHistory), lookahead = barmerge.lookahead_on)
mondays = request.security(feed, hourFeedTf, trackPeriod('D', true, periodHistory), lookahead = barmerge.lookahead_on)
[win1Start, win1Length] = parseSession(win1Session)
[win2Start, win2Length] = parseSession(win2Session)
[win3Start, win3Length] = parseSession(win3Session)
[win4Start, win4Length] = parseSession(win4Session)
[win5Start, win5Length] = parseSession(win5Session)
zones1 = request.security(feed, dayFeedTf, trackWindow(win1Start, win1Length, sessionHistory), lookahead = barmerge.lookahead_on)
zones2 = request.security(feed, dayFeedTf, trackWindow(win2Start, win2Length, sessionHistory), lookahead = barmerge.lookahead_on)
zones3 = request.security(feed, dayFeedTf, trackWindow(win3Start, win3Length, sessionHistory), lookahead = barmerge.lookahead_on)
zones4 = request.security(feed, dayFeedTf, trackWindow(win4Start, win4Length, sessionHistory), lookahead = barmerge.lookahead_on)
zones5 = request.security(feed, dayFeedTf, trackWindow(win5Start, win5Length, sessionHistory), lookahead = barmerge.lookahead_on)

var int firstBarTime = time

var barTimes = array.new<int>()
var barHighs = array.new<float>()
var barLows = array.new<float>()
if barTimes.size() >= 99999
    barTimes.shift()
    barHighs.shift()
    barLows.shift()
barTimes.push(time)
barHighs.push(high)
barLows.push(low)

// The first chart candle inside the feed candle at feedTime that reaches price; feedTime when none does,
// or when the chart's candles do not tile the feed's.
exactTime(int feedTime, int feedMs, float price, bool isHigh) =>
    int result = feedTime
    chartSeconds = timeframe.in_seconds()
    feedSeconds = int(feedMs / 1000)
    if not na(feedTime) and chartSeconds < feedSeconds and feedSeconds % chartSeconds == 0
        index = math.max(0, barTimes.binary_search_leftmost(feedTime))
        while index < barTimes.size() and barTimes.get(index) < feedTime + feedMs
            reached = isHigh ? barHighs.get(index) >= price : barLows.get(index) <= price
            if barTimes.get(index) >= feedTime and reached
                result := barTimes.get(index)
                break
            index += 1
    result

var levelBoxes = map.new<string, box>()
var levelCaptions = map.new<string, string>()

// A zero-height box is the level line; its caption sits inside it, glued above a high or below a low and
// ending where the line ends. Levels at the same price ending on the same candle share one caption.
levelBox(int x1, int x2, float price, string caption, color tint, bool isHigh) =>
    key = str.tostring(x2) + '|' + str.tostring(price) + '|' + str.tostring(isHigh)
    existing = levelBoxes.get(key)
    merged = na(existing) ? caption : levelCaptions.get(key) + ' / ' + caption
    levelCaptions.put(key, merged)
    if not na(existing)
        existing.set_text(merged)
    drawn = box.new(x1, price, x2, price, xloc = xloc.bar_time, border_color = tint, bgcolor = color(na), text = na(existing) ? caption : '', text_color = tint, text_size = size.small, text_halign = text.align_right, text_valign = isHigh ? text.align_bottom : text.align_top)
    if na(existing)
        levelBoxes.put(key, drawn)
    drawn

// A level from the candle that made it; it stops at the touch, or runs to the last candle while untouched.
drawLevel(float price, int feedFromTime, int feedTouchedTime, int feedMs, bool isHigh, string caption, color tint) =>
    x1 = math.max(exactTime(feedFromTime, feedMs, price, isHigh), firstBarTime)
    touchedTime = exactTime(feedTouchedTime, feedMs, price, isHigh)
    if na(touchedTime)
        levelBox(x1, math.max(time, x1 + MS_PER_MINUTE), price, caption, tint, isHigh)
    else if touchedTime > x1
        levelBox(x1, touchedTime, price, caption, tint, isHigh)

// The latest finished period is the previous one (PDH, PWH, PMH, MonH); older ones carry their date.
drawRanges(array<Range> ranges, int feedMs, string latestPrefix, string olderPrefix, string dateFormat, color tint) =>
    latest = ranges.size() > 0 and ranges.last().finished ? ranges.last() : ranges.size() > 1 ? ranges.get(ranges.size() - 2) : na
    for levelRange in ranges
        if levelRange.finished
            isLatest = levelRange.tradingDay == latest.tradingDay
            highCaption = isLatest ? latestPrefix + 'H' : olderPrefix + 'H ' + str.format_time(levelRange.tradingDay, dateFormat, 'UTC')
            lowCaption = isLatest ? latestPrefix + 'L' : olderPrefix + 'L ' + str.format_time(levelRange.tradingDay, dateFormat, 'UTC')
            drawLevel(levelRange.hi, levelRange.hiTime, levelRange.hiTouched, feedMs, true, highCaption, tint)
            drawLevel(levelRange.lo, levelRange.loTime, levelRange.loTouched, feedMs, false, lowCaption, tint)

drawZones(array<Zone> zones, string name, color tint) =>
    for zone in zones
        boxEnd = zone.lastTime + dayFeedMs
        if showBoxes and boxEnd > firstBarTime
            box.new(math.max(zone.startTime, firstBarTime), zone.hi, boxEnd, zone.lo, xloc = xloc.bar_time, border_color = color.new(tint, 60), bgcolor = color.new(tint, boxTransparency))
        drawLevel(zone.hi, zone.hiTime, zone.hiTouched, dayFeedMs, true, name + ' High', tint)
        drawLevel(zone.lo, zone.loTime, zone.loTouched, dayFeedMs, false, name + ' Low', tint)

if barstate.islast and not na(days)
    for drawn in box.all
        drawn.delete()
    levelBoxes.clear()
    levelCaptions.clear()
    if monthOn
        drawRanges(months, hourFeedMs, 'PM', 'M', 'MMM', monthColor)
    if weekOn
        drawRanges(weeks, hourFeedMs, 'PW', 'W', 'dd/MM', weekColor)
    if mondayOn
        drawRanges(mondays, hourFeedMs, 'Mon', 'Mon', 'dd/MM', mondayColor)
    if dayOn
        drawRanges(days, dayFeedMs, 'PD', 'D', 'dd/MM', dayColor)
    if win1On
        drawZones(zones1, win1Name, win1Color)
    if win2On
        drawZones(zones2, win2Name, win2Color)
    if win3On
        drawZones(zones3, win3Name, win3Color)
    if win4On
        drawZones(zones4, win4Name, win4Color)
    if win5On
        drawZones(zones5, win5Name, win5Color)
