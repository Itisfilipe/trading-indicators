//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Filipe Teixeira Amaral
// -----------------------------------------------------------------------------
// ORM Liquidity
// Author: Filipe Teixeira Amaral
// Version: 1.0
//
// Description:
// The highs and lows of past days, weeks and months, and of Monday, drawn as
// liquidity for the Open Reaction Model on NQ: each line starts at the candle
// that made the extreme and stops at the first later candle to touch or trade
// through it. A line nobody has touched yet runs to the right edge.
//
// Features:
// - Previous days (PDH/PDL): the 1D candle of the futures session, 18:00 to
//   17:00 New York, which is the daily chart without settlement
// - Previous weeks (PWH/PWL) and months (PMH/PML), as the weekly and monthly
//   candles cut them
// - Monday (MonH/MonL), the week's reference range
// - Only finished periods are drawn; the one in progress is not liquidity yet
// - One history setting: how many past periods of each kind stay on the chart
//
// Notes:
// - Days are computed on a 5-minute feed (setting) and weeks, months and
//   Mondays on an hourly feed, not on the chart's candles, so a 1-minute chart
//   still shows every level of the history even where its own candles do not
//   reach. Prices are exact; where a line starts and stops is placed at the
//   feed candle that holds the event.
// -----------------------------------------------------------------------------

indicator('ORMLiquidity', 'ORM Liq', overlay = true, max_lines_count = 500, max_labels_count = 500)

MS_PER_MINUTE = 60000

//==============================================================================
// INPUTS
//==============================================================================
GRP_GENERAL = 'General'
GRP_LEVELS = 'Levels'

history = input.int(5, 'Periods of history', minval = 1, maxval = 30, tooltip = 'Past periods of each kind (days, weeks, months, Mondays) kept on the chart.', group = GRP_GENERAL)
calcTf = input.timeframe('5', 'Daily calculation timeframe', options = ['1', '5', '15'], tooltip = 'Feed the daily levels are computed on. Weeks, months and Mondays always use an hourly feed.', group = GRP_GENERAL)
lineWidth = input.int(1, 'Line width', minval = 1, maxval = 4, group = GRP_GENERAL)
labelSizeInput = input.string('small', 'Label size', options = ['tiny', 'small', 'normal', 'large'], group = GRP_GENERAL)

dayOn = input.bool(true, 'Day', inline = 'd', group = GRP_LEVELS)
dayColor = input.color(#455a64, '', inline = 'd', group = GRP_LEVELS)
weekOn = input.bool(true, 'Week', inline = 'w', group = GRP_LEVELS)
weekColor = input.color(#089981, '', inline = 'w', group = GRP_LEVELS)
monthOn = input.bool(true, 'Month', inline = 'm', group = GRP_LEVELS)
monthColor = input.color(#f23645, '', inline = 'm', group = GRP_LEVELS)
mondayOn = input.bool(true, 'Monday', inline = 'mon', group = GRP_LEVELS)
mondayColor = input.color(#795548, '', inline = 'mon', group = GRP_LEVELS)

//==============================================================================
// TYPES AND TRACKER
//==============================================================================
type Range
    float hi
    int hiTime
    int hiTouched
    float lo
    int loTime
    int loTouched
    bool finished

// Runs on a feed through request.security. A period opens when the feed's
// period candle changes; with mondayOnly, only the trading day of Monday
// (Sunday 18:00 to Monday 17:00) is kept.
trackPeriod(string period, bool mondayOnly, int keep) =>
    var ranges = array.new<Range>()
    if timeframe.change(period) and not barstate.isfirst
        if ranges.size() > 0
            previous = ranges.last()
            previous.finished := true
        if not mondayOnly or dayofweek(time_tradingday, 'UTC') == dayofweek.monday
            ranges.push(Range.new(high, time, na, low, time, na, false))
    else if ranges.size() > 0 and not ranges.last().finished
        current = ranges.last()
        if high > current.hi
            current.hi := high
            current.hiTime := time
        if low < current.lo
            current.lo := low
            current.loTime := time
    keepNow = ranges.size() > 0 and not ranges.last().finished ? keep + 1 : keep
    while ranges.size() > keepNow
        ranges.shift()
    for levelRange in ranges
        if levelRange.finished
            if na(levelRange.hiTouched) and high >= levelRange.hi
                levelRange.hiTouched := time
            if na(levelRange.loTouched) and low <= levelRange.lo
                levelRange.loTouched := time
    barstate.islast ? ranges : na

//==============================================================================
// DATA
//==============================================================================
feed = ticker.modify(syminfo.tickerid, session.extended)

days = request.security(feed, calcTf, trackPeriod('D', false, history), lookahead = barmerge.lookahead_on)
weeks = request.security(feed, '60', trackPeriod('W', false, history), lookahead = barmerge.lookahead_on)
months = request.security(feed, '60', trackPeriod('M', false, history), lookahead = barmerge.lookahead_on)
mondays = request.security(feed, '60', trackPeriod('D', true, history), lookahead = barmerge.lookahead_on)

//==============================================================================
// DRAWING
//==============================================================================
var int firstBarTime = time
labelOffsetMs = 3 * timeframe.in_seconds() * 1000
textSize = switch labelSizeInput
    'tiny' => size.tiny
    'normal' => size.normal
    'large' => size.large
    => size.small

// A level from fromTime; it stops at touchedTime, or runs to the right edge while untouched.
drawLevel(float price, int fromTime, int touchedTime, string caption, color tint) =>
    x1 = math.max(fromTime, firstBarTime)
    if na(touchedTime)
        line.new(x1, price, x1 + MS_PER_MINUTE, price, xloc = xloc.bar_time, extend = extend.right, color = tint, width = lineWidth)
        label.new(time + labelOffsetMs, price, caption, xloc = xloc.bar_time, style = label.style_label_left, color = color(na), textcolor = tint, size = textSize)
    else if touchedTime > x1
        line.new(x1, price, touchedTime, price, xloc = xloc.bar_time, color = tint, width = lineWidth)
        label.new(touchedTime, price, caption, xloc = xloc.bar_time, style = label.style_label_left, color = color(na), textcolor = tint, size = textSize)

drawRanges(array<Range> ranges, string prefix, color tint) =>
    for levelRange in ranges
        if levelRange.finished
            drawLevel(levelRange.hi, levelRange.hiTime, levelRange.hiTouched, prefix + 'H', tint)
            drawLevel(levelRange.lo, levelRange.loTime, levelRange.loTouched, prefix + 'L', tint)

if barstate.islast and not na(days)
    for drawn in line.all
        drawn.delete()
    for drawn in label.all
        drawn.delete()

    if monthOn
        drawRanges(months, 'PM', monthColor)
    if weekOn
        drawRanges(weeks, 'PW', weekColor)
    if mondayOn
        drawRanges(mondays, 'Mon', mondayColor)
    if dayOn
        drawRanges(days, 'PD', dayColor)
