//==============================================================================
// TYPES
//==============================================================================
// A macro is a span, so it is kept as one: the two clock times its lines are
// drawn at, whether the end belongs to the next day (23:50 - 00:10 wraps),
// and the caption the rectangle between them carries. Both ends stay as
// clock fields rather than a duration so each day rebuilds them against its
// own calendar -- a window crossing a daylight-saving switch still ends at
// the time on its row, not that many elapsed minutes later.
type MacroSpan
    int start_hour
    int start_minute
    int end_hour
    int end_minute
    bool wraps
    string caption

//==============================================================================
// HELPERS
//==============================================================================
pad_two(int value) =>
    (value < 10 ? '0' : '') + str.tostring(value)

clock_text(int minutes_of_day) =>
    pad_two(int(minutes_of_day / 60)) + ':' + pad_two(minutes_of_day % 60)

// mm:ss while under an hour, then Hh MMm -- the seconds stop being useful once
// the window is that far out.
countdown_text(int milliseconds) =>
    total_seconds = int(math.max(0, milliseconds) / 1000)
    hours = int(total_seconds / 3600)
    minutes = int(total_seconds % 3600 / 60)
    seconds = total_seconds % 60
    hours > 0 ? str.tostring(hours) + 'h ' + pad_two(minutes) + 'm' : pad_two(minutes) + ':' + pad_two(seconds)

midnight_of(int reference_time) =>
    timestamp(tz, year(reference_time, tz), month(reference_time, tz), dayofmonth(reference_time, tz), 0, 0)

// Steps a whole number of days from one midnight to another. Adding 24 hours to
// a midnight lands at 23:00 or 01:00 across a daylight-saving switch -- once on
// the wrong date entirely -- so the step goes via the target day's noon, which
// no switch can push out of its own day, and midnight_of reduces it back.
shift_days(int day_midnight, int day_count) =>
    midnight_of(day_midnight + day_count * MS_PER_DAY + HALF_DAY_MS)

// Reads HH:MM into minutes since midnight, or -1 when the entry is not a time.
// Guarding here rather than indexing blindly keeps a typo in one slot from
// taking the whole indicator down.
parse_clock_minutes(string time_text) =>
    int minutes_since_midnight = -1
    parts = str.split(str.replace_all(time_text, ' ', ''), ':')
    if array.size(parts) == 2
        hour_value = str.tonumber(array.get(parts, 0))
        minute_value = str.tonumber(array.get(parts, 1))
        both_numeric = not na(hour_value) and not na(minute_value)
        whole_numbers = hour_value == math.floor(hour_value) and minute_value == math.floor(minute_value)
        in_clock_range = hour_value >= 0 and hour_value <= 23 and minute_value >= 0 and minute_value <= 59
        if both_numeric and whole_numbers and in_clock_range
            minutes_since_midnight := int(hour_value) * 60 + int(minute_value)
    minutes_since_midnight

line_style_constant(string name) =>
    switch name
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

caption_size_constant() =>
    switch caption_size
        'tiny' => size.tiny
        'small' => size.small
        'large' => size.large
        => size.normal

//==============================================================================
// THE WINDOWS TO DRAW
//==============================================================================
var array<MacroSpan> macro_spans = array.new<MacroSpan>()

add_macro(bool enabled, string start_text, string end_text, string label_text) =>
    if enabled
        start_minutes = parse_clock_minutes(start_text)
        end_minutes = parse_clock_minutes(end_text)
        if start_minutes < 0 or end_minutes < 0
            log.warning('ICT Macros: skipping window "{0}" to "{1}", expected times as HH:MM', start_text, end_text)
        else if end_minutes == start_minutes
            log.warning('ICT Macros: skipping window "{0}" to "{1}", a window cannot end the minute it starts', start_text, end_text)
        else
            // An end at or before the start rolls into the next day, which is
            // what lets the 23:50 window close at 00:10.
            wraps = end_minutes < start_minutes
            trimmed_label = str.trim(label_text)
            default_caption = 'Macro ' + clock_text(start_minutes) + '-' + clock_text(end_minutes)
            caption = trimmed_label != '' ? trimmed_label : default_caption
            array.push(macro_spans, MacroSpan.new(int(start_minutes / 60), start_minutes % 60, int(end_minutes / 60), end_minutes % 60, wraps, caption))

if barstate.isfirst
    add_macro(macro1_on, macro1_start, macro1_end, macro1_label)
    add_macro(macro2_on, macro2_start, macro2_end, macro2_label)
    add_macro(macro3_on, macro3_start, macro3_end, macro3_label)
    add_macro(macro4_on, macro4_start, macro4_end, macro4_label)
    add_macro(macro5_on, macro5_start, macro5_end, macro5_label)
    add_macro(macro6_on, macro6_start, macro6_end, macro6_label)
    add_macro(macro7_on, macro7_start, macro7_end, macro7_label)
    add_macro(macro8_on, macro8_start, macro8_end, macro8_label)
    add_macro(macro9_on, macro9_start, macro9_end, macro9_label)
    add_macro(macro10_on, macro10_start, macro10_end, macro10_label)
    add_macro(macro11_on, macro11_start, macro11_end, macro11_label)
    add_macro(macro12_on, macro12_start, macro12_end, macro12_label)
    add_macro(macro13_on, macro13_start, macro13_end, macro13_label)
    add_macro(macro14_on, macro14_start, macro14_end, macro14_label)
    add_macro(macro15_on, macro15_start, macro15_end, macro15_label)
    add_macro(macro16_on, macro16_start, macro16_end, macro16_label)
    add_macro(macro17_on, macro17_start, macro17_end, macro17_label)
    add_macro(macro18_on, macro18_start, macro18_end, macro18_label)
    add_macro(macro19_on, macro19_start, macro19_end, macro19_label)
    add_macro(macro20_on, macro20_start, macro20_end, macro20_label)
    add_macro(macro21_on, macro21_start, macro21_end, macro21_label)
    add_macro(macro22_on, macro22_start, macro22_end, macro22_label)
    add_macro(macro23_on, macro23_start, macro23_end, macro23_label)
    add_macro(macro24_on, macro24_start, macro24_end, macro24_label)

//==============================================================================
// THE DAYS TO DRAW THEM ON
//==============================================================================
// Days are logged as the bars pass through them rather than counted back from
// today, so a weekend or a holiday never collects a set of windows nothing
// traded under. Today is added at draw time whether or not it has bars yet.
var array<int> trading_days = array.new<int>()

bar_midnight = midnight_of(time)
if array.size(trading_days) == 0 or array.last(trading_days) != bar_midnight
    array.push(trading_days, bar_midnight)
    if array.size(trading_days) > MAX_TRACKED_DAYS
        array.shift(trading_days)

//==============================================================================
// VISIBLE PRICE RANGE
//==============================================================================
// A bracket line needs two prices to be born, and the strip rides the edge of
// the screen, so both want the price range the screen is actually showing.
// Reading chart.left_visible_bar_time and chart.right_visible_bar_time is also
// what makes TradingView re-run the script on a scroll or a zoom, which is what
// keeps the strip welded to that edge.
var float visible_high = na
var float visible_low = na

bar_is_visible = not na(chart.left_visible_bar_time) and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
if bar_is_visible
    visible_high := na(visible_high) ? high : math.max(visible_high, high)
    visible_low := na(visible_low) ? low : math.min(visible_low, low)

// Stand-in for the visible range until the chart reports one: the last stretch
// of bars is a fair likeness of what is on screen. Computed on every bar because
// ta.* only sees the bars it runs on, so these cannot move inside the last-bar
// block that uses them. The span is capped at the bars that exist, because
// ta.highest over a longer window than the chart holds yields na.
fallback_span = math.min(FALLBACK_LOOKBACK, bar_index + 1)
fallback_high = ta.highest(high, fallback_span)
fallback_low = ta.lowest(low, fallback_span)

//==============================================================================
// DRAWING
//==============================================================================
// Everything is redrawn on each last-bar pass: the strip has to follow the
// visible range, and the countdowns have to stay current. Lines and bands are
// anchored to real timestamps through xloc.bar_time, which is what lets one
// sit past the last bar -- a bar index cannot address a bar that does not
// exist yet, a timestamp can.
var array<line> drawn_lines = array.new<line>()
var array<box> drawn_boxes = array.new<box>()

if barstate.islast
    for existing_line in drawn_lines
        line.delete(existing_line)
    for existing_box in drawn_boxes
        box.delete(existing_box)
    array.clear(drawn_lines)
    array.clear(drawn_boxes)

    screen_high = na(visible_high) ? fallback_high : visible_high
    screen_low = na(visible_low) ? fallback_low : visible_low

    // The two kinds of drawing want opposite things from the price scale. A
    // bracket line takes its endpoints from inside the visible range and
    // reaches the rest of the way with extend.both, so it fills the height
    // without asking the chart for room. The bands do the reverse: they sit
    // past the highest or lowest bar on purpose, and the chart gives up that
    // much scale to hold them. That is the price of keeping them off the
    // candles rather than over them.
    price_range = screen_high - screen_low
    edge_gap = price_range * edge_gap_percent / 100
    band_height = price_range * band_height_percent / 100
    at_top = strip_position == 'Top'

    // The strip is laid out from the bars outward: clear space first, then
    // the band. Starting the band at the bar extreme instead put its edge
    // exactly on the lowest low, so any bar that made the low sat on top of
    // it.
    band_inner = at_top ? screen_high + edge_gap : screen_low - edge_gap
    band_outer = at_top ? band_inner + band_height : band_inner - band_height
    band_top = at_top ? band_outer : band_inner
    band_bottom = at_top ? band_inner : band_outer

    today_midnight = midnight_of(timenow)

    // History counts back from the newest day the chart has bars for, not from
    // today. Counting from today would, over a weekend or a holiday, push the
    // last day that actually traded out of the window and leave the bars on
    // screen carrying no windows at all.
    cutoff = shift_days(array.last(trading_days), -history_days)

    // With zero history days, a midnight-crossing window still open in the
    // first minutes of today is cut off with its day. Accepted: the wrap
    // slots start off, and one history day -- the default -- keeps the
    // window on screen through its end.
    days_to_draw = array.new<int>()
    for tracked_day in trading_days
        if tracked_day >= cutoff and tracked_day < today_midnight
            array.push(days_to_draw, tracked_day)

    // Today and tomorrow go in whether or not they have bars yet. Their
    // windows are the ones still ahead, which is the whole point of drawing
    // them; the bars-only rule is what keeps a past weekend from collecting a
    // set.
    array.push(days_to_draw, today_midnight)
    if include_tomorrow
        array.push(days_to_draw, shift_days(today_midnight, 1))

    macro_line_style = line_style_constant(macro_style)
    caption_text_size = caption_size_constant()

    for day_start in days_to_draw
        day_year = year(day_start, tz)
        day_month = month(day_start, tz)
        day_of_month = dayofmonth(day_start, tz)
        for span in macro_spans
            span_start = timestamp(tz, day_year, day_month, day_of_month, span.start_hour, span.start_minute)
            end_day = span.wraps ? shift_days(day_start, 1) : day_start
            span_end = timestamp(tz, year(end_day, tz), month(end_day, tz), dayofmonth(end_day, tz), span.end_hour, span.end_minute)

            // A window gets a line at each edge: it is a span, and one line
            // can only say when it opens. Neither line is captioned -- the
            // rectangle between them carries the name, which is what makes
            // the pair read as one window instead of two loose lines.
            if show_bracket_lines
                array.push(drawn_lines, line.new(span_start, screen_low, span_start, screen_high, xloc = xloc.bar_time, extend = extend.both, color = macro_color, style = macro_line_style, width = line_width))
                array.push(drawn_lines, line.new(span_end, screen_low, span_end, screen_high, xloc = xloc.bar_time, extend = extend.both, color = macro_color, style = macro_line_style, width = line_width))

            // One caption for the whole window, and it changes tense with it:
            // counting down to the open while the window is ahead, counting
            // out what is left of it once inside. The countdown gets its own
            // line so the window's name stays put and only the ticking part
            // changes underneath it.
            caption = span.caption
            if show_countdown
                if timenow < span_start
                    caption := caption + '\nin ' + countdown_text(span_start - timenow)
                else if timenow < span_end
                    caption := caption + '\n' + countdown_text(span_end - timenow) + ' left'

            if band_height_percent > 0
                array.push(drawn_boxes, box.new(span_start, band_top, span_end, band_bottom, xloc = xloc.bar_time, border_color = macro_color, border_width = line_width, border_style = macro_line_style, bgcolor = color.new(macro_color, band_transp), text = show_captions ? caption : '', text_color = macro_color, text_halign = text.align_center, text_valign = text.align_center, text_size = caption_text_size))
