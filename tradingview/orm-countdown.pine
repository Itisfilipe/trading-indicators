// -----------------------------------------------------------------------------
// ORM Countdown
// Author: Filipe Teixeira Amaral
// Version: 1.0
//
// Description:
// One row of large numbers in the chart's top-right corner: the time left in
// the candle (red in its last seconds), the lot size for a fixed dollar risk
// with a stop of N x ATR, and the current ATR (EMA). Each can be switched off.
//
// Notes:
// - The panel refreshes on each tick, so a quiet market can skip seconds.
// - Lot size uses syminfo.pointvalue; confirm it against your broker's
//   contract specs before trading.
// -----------------------------------------------------------------------------

indicator('ORMCountdown', 'ORM Countdown', overlay = true)

showCountdown = input.bool(true, 'Countdown', inline = 'parts')
showLot = input.bool(true, 'Lot', inline = 'parts')
showAtr = input.bool(true, 'ATR', inline = 'parts')
panelTextSize = input.string(size.large, 'Text size', options = [size.tiny, size.small, size.normal, size.large, size.huge])
panelColor = input.color(color.new(#374151, 10), 'Background', inline = 'colors')
textColor = input.color(color.white, 'Text', inline = 'colors')
alertSeconds = input.int(5, 'Red in the last (s)', minval = 0, maxval = 60, inline = 'alert')
alertColor = input.color(#f23645, '', inline = 'alert')
riskDollars = input.float(100.0, 'Risk per trade ($)', minval = 0.0, step = 10.0)
stopAtrMult = input.float(1.5, 'Stop size (x ATR)', minval = 0.1, step = 0.1)
atrLength = input.int(5, 'ATR length', minval = 1)

atrValue = ta.ema(ta.tr(true), atrLength)
stopDistance = math.max(1, math.round(stopAtrMult * atrValue / syminfo.mintick)) * syminfo.mintick
lotSize = math.floor(riskDollars / (stopDistance * syminfo.pointvalue))

countdownText(int seconds) =>
    seconds >= 3600 ? str.format('{0}:{1,number,00}:{2,number,00}', int(seconds / 3600), int(seconds % 3600 / 60), seconds % 60) : str.format('{0}:{1,number,00}', int(seconds / 60), seconds % 60)

var panel = table.new(position.top_right, 3, 1, bgcolor = panelColor, border_width = 1, border_color = color.new(textColor, 70))

addCell(int column, string value, color background) =>
    table.cell(panel, column, 0, value, text_color = textColor, text_size = panelTextSize, bgcolor = background)

if barstate.islast
    panel.clear(0, 0, 2, 0)
    int column = 0
    if showCountdown and timeframe.isintraday
        secondsLeft = int(math.max(0, time_close - timenow) / 1000)
        addCell(column, countdownText(secondsLeft), barstate.isrealtime and secondsLeft <= alertSeconds ? alertColor : panelColor)
        column += 1
    if showLot
        addCell(column, na(lotSize) ? '-' : str.tostring(lotSize), panelColor)
        column += 1
    if showAtr
        addCell(column, str.tostring(atrValue, format.mintick), panelColor)
