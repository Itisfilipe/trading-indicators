//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Filipe Teixeira Amaral
// -----------------------------------------------------------------------------
// ORM Countdown
// Author: Filipe Teixeira Amaral
// Version: 1.0
//
// Description:
// One row of large numbers in the chart's top-right corner, no captions:
// the time left in the candle, the position size and the current ATR, in that
// order. The countdown turns red in the candle's last seconds (default 5).
// Each can be switched off, and the corner can be changed.
//
// Features:
// - Countdown as m:ss, h:mm:ss past an hour (intraday charts only)
// - Lot: the largest whole contract count that keeps the loss within the
//   risk budget if a stop of N x ATR is hit, from the symbol's point value
// - Risk as a fixed dollar amount or a percent of the account
// - ATR with EMA or Wilder (RMA) smoothing
//
// Notes:
// - The panel refreshes on each tick, so a quiet market can skip seconds.
// - Lot size uses syminfo.pointvalue; confirm it against your broker's
//   contract specs before trading.
// -----------------------------------------------------------------------------

indicator('ORMCountdown', 'ORM Countdown', overlay = true)

//==============================================================================
// INPUTS
//==============================================================================
GRP_PANEL = 'Panel'
GRP_SIZING = 'Position sizing'

showCountdown = input.bool(true, 'Countdown', inline = 'parts', group = GRP_PANEL)
showLot = input.bool(true, 'Lot', inline = 'parts', group = GRP_PANEL)
showAtr = input.bool(true, 'ATR', inline = 'parts', group = GRP_PANEL)
panelColor = input.color(color.new(#374151, 10), 'Background', inline = 'colors', group = GRP_PANEL)
textColor = input.color(color.white, 'Text', inline = 'colors', group = GRP_PANEL)
labelSizeInput = input.string('large', 'Text size', options = ['small', 'normal', 'large', 'huge'], group = GRP_PANEL)
alertSeconds = input.int(5, 'Red countdown in the last (s)', minval = 0, maxval = 60, inline = 'alert', group = GRP_PANEL)
alertColor = input.color(#f23645, '', inline = 'alert', group = GRP_PANEL)
cornerInput = input.string('Top right', 'Position', options = ['Top right', 'Top left', 'Bottom right', 'Bottom left'], group = GRP_PANEL)

riskMode = input.string('Fixed $', 'Risk mode', options = ['Fixed $', '% of Account'], group = GRP_SIZING)
riskDollars = input.float(100.0, 'Risk per trade ($)', minval = 0.0, step = 10.0, tooltip = 'Used when Risk mode is Fixed $.', group = GRP_SIZING)
accountSize = input.float(10000.0, 'Account size ($)', minval = 0.0, step = 100.0, tooltip = 'Used when Risk mode is % of Account.', group = GRP_SIZING)
riskPercent = input.float(1.0, 'Risk per trade (%)', minval = 0.0, step = 0.1, tooltip = 'Used when Risk mode is % of Account.', group = GRP_SIZING)
stopAtrMult = input.float(1.5, 'Stop size (x ATR)', minval = 0.1, step = 0.1, group = GRP_SIZING)
atrLength = input.int(5, 'ATR length', minval = 1, group = GRP_SIZING)
atrType = input.string('EMA (Exponential)', 'ATR smoothing', options = ['RMA (Wilder)', 'EMA (Exponential)'], group = GRP_SIZING)

//==============================================================================
// CALCULATION
//==============================================================================
trueRange = ta.tr(true)
atrValue = atrType == 'EMA (Exponential)' ? ta.ema(trueRange, atrLength) : ta.rma(trueRange, atrLength)
riskAmount = riskMode == 'Fixed $' ? riskDollars : accountSize * riskPercent / 100.0
stopDistance = atrValue > 0 ? math.max(1, math.round(stopAtrMult * atrValue / syminfo.mintick)) * syminfo.mintick : 0
riskPerLot = stopDistance * syminfo.pointvalue
lotSize = riskPerLot > 0 ? math.floor(riskAmount / riskPerLot) : na

countdownText(int seconds) =>
    seconds >= 3600 ? str.format('{0}:{1,number,00}:{2,number,00}', int(seconds / 3600), int(seconds % 3600 / 60), seconds % 60) : str.format('{0}:{1,number,00}', int(seconds / 60), seconds % 60)

//==============================================================================
// DRAWING
//==============================================================================
corner = switch cornerInput
    'Top left' => position.top_left
    'Bottom right' => position.bottom_right
    'Bottom left' => position.bottom_left
    => position.top_right
textSize = switch labelSizeInput
    'small' => size.small
    'normal' => size.normal
    'huge' => size.huge
    => size.large

var panel = table.new(corner, 3, 1, bgcolor = panelColor, border_width = 1, border_color = color.new(textColor, 70))

addCell(int column, string value, color background) =>
    table.cell(panel, column, 0, value, text_color = textColor, text_size = textSize, bgcolor = background)

if barstate.islast
    panel.clear(0, 0, 2, 0)
    int column = 0
    if showCountdown and timeframe.isintraday
        secondsLeft = int(math.max(0, time_close - timenow) / 1000)
        addCell(column, countdownText(secondsLeft), secondsLeft <= alertSeconds ? alertColor : panelColor)
        column += 1
    if showLot
        addCell(column, na(lotSize) ? '-' : str.tostring(lotSize), panelColor)
        column += 1
    if showAtr
        addCell(column, str.tostring(atrValue, format.mintick), panelColor)
