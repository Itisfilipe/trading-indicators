// LRM Macros: New York clock windows for NQ/MNQ.
indicator('LRMMacros', 'LRM Macros', overlay = true, max_lines_count = 500, max_boxes_count = 500)

TZ = 'America/New_York'
HALF_DAY_MS = 43200000
SIX_HOURS_MS = 21600000
FALLBACK_LOOKBACK = 100

history = input.int(1, 'Past trading days', minval = 0, maxval = 20)
showLines = input.bool(false, 'Show window edge lines')
showCountdown = input.bool(false, 'Show countdown')
bandPosition = input.string('Top', 'Band position', options = ['Top', 'Bottom'])

asiaOn = input.bool(false, 'Asia', inline = 'asia')
asiaTime = input.session('1950-2010', '', inline = 'asia')
asiaColor = input.color(#2962ff, '', inline = 'asia')
londonOn = input.bool(false, 'London', inline = 'london')
londonTime = input.session('0250-0310', '', inline = 'london')
londonColor = input.color(#9c27b0, '', inline = 'london')
preOn = input.bool(false, 'Pre-market', inline = 'pre')
preTime = input.session('0650-0710', '', inline = 'pre')
preColor = input.color(#ff9800, '', inline = 'pre')
amOn = input.bool(false, 'NY AM', inline = 'am')
amTime = input.session('0950-1010', '', inline = 'am')
amColor = input.color(#089981, '', inline = 'am')
finalOn = input.bool(false, 'Final Hour', inline = 'final')
finalTime = input.session('1515-1545', '', inline = 'final')
finalColor = input.color(#f23645, '', inline = 'final')
mocOn = input.bool(true, 'MOC', inline = 'moc')
mocTime = input.session('1545-1600', '', inline = 'moc')
mocColor = input.color(#f23645, '', inline = 'moc')
markImbalance = input.bool(true, 'Mark 15:50 inside MOC', tooltip = 'Draw a dotted line at 15:50 New York time when the MOC window includes it.')

type Window
    int startMinute
    int endMinute
    string caption
    color tint
    bool isMoc

pad2(int value) =>
    (value < 10 ? '0' : '') + str.tostring(value)

// mm:ss under an hour, then Hh MMm.
countdownText(int milliseconds) =>
    totalSeconds = int(math.max(0, milliseconds) / 1000)
    hours = int(totalSeconds / 3600)
    minutes = int(totalSeconds % 3600 / 60)
    hours > 0 ? str.tostring(hours) + 'h ' + pad2(minutes) + 'm' : pad2(minutes) + ':' + pad2(totalSeconds % 60)

midnightOf(int t) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0)

// Midnight of the futures trading day holding t: from 18:00 the session belongs to the next date.
tradingDateOf(int t) =>
    midnightOf(t + SIX_HOURS_MS)

// Evening times (18:00 and later) of a trading day fall on the calendar day before it.
eventTimeOf(int tradingDate, int clockMinute) =>
    calendarDay = clockMinute >= 18 * 60 ? midnightOf(tradingDate - HALF_DAY_MS) : tradingDate
    timestamp(TZ, year(calendarDay, TZ), month(calendarDay, TZ), dayofmonth(calendarDay, TZ), int(clockMinute / 60), clockMinute % 60)

var windows = array.new<Window>()

clockMinute(string span, int offset) =>
    int(str.tonumber(str.substring(span, offset, offset + 2))) * 60 + int(str.tonumber(str.substring(span, offset + 2, offset + 4)))

addWindow(bool enabled, string span, string caption, color tint, bool isMoc) =>
    if enabled
        windows.push(Window.new(clockMinute(span, 0), clockMinute(span, 5), caption, tint, isMoc))

if barstate.isfirst
    addWindow(asiaOn, asiaTime, 'Asia', asiaColor, false)
    addWindow(londonOn, londonTime, 'London', londonColor, false)
    addWindow(preOn, preTime, 'Pre-market', preColor, false)
    addWindow(amOn, amTime, 'NY AM', amColor, false)
    addWindow(finalOn, finalTime, 'Final Hour', finalColor, false)
    addWindow(mocOn, mocTime, 'MOC', mocColor, true)

var tradingDays = array.new<int>()
barTradingDate = tradingDateOf(time)
if tradingDays.size() == 0 or tradingDays.last() != barTradingDate
    tradingDays.push(barTradingDate)
    if tradingDays.size() > 21
        tradingDays.shift()

// Reading the visible bar times also makes TradingView re-run the script on scroll and zoom.
var float visibleHigh = na
var float visibleLow = na
if not na(chart.left_visible_bar_time) and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    visibleHigh := na(visibleHigh) ? high : math.max(visibleHigh, high)
    visibleLow := na(visibleLow) ? low : math.min(visibleLow, low)

fallbackSpan = math.min(FALLBACK_LOOKBACK, bar_index + 1)
fallbackHigh = ta.highest(high, fallbackSpan)
fallbackLow = ta.lowest(low, fallbackSpan)

if barstate.islast
    for drawn in line.all
        drawn.delete()
    for drawn in box.all
        drawn.delete()

    screenHigh = nz(visibleHigh, fallbackHigh)
    screenLow = nz(visibleLow, fallbackLow)
    height = math.max(screenHigh - screenLow, syminfo.mintick) * 0.035
    bandTop = bandPosition == 'Top' ? screenHigh + 2 * height : screenLow - height
    bandBottom = bandTop - height
    firstDay = math.max(0, tradingDays.size() - history - 1)

    for i = firstDay to tradingDays.size() - 1
        date = tradingDays.get(i)
        for win in windows
            start = eventTimeOf(date, win.startMinute)
            endDay = dayofmonth(start, TZ) + (win.endMinute <= win.startMinute ? 1 : 0)
            finish = timestamp(TZ, year(start, TZ), month(start, TZ), endDay, int(win.endMinute / 60), win.endMinute % 60)
            caption = win.caption
            if showCountdown and barstate.isrealtime and timenow < finish
                caption += '\n' + countdownText(timenow < start ? start - timenow : finish - timenow)
            box.new(start, bandTop, finish, bandBottom, xloc = xloc.bar_time, border_color = win.tint, bgcolor = color.new(win.tint, 90), text = caption, text_color = win.tint, text_size = size.small)
            if showLines
                line.new(start, bandBottom, start, bandTop, xloc = xloc.bar_time, extend = extend.both, color = win.tint, style = line.style_dotted)
                line.new(finish, bandBottom, finish, bandTop, xloc = xloc.bar_time, extend = extend.both, color = win.tint, style = line.style_dotted)
            if win.isMoc and markImbalance
                imbalance = eventTimeOf(date, 15 * 60 + 50)
                if imbalance >= start and imbalance < finish and not (showLines and imbalance == start)
                    line.new(imbalance, bandBottom, imbalance, bandTop, xloc = xloc.bar_time, extend = extend.both, color = win.tint, style = line.style_dotted)
