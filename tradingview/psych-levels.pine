//@version=6
indicator("Psych Levels", overlay = true, max_lines_count = 500, max_boxes_count = 500)

// Settings groups
const string GROUP_LEVELS = "Level Calculation"
const string GROUP_REGULAR = "Regular Levels"
const string GROUP_HIGHLIGHT = "Highlighted Levels"
const string GROUP_MAJOR = "Major Levels"
const string GROUP_DISPLAY = "Display"
const string GROUP_LABELS = "Price Labels"

// Level calculation
stepSize = input.float(
    50.0,
    "Step size",
    minval = 0.00000001,
    step = 0.01,
    group = GROUP_LEVELS
)
offsetLevels = input.int(
     2,
     "Offset (extra levels above/below)",
     minval = 0,
     maxval = 250,
     group = GROUP_LEVELS
)

// Regular level style
styleInput = input.string(
    "Dashed",
    "Line style",
    options = ["Solid", "Dashed", "Dotted"],
    group = GROUP_REGULAR
)
lineWidth = input.int(1, "Line width", minval = 1, maxval = 5, group = GROUP_REGULAR)
lineColor = input.color(#8F959E, "Line color", group = GROUP_REGULAR)

// Highlighted level style
highlightEvery = input.float(
     100.0,
     "Highlight every",
     minval = 0.00000001,
     step = 0.01,
     group = GROUP_HIGHLIGHT
)
highlightStyleInput = input.string(
     "Solid",
     "Line style",
     options = ["Solid", "Dashed", "Dotted"],
     group = GROUP_HIGHLIGHT
)
highlightWidth = input.int(1, "Line width", minval = 1, maxval = 5, group = GROUP_HIGHLIGHT)
highlightColor = input.color(#5F6773, "Line color", group = GROUP_HIGHLIGHT)

// Major level style
majorEvery = input.float(
     1000.0,
     "Major every",
     minval = 0.00000001,
     step = 0.01,
     group = GROUP_MAJOR
)
majorStyleInput = input.string(
     "Solid",
     "Line style",
     options = ["Solid", "Dashed", "Dotted"],
     group = GROUP_MAJOR
)
majorWidth = input.int(2, "Line width", minval = 1, maxval = 5, group = GROUP_MAJOR)
majorColor = input.color(#374151, "Line color", group = GROUP_MAJOR)

// Display
maxLines = input.int(250, "Maximum lines", minval = 1, maxval = 500, group = GROUP_DISPLAY)

// Price labels
showRegularPrices = input.bool(false, "Regular levels", group = GROUP_LABELS)
showHighlightPrices = input.bool(false, "Highlighted levels", group = GROUP_LABELS)
showMajorPrices = input.bool(false, "Major levels", group = GROUP_LABELS)
labelPosition = input.string("Right", "Position", options = ["Right", "Center", "Left"], group = GROUP_LABELS)

toLineStyle(string styleName) =>
    switch styleName
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

isMultipleOf(float price, float every) =>
    float nearest = math.round(price / every) * every
    float tolerance = math.max(math.abs(price), every) * 1e-10
    math.abs(price - nearest) <= tolerance

string lineStyle = toLineStyle(styleInput)
string highlightStyle = toLineStyle(highlightStyleInput)
string majorStyle = toLineStyle(majorStyleInput)
string labelHalign = switch labelPosition
    "Left" => text.align_left
    "Center" => text.align_center
    => text.align_right

// Store drawn lines and the visible price range
var array<line> levelLines = array.new<line>()
var array<box> levelLabels = array.new<box>()
var float visibleLow = na
var float visibleHigh = na

// Find the high and low of the visible bars
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    visibleLow := na(visibleLow) ? low : math.min(visibleLow, low)
    visibleHigh := na(visibleHigh) ? high : math.max(visibleHigh, high)

// Draw levels within the visible range, including the offset
if barstate.islast
    for levelLine in levelLines
        line.delete(levelLine)
    array.clear(levelLines)
    for levelLabel in levelLabels
        box.delete(levelLabel)
    array.clear(levelLabels)

    if not na(visibleLow) and not na(visibleHigh)
        int firstIndex = int(math.ceil(visibleLow / stepSize)) - offsetLevels
        int lastIndex = int(math.floor(visibleHigh / stepSize)) + offsetLevels
        int totalLevels = lastIndex - firstIndex + 1

        if totalLevels > 0
            int linesToDraw = math.min(totalLevels, maxLines)
            int startOffset = int(math.floor((totalLevels - linesToDraw) / 2.0))

            for i = 0 to linesToDraw - 1
                float priceLevel = (firstIndex + startOffset + i) * stepSize
                color currentColor = lineColor
                string currentStyle = lineStyle
                int currentWidth = lineWidth
                bool currentShowPrice = showRegularPrices
                if isMultipleOf(priceLevel, majorEvery)
                    currentColor := majorColor
                    currentStyle := majorStyle
                    currentWidth := majorWidth
                    currentShowPrice := showMajorPrices
                else if isMultipleOf(priceLevel, highlightEvery)
                    currentColor := highlightColor
                    currentStyle := highlightStyle
                    currentWidth := highlightWidth
                    currentShowPrice := showHighlightPrices

                line newLine = line.new(
                     x1 = chart.left_visible_bar_time,
                     y1 = priceLevel,
                     x2 = chart.right_visible_bar_time,
                     y2 = priceLevel,
                     xloc = xloc.bar_time,
                     extend = extend.both,
                     color = currentColor,
                     style = currentStyle,
                     width = currentWidth
                )

                array.push(levelLines, newLine)

                // A zero-height box extended both ways spans the pane, so its text
                // aligns to the real screen edge, which a label cannot reach.
                if currentShowPrice
                    array.push(levelLabels, box.new(
                         left = chart.left_visible_bar_time,
                         top = priceLevel,
                         right = chart.right_visible_bar_time,
                         bottom = priceLevel,
                         xloc = xloc.bar_time,
                         extend = extend.both,
                         border_color = color.new(color.white, 100),
                         bgcolor = color.new(color.white, 100),
                         text = str.tostring(priceLevel, format.mintick),
                         text_color = currentColor,
                         text_size = size.small,
                         text_halign = labelHalign,
                         text_valign = text.align_center
                    ))
