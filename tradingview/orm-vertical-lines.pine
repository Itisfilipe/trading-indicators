// © Filipe Teixeira Amaral
// -----------------------------------------------------------------------------
// ORM Vertical Lines
// Author: Filipe Teixeira Amaral
// Version: 1.0
//
// Description:
// Vertical lines at the clock times of the Open Reaction Model on NQ -- the
// session opens and the 08:30 news -- drawn for the whole day, so the ones
// still ahead are already on the chart with a countdown to them. Every time is
// New York local, so daylight saving needs no adjustment.
//
// Features:
// - Six slots (on/off, HH:MM, caption, color): 00:00 Midnight, 02:00 London,
//   08:30 News, 09:30 NY Open, 13:30 PM Open, 20:00 Asia Open
// - Countdown under the caption of a line still ahead
// - Captions in the middle of the visible range, or on a strip above or below
//   the bars
// - Lines follow the futures trading day (18:00 to 17:00), so after the 18:00
//   open the next day's Midnight and London lines are already up
// - One history setting: past trading days that keep their lines
//
// Notes:
// - Days come from the chart's own bars, so a weekend or holiday never gets a
//   set of lines; the current trading day always gets its set, bars or not.
// - A line later today sits past the last bar. TradingView draws at most 500
//   bars past the last one (a little over eight hours on a 1-minute chart),
//   and the chart only reveals as much of that as the right margin allows.
// -----------------------------------------------------------------------------

indicator('ORMVerticalLines', 'ORM Time', overlay = true, max_lines_count = 500, max_labels_count = 500)

TZ = 'America/New_York'
HALF_DAY_MS = 43200000
SIX_HOURS_MS = 21600000
FALLBACK_LOOKBACK = 100
MAX_TRACKED_DAYS = 31

//==============================================================================
// INPUTS
//==============================================================================
GRP_GENERAL = 'General'
GRP_LINES = 'Lines'

history = input.int(1, 'Days of history', minval = 0, maxval = 30, tooltip = 'Past trading days that keep their lines, besides the current one. 0 = the current trading day only.', group = GRP_GENERAL)
lineWidth = input.int(1, 'Line width', minval = 1, maxval = 4, group = GRP_GENERAL)
lineStyleInput = input.string('Dotted', 'Line style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP_GENERAL)
labelPosition = input.string('Middle', 'Caption position', options = ['Top', 'Middle', 'Bottom'], tooltip = 'Middle tracks the centre of the visible range. Top and Bottom ride a strip clear of the bars; the chart gives up a little scale to make the room.', group = GRP_GENERAL)
edgeGapPercent = input.float(1.5, 'Strip gap (%)', minval = 0, maxval = 40, step = 0.5, tooltip = 'Space between the bars and the Top or Bottom strip, as a share of the visible price range.', group = GRP_GENERAL)
labelSizeInput = input.string('tiny', 'Caption size', options = ['tiny', 'small', 'normal', 'large'], group = GRP_GENERAL)
showCountdown = input.bool(true, 'Countdown on lines still ahead', group = GRP_GENERAL)

LINE_TOOLTIP = 'On/off, time as HH:MM New York, caption (empty for none), color.'
line1On = input.bool(true, '1', inline = 'l1', tooltip = LINE_TOOLTIP, group = GRP_LINES)
line1Time = input.string('00:00', '', inline = 'l1', group = GRP_LINES)
line1Text = input.string('Midnight', '', inline = 'l1', group = GRP_LINES)
line1Color = input.color(#5f6773, '', inline = 'l1', group = GRP_LINES)
line2On = input.bool(true, '2', inline = 'l2', group = GRP_LINES)
line2Time = input.string('02:00', '', inline = 'l2', group = GRP_LINES)
line2Text = input.string('London', '', inline = 'l2', group = GRP_LINES)
line2Color = input.color(#9c27b0, '', inline = 'l2', group = GRP_LINES)
line3On = input.bool(true, '3', inline = 'l3', group = GRP_LINES)
line3Time = input.string('08:30', '', inline = 'l3', group = GRP_LINES)
line3Text = input.string('8:30 News', '', inline = 'l3', group = GRP_LINES)
line3Color = input.color(#ef5350, '', inline = 'l3', group = GRP_LINES)
line4On = input.bool(true, '4', inline = 'l4', group = GRP_LINES)
line4Time = input.string('09:30', '', inline = 'l4', group = GRP_LINES)
line4Text = input.string('NY Open', '', inline = 'l4', group = GRP_LINES)
line4Color = input.color(#2962ff, '', inline = 'l4', group = GRP_LINES)
line5On = input.bool(true, '5', inline = 'l5', group = GRP_LINES)
line5Time = input.string('13:30', '', inline = 'l5', group = GRP_LINES)
line5Text = input.string('PM Open', '', inline = 'l5', group = GRP_LINES)
line5Color = input.color(#f23645, '', inline = 'l5', group = GRP_LINES)
line6On = input.bool(true, '6', inline = 'l6', group = GRP_LINES)
line6Time = input.string('20:00', '', inline = 'l6', group = GRP_LINES)
line6Text = input.string('Asia Open', '', inline = 'l6', group = GRP_LINES)
line6Color = input.color(#089981, '', inline = 'l6', group = GRP_LINES)

//==============================================================================
// TYPES AND HELPERS
//==============================================================================
type TimeLine
    int clockMinute
    string caption
    color tint

pad2(int value) =>
    (value < 10 ? '0' : '') + str.tostring(value)

// mm:ss under an hour, then Hh MMm.
countdownText(int milliseconds) =>
    totalSeconds = int(math.max(0, milliseconds) / 1000)
    hours = int(totalSeconds / 3600)
    minutes = int(totalSeconds % 3600 / 60)
    hours > 0 ? str.tostring(hours) + 'h ' + pad2(minutes) + 'm' : pad2(minutes) + ':' + pad2(totalSeconds % 60)

midnightOf(int t) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0)

// Midnight of the futures trading day holding t: from 18:00 the session belongs to the next date.
tradingDateOf(int t) =>
    midnightOf(t + SIX_HOURS_MS)

// Evening times (18:00 and later) of a trading day fall on the calendar day before it.
eventTimeOf(int tradingDate, int clockMinute) =>
    calendarDay = clockMinute >= 18 * 60 ? midnightOf(tradingDate - HALF_DAY_MS) : tradingDate
    timestamp(TZ, year(calendarDay, TZ), month(calendarDay, TZ), dayofmonth(calendarDay, TZ), int(clockMinute / 60), clockMinute % 60)

// "HH:MM" to minutes after midnight; na when the text is not a time.
parseClock(string clockText) =>
    parts = str.split(str.trim(clockText), ':')
    int result = na
    if parts.size() == 2
        hours = str.tonumber(parts.get(0))
        minutes = str.tonumber(parts.get(1))
        if not na(hours) and not na(minutes) and hours >= 0 and hours < 24 and minutes >= 0 and minutes < 60
            result := int(hours) * 60 + int(minutes)
    result

//==============================================================================
// LINES AND DAYS
//==============================================================================
var markers = array.new<TimeLine>()

addLine(bool enabled, string timeText, string caption, color tint) =>
    clockMinute = parseClock(timeText)
    if enabled and not na(clockMinute)
        markers.push(TimeLine.new(clockMinute, caption, tint))

if barstate.isfirst
    addLine(line1On, line1Time, line1Text, line1Color)
    addLine(line2On, line2Time, line2Text, line2Color)
    addLine(line3On, line3Time, line3Text, line3Color)
    addLine(line4On, line4Time, line4Text, line4Color)
    addLine(line5On, line5Time, line5Text, line5Color)
    addLine(line6On, line6Time, line6Text, line6Color)

var tradingDays = array.new<int>()
barTradingDate = tradingDateOf(time)
if tradingDays.size() == 0 or tradingDays.last() != barTradingDate
    tradingDays.push(barTradingDate)
    if tradingDays.size() > MAX_TRACKED_DAYS
        tradingDays.shift()

// Reading the visible bar times also makes TradingView re-run the script on scroll and zoom.
var float visibleHigh = na
var float visibleLow = na
if not na(chart.left_visible_bar_time) and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    visibleHigh := na(visibleHigh) ? high : math.max(visibleHigh, high)
    visibleLow := na(visibleLow) ? low : math.min(visibleLow, low)

fallbackSpan = math.min(FALLBACK_LOOKBACK, bar_index + 1)
fallbackHigh = ta.highest(high, fallbackSpan)
fallbackLow = ta.lowest(low, fallbackSpan)

//==============================================================================
// DRAWING
//==============================================================================
lineStyle = switch lineStyleInput
    'Solid' => line.style_solid
    'Dashed' => line.style_dashed
    => line.style_dotted
textSize = switch labelSizeInput
    'small' => size.small
    'normal' => size.normal
    'large' => size.large
    => size.tiny

if barstate.islast
    for drawn in line.all
        drawn.delete()
    for drawn in label.all
        drawn.delete()

    screenHigh = na(visibleHigh) ? fallbackHigh : visibleHigh
    screenLow = na(visibleLow) ? fallbackLow : visibleLow
    edgeGap = (screenHigh - screenLow) * edgeGapPercent / 100
    labelY = switch labelPosition
        'Top' => screenHigh + edgeGap
        'Bottom' => screenLow - edgeGap
        => math.avg(screenHigh, screenLow)

    currentDate = tradingDateOf(timenow)
    daysToDraw = array.new<int>()
    for tradingDay in tradingDays
        if tradingDay < currentDate
            daysToDraw.push(tradingDay)
    while daysToDraw.size() > history
        daysToDraw.shift()
    currentWeekday = dayofweek(currentDate, TZ)
    if currentWeekday != dayofweek.saturday and currentWeekday != dayofweek.sunday
        daysToDraw.push(currentDate)

    for drawDay in daysToDraw
        for marker in markers
            eventTime = eventTimeOf(drawDay, marker.clockMinute)
            line.new(eventTime, screenLow, eventTime, screenHigh, xloc = xloc.bar_time, extend = extend.both, color = marker.tint, style = lineStyle, width = lineWidth)
            if marker.caption != ''
                caption = showCountdown and eventTime > timenow ? marker.caption + '\n' + countdownText(eventTime - timenow) : marker.caption
                label.new(eventTime, labelY, caption, xloc = xloc.bar_time, style = label.style_label_left, color = color(na), textcolor = marker.tint, size = textSize)
