//@version=6
// -----------------------------------------------------------------------------
// Time-Based Vertical Lines
// Author: Filipe Teixeira Amaral
// Version: 1.0
//
// Description:
// Vertical lines at the clock times that matter during a session -- New York
// midnight, the 09:30 open, a news release, the ICT macro windows -- drawn for
// the whole day, so the ones still ahead are already on the chart with a
// countdown to them. The companion to Time-Based Price Levels: that one answers
// "at what price", this one answers "at what time, and how long until it".
//
// Ten line slots, each with its own time, label, color and style, plus a preset
// that lays down the eight ICT macro windows in one checkbox so the slots stay
// free for everything else.
//
// Features:
// - 10 line slots, one compact row each: on/off, HH:MM, label, color, style
// - Every line drawn for the whole day, future ones included
// - Countdown on a line that has not happened yet
// - ICT macro preset: eight windows, marked at the start or start and end
// - Labels pinned to the top or bottom edge of the visible chart
// - Time zone support and historical-days control
//
// Notes:
// - Times are read as HH:MM in the selected zone. An entry that is not a valid
//   time is skipped, with a note in the Pine Logs pane.
// - A line's own time places it, so a line later today sits past the last bar.
//   Widen the chart's right margin (Chart settings > Appearance) to keep those
//   on screen; TradingView will not scroll there on its own.
// -----------------------------------------------------------------------------

indicator('Time-Based Vertical Lines', 'Vertical Lines', overlay = true, max_lines_count = 500, max_labels_count = 500)

MS_PER_DAY = 86400000
FALLBACK_LOOKBACK = 100

// Ten days of history against ten slots plus sixteen macro marks stays well
// inside the 500-drawing ceiling.
MAX_TRACKED_DAYS = 20

//==============================================================================
// INPUTS
//==============================================================================
GRP_GENERAL = 'General Settings'
GRP_LABELS = 'Label Settings'
GRP_MACROS = 'ICT Macro Preset'
GRP_LINES = 'Lines'

tz = input.string('America/New_York', 'Time Zone', options = ['America/New_York', 'America/Chicago', 'America/Denver', 'America/Los_Angeles', 'Europe/London', 'Europe/Paris', 'Europe/Berlin', 'Europe/Moscow', 'Asia/Tokyo', 'Asia/Shanghai', 'Asia/Hong_Kong', 'Asia/Singapore', 'Asia/Kolkata', 'Australia/Sydney', 'Pacific/Auckland', 'GMT-12', 'GMT-11', 'GMT-10', 'GMT-9', 'GMT-8', 'GMT-7', 'GMT-6', 'GMT-5', 'GMT-4', 'GMT-3', 'GMT-2', 'GMT-1', 'GMT', 'GMT+1', 'GMT+2', 'GMT+3', 'GMT+4', 'GMT+5', 'GMT+6', 'GMT+7', 'GMT+8', 'GMT+9', 'GMT+10', 'GMT+11', 'GMT+12'], tooltip = 'Zone every line time below is read in.', group = GRP_GENERAL)

history_days = input.int(1, 'Days of History to Show', 0, 10, tooltip = 'Number of previous days that keep their lines. 0 = today only.', group = GRP_GENERAL)

include_tomorrow = input.bool(false, 'Include Tomorrow', tooltip = 'Also draw tomorrow\'s lines. Useful late in the session, when everything for today has already happened.', group = GRP_GENERAL)

line_width = input.int(1, 'Line Width', 1, 5, tooltip = 'Width applied to all lines; each line keeps its own color and style.', group = GRP_GENERAL)

show_labels = input.bool(true, 'Show Labels', tooltip = 'Print each line\'s label at the edge of the chart.', group = GRP_LABELS)

label_position = input.string('Top', 'Label Position', options = ['Top', 'Bottom'], tooltip = 'Which edge of the visible chart the labels sit at. They stay welded to it through any scroll or zoom.', group = GRP_LABELS)

label_size = input.string('small', 'Label Size', options = ['tiny', 'small', 'normal', 'large'], group = GRP_LABELS)

show_countdown = input.bool(true, 'Countdown On Future Lines', tooltip = 'Add the time left to the label of a line whose time has not come yet.', group = GRP_LABELS)

show_macros = input.bool(true, 'Show ICT Macros', tooltip = 'The eight macro windows: 02:33-03:00, 04:03-04:30, 08:50-09:10, 09:50-10:10, 10:50-11:10, 11:50-12:10, 13:10-13:40, 15:15-15:45. Defined in New York time, so set the zone above accordingly.', group = GRP_MACROS)

macro_marks = input.string('Start only', 'Mark', options = ['Start only', 'Start and end'], tooltip = '"Start and end" brackets each window with a second line, so the macro reads as a span rather than a moment.', group = GRP_MACROS)

macro_color = input.color(#F57C00, 'Color', inline = 'macro', group = GRP_MACROS)
macro_style = input.string('Dotted', 'Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'macro', group = GRP_MACROS)

// One row per line: on/off, HH:MM, label, color, style.
LINE_TOOLTIP = 'On/off, time as HH:MM in the selected zone, label text (leave empty for no label), color, style.'

line1_on = input.bool(true, '1', inline = 'l1', tooltip = LINE_TOOLTIP, group = GRP_LINES)
line1_time = input.string('00:00', '', inline = 'l1', group = GRP_LINES)
line1_text = input.string('NY Midnight', '', inline = 'l1', group = GRP_LINES)
line1_color = input.color(#787B86, '', inline = 'l1', group = GRP_LINES)
line1_style = input.string('Dashed', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l1', group = GRP_LINES)

line2_on = input.bool(true, '2', inline = 'l2', group = GRP_LINES)
line2_time = input.string('08:30', '', inline = 'l2', group = GRP_LINES)
line2_text = input.string('News', '', inline = 'l2', group = GRP_LINES)
line2_color = input.color(#EF5350, '', inline = 'l2', group = GRP_LINES)
line2_style = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l2', group = GRP_LINES)

line3_on = input.bool(true, '3', inline = 'l3', group = GRP_LINES)
line3_time = input.string('09:30', '', inline = 'l3', group = GRP_LINES)
line3_text = input.string('NY Open', '', inline = 'l3', group = GRP_LINES)
line3_color = input.color(#2962FF, '', inline = 'l3', group = GRP_LINES)
line3_style = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l3', group = GRP_LINES)

line4_on = input.bool(true, '4', inline = 'l4', group = GRP_LINES)
line4_time = input.string('16:00', '', inline = 'l4', group = GRP_LINES)
line4_text = input.string('NY Close', '', inline = 'l4', group = GRP_LINES)
line4_color = input.color(#2962FF, '', inline = 'l4', group = GRP_LINES)
line4_style = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l4', group = GRP_LINES)

line5_on = input.bool(true, '5', inline = 'l5', group = GRP_LINES)
line5_time = input.string('18:00', '', inline = 'l5', group = GRP_LINES)
line5_text = input.string('Futures Open', '', inline = 'l5', group = GRP_LINES)
line5_color = input.color(#787B86, '', inline = 'l5', group = GRP_LINES)
line5_style = input.string('Dashed', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l5', group = GRP_LINES)

line6_on = input.bool(false, '6', inline = 'l6', group = GRP_LINES)
line6_time = input.string('03:00', '', inline = 'l6', group = GRP_LINES)
line6_text = input.string('London Open', '', inline = 'l6', group = GRP_LINES)
line6_color = input.color(#26A69A, '', inline = 'l6', group = GRP_LINES)
line6_style = input.string('Dashed', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l6', group = GRP_LINES)

line7_on = input.bool(false, '7', inline = 'l7', group = GRP_LINES)
line7_time = input.string('11:30', '', inline = 'l7', group = GRP_LINES)
line7_text = input.string('London Close', '', inline = 'l7', group = GRP_LINES)
line7_color = input.color(#26A69A, '', inline = 'l7', group = GRP_LINES)
line7_style = input.string('Dashed', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l7', group = GRP_LINES)

line8_on = input.bool(false, '8', inline = 'l8', group = GRP_LINES)
line8_time = input.string('14:00', '', inline = 'l8', group = GRP_LINES)
line8_text = input.string('FOMC', '', inline = 'l8', group = GRP_LINES)
line8_color = input.color(#EF5350, '', inline = 'l8', group = GRP_LINES)
line8_style = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l8', group = GRP_LINES)

line9_on = input.bool(false, '9', inline = 'l9', group = GRP_LINES)
line9_time = input.string('17:00', '', inline = 'l9', group = GRP_LINES)
line9_text = input.string('Session Break', '', inline = 'l9', group = GRP_LINES)
line9_color = input.color(#787B86, '', inline = 'l9', group = GRP_LINES)
line9_style = input.string('Dotted', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l9', group = GRP_LINES)

line10_on = input.bool(false, '10', inline = 'l10', group = GRP_LINES)
line10_time = input.string('12:00', '', inline = 'l10', group = GRP_LINES)
line10_text = input.string('', '', inline = 'l10', group = GRP_LINES)
line10_color = input.color(#787B86, '', inline = 'l10', group = GRP_LINES)
line10_style = input.string('Solid', '', options = ['Solid', 'Dashed', 'Dotted'], inline = 'l10', group = GRP_LINES)

//==============================================================================
// TYPES
//==============================================================================
// One clock time to mark. The date is supplied per day drawn; an empty caption
// means the line goes up without a label.
type TimeLine
    int at_hour
    int at_minute
    string caption
    color tint
    string style

//==============================================================================
// HELPERS
//==============================================================================
pad_two(int value) =>
    (value < 10 ? '0' : '') + str.tostring(value)

clock_text(int hour_of_day, int minute_of_hour) =>
    pad_two(hour_of_day) + ':' + pad_two(minute_of_hour)

// mm:ss while under an hour, then Hh MMm -- the seconds stop being useful once
// the line is that far out.
countdown_text(int milliseconds) =>
    total_seconds = int(math.max(0, milliseconds) / 1000)
    hours = int(total_seconds / 3600)
    minutes = int(total_seconds % 3600 / 60)
    seconds = total_seconds % 60
    hours > 0 ? str.tostring(hours) + 'h ' + pad_two(minutes) + 'm' : pad_two(minutes) + ':' + pad_two(seconds)

midnight_of(int reference_time) =>
    timestamp(tz, year(reference_time, tz), month(reference_time, tz), dayofmonth(reference_time, tz), 0, 0)

// Reads HH:MM into minutes since midnight, or -1 when the text is not a time.
// Guarding here rather than indexing blindly keeps a typo in one slot from
// taking the whole indicator down.
parse_clock_minutes(string text) =>
    int minutes_since_midnight = -1
    parts = str.split(str.replace_all(text, ' ', ''), ':')
    if array.size(parts) == 2
        hour_value = str.tonumber(array.get(parts, 0))
        minute_value = str.tonumber(array.get(parts, 1))
        if not na(hour_value) and not na(minute_value) and hour_value >= 0 and hour_value <= 23 and minute_value >= 0 and minute_value <= 59
            minutes_since_midnight := int(hour_value) * 60 + int(minute_value)
    minutes_since_midnight

line_style_constant(string name) =>
    switch name
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

label_size_constant() =>
    switch label_size
        'tiny' => size.tiny
        'small' => size.small
        'large' => size.large
        => size.normal

//==============================================================================
// THE LINES TO DRAW
//==============================================================================
var array<TimeLine> events = array.new<TimeLine>()

add_line(bool enabled, string time_text, string caption, color tint, string style_name) =>
    if enabled
        minutes_since_midnight = parse_clock_minutes(time_text)
        if minutes_since_midnight < 0
            log.warning('Time-Based Vertical Lines: skipping "{0}", expected a time as HH:MM', time_text)
        else
            array.push(events, TimeLine.new(int(minutes_since_midnight / 60), minutes_since_midnight % 60, caption, tint, style_name))

add_macro(int start_hour, int start_minute, int end_hour, int end_minute) =>
    if show_macros
        window = clock_text(start_hour, start_minute) + '-' + clock_text(end_hour, end_minute)
        array.push(events, TimeLine.new(start_hour, start_minute, window, macro_color, macro_style))
        if macro_marks == 'Start and end'
            // The closing line carries no caption: it is the same window, and a
            // second label would only crowd the first.
            array.push(events, TimeLine.new(end_hour, end_minute, '', macro_color, macro_style))

if barstate.isfirst
    add_line(line1_on, line1_time, line1_text, line1_color, line1_style)
    add_line(line2_on, line2_time, line2_text, line2_color, line2_style)
    add_line(line3_on, line3_time, line3_text, line3_color, line3_style)
    add_line(line4_on, line4_time, line4_text, line4_color, line4_style)
    add_line(line5_on, line5_time, line5_text, line5_color, line5_style)
    add_line(line6_on, line6_time, line6_text, line6_color, line6_style)
    add_line(line7_on, line7_time, line7_text, line7_color, line7_style)
    add_line(line8_on, line8_time, line8_text, line8_color, line8_style)
    add_line(line9_on, line9_time, line9_text, line9_color, line9_style)
    add_line(line10_on, line10_time, line10_text, line10_color, line10_style)
    add_macro(2, 33, 3, 0)
    add_macro(4, 3, 4, 30)
    add_macro(8, 50, 9, 10)
    add_macro(9, 50, 10, 10)
    add_macro(10, 50, 11, 10)
    add_macro(11, 50, 12, 10)
    add_macro(13, 10, 13, 40)
    add_macro(15, 15, 15, 45)

//==============================================================================
// THE DAYS TO DRAW THEM ON
//==============================================================================
// Days are logged as the bars pass through them rather than counted back from
// today, so a weekend or a holiday never collects a set of lines nothing traded
// under. Today is added at draw time whether or not it has bars yet.
var array<int> trading_days = array.new<int>()

bar_midnight = midnight_of(time)
if array.size(trading_days) == 0 or array.get(trading_days, array.size(trading_days) - 1) != bar_midnight
    array.push(trading_days, bar_midnight)
    if array.size(trading_days) > MAX_TRACKED_DAYS
        array.shift(trading_days)

//==============================================================================
// VISIBLE PRICE RANGE
//==============================================================================
// A vertical line needs two prices to be born, and the labels ride the edge of
// the screen, so both want the price range the screen is actually showing.
// Reading chart.left_visible_bar_time and chart.right_visible_bar_time is also
// what makes TradingView re-run the script on a scroll or a zoom, which is what
// keeps the labels welded to that edge.
var float visible_high = na
var float visible_low = na

bar_is_visible = not na(chart.left_visible_bar_time) and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
if bar_is_visible
    visible_high := na(visible_high) ? high : math.max(visible_high, high)
    visible_low := na(visible_low) ? low : math.min(visible_low, low)

// Only reached before the chart reports a visible range at all; the last stretch
// of bars is a fair stand-in for what is on screen.
fallback_high = ta.highest(high, FALLBACK_LOOKBACK)
fallback_low = ta.lowest(low, FALLBACK_LOOKBACK)

//==============================================================================
// DRAWING
//==============================================================================
// Everything is redrawn on each last-bar pass: the labels have to follow the
// visible range, and the countdowns have to stay current. Lines are anchored to
// real timestamps through xloc.bar_time, which is what lets one sit past the
// last bar -- a bar index cannot address a bar that does not exist yet, a
// timestamp can.
var array<line> drawn_lines = array.new<line>()
var array<label> drawn_labels = array.new<label>()

if barstate.islast
    for existing_line in drawn_lines
        line.delete(existing_line)
    for existing_label in drawn_labels
        label.delete(existing_label)
    array.clear(drawn_lines)
    array.clear(drawn_labels)

    // Endpoints inside the visible range, then extended both ways to fill the
    // height. Reaching past the visible high or low instead would pull the
    // chart's own scaling out to meet the line.
    screen_high = na(visible_high) ? fallback_high : visible_high
    screen_low = na(visible_low) ? fallback_low : visible_low
    label_y = label_position == 'Bottom' ? screen_low : screen_high
    label_style = label_position == 'Bottom' ? label.style_label_up : label.style_label_down

    today_midnight = midnight_of(timenow)
    cutoff = today_midnight - history_days * MS_PER_DAY

    days = array.new<int>()
    for tracked_day in trading_days
        if tracked_day >= cutoff and tracked_day < today_midnight
            array.push(days, tracked_day)
    array.push(days, today_midnight)
    if include_tomorrow
        // Adding a day to midnight lands on 23:00 or 01:00 either side of a
        // daylight-saving switch, which is still the right calendar date.
        array.push(days, today_midnight + MS_PER_DAY)

    for day_start in days
        day_year = year(day_start, tz)
        day_month = month(day_start, tz)
        day_of_month = dayofmonth(day_start, tz)
        for marker in events
            event_time = timestamp(tz, day_year, day_month, day_of_month, marker.at_hour, marker.at_minute)
            array.push(drawn_lines, line.new(event_time, screen_low, event_time, screen_high, xloc = xloc.bar_time, extend = extend.both, color = marker.tint, style = line_style_constant(marker.style), width = line_width))

            if show_labels and str.length(marker.caption) > 0
                caption = marker.caption
                if show_countdown and event_time > timenow
                    caption += '\n' + countdown_text(event_time - timenow)
                array.push(drawn_labels, label.new(event_time, label_y, caption, xloc = xloc.bar_time, yloc = yloc.price, style = label_style, color = color.new(color.white, 100), textcolor = marker.tint, size = label_size_constant()))
