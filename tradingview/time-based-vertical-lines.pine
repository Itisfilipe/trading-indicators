//@version=6
// -----------------------------------------------------------------------------
// Time-Based Vertical Lines
// Author: Filipe Teixeira Amaral
// Version: 1.0
//
// Description:
// Vertical lines at the clock times that matter during a session -- New York
// midnight, the 09:30 open, a news release, the ICT macro windows -- drawn for
// the whole day, so the ones still ahead are already on the chart with a
// countdown to them. The companion to Time-Based Price Levels: that one answers
// "at what price", this one answers "at what time, and how long until it".
//
// Ten line slots, each with its own time, label, color and style, plus twelve
// macro slots, each bracketed by a line at both ends with a captioned rectangle
// joining the pair, so the line slots stay free for everything else.
//
// The macro slots default to the ICT windows, in New York time, grouped by the
// session each falls in:
//   07:50 - 08:10                                   pre-market
//   08:50 - 09:10                                   into the open
//   09:50 - 10:10   10:50 - 11:10                   AM session,  09:30 - 11:30
//   11:50 - 12:10   12:50 - 13:10                   lunch,       11:30 - 13:30
//   13:50 - 14:10   14:50 - 15:10
//   15:15 - 15:45   15:45 - 16:00                   PM session,  13:30 - 16:00
// The last two slots hold the London macros, 02:33 - 03:00 and 04:03 - 04:30,
// switched off.
//
// Features:
// - 10 line slots, one compact row each: on/off, HH:MM, label, color, style
// - Every line drawn for the whole day, future ones included
// - Countdown on a line that has not happened yet
// - 12 macro slots, each bracketed by a line at its start and one at its end,
//   with a captioned rectangle joining the pair
// - Captions and rectangles share one strip, set clear of the bars
// - Time zone support and historical-days control
//
// Notes:
// - Times are read as HH:MM in the selected zone. An entry that is not a valid
//   time is skipped, with a note in the Pine Logs pane.
// - Labels read across, not down the line the way the chart's own vertical-line
//   drawing does. A script cannot reach that drawing -- Pine's lines and labels
//   are a separate system from the chart's drawing tools -- and a label has no
//   rotation of its own, so across it is, hung off the side of the line.
// - A line's own time places it, so a line later today sits past the last bar.
//   Two things bound how far ahead that stays legible: TradingView draws at most
//   500 bars past the last one, which is a little over eight hours on a
//   1-minute chart, and the chart only reveals as much of that as the right
//   margin allows (Chart settings > Appearance). The further ahead you want to
//   see, the coarser the timeframe has to be -- "Include Tomorrow" is only worth
//   switching on from about 5 minutes up.
// -----------------------------------------------------------------------------

indicator('Time-Based Vertical Lines', 'Time Lines', overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

MS_PER_DAY = 86400000
HALF_DAY_MS = 43200000
FALLBACK_LOOKBACK = 100

// Distinct days kept in the log: comfortably more than the five the history
// cutoff can ask for, so the oldest day still wanted is always still in there.
MAX_TRACKED_DAYS = 20

//==============================================================================
// INPUTS
//==============================================================================
GRP_GENERAL = 'General Settings'
GRP_LABELS = 'Label Settings'
GRP_MACROS = 'Macros'
GRP_LINES = 'Lines'

tz = input.string('America/New_York', 'Time Zone', options = ['America/New_York', 'America/Chicago', 'America/Denver', 'America/Los_Angeles', 'Europe/London', 'Europe/Paris', 'Europe/Berlin', 'Europe/Moscow', 'Asia/Tokyo', 'Asia/Shanghai', 'Asia/Hong_Kong', 'Asia/Singapore', 'Asia/Kolkata', 'Australia/Sydney', 'Pacific/Auckland', 'GMT-12', 'GMT-11', 'GMT-10', 'GMT-9', 'GMT-8', 'GMT-7', 'GMT-6', 'GMT-5', 'GMT-4', 'GMT-3', 'GMT-2', 'GMT-1', 'GMT', 'GMT+1', 'GMT+2', 'GMT+3', 'GMT+4', 'GMT+5', 'GMT+6', 'GMT+7', 'GMT+8', 'GMT+9', 'GMT+10', 'GMT+11', 'GMT+12'], tooltip = 'Zone every line time below is read in.', group = GRP_GENERAL)

history_days = input.int(1, 'Days of History to Show', 0, 5, tooltip = 'Number of previous days that keep their lines, counted back from the last day the chart has bars for. 0 = today only.', group = GRP_GENERAL)

include_tomorrow = input.bool(false, 'Include Tomorrow', tooltip = 'Also draw tomorrow\'s lines. Useful late in the session, when everything for today has already happened. Only worth it from about the 5-minute timeframe up: TradingView draws at most 500 bars past the last one.', group = GRP_GENERAL)

line_width = input.int(1, 'Line Width', 1, 5, tooltip = 'Width applied to all lines; each line keeps its own color and style.', group = GRP_GENERAL)

show_labels = input.bool(true, 'Show Labels', tooltip = 'Print each line\'s label at the edge of the chart.', group = GRP_LABELS)

label_position = input.string('Top', 'Label Position', options = ['Top', 'Middle', 'Bottom'], tooltip = 'Where on the line the label sits. Top and Bottom ride the edge of the visible chart and stay welded to it through any scroll or zoom; Middle tracks the centre of it.', group = GRP_LABELS)

label_size = input.string('small', 'Label Size', options = ['tiny', 'small', 'normal', 'large'], group = GRP_LABELS)

label_distance = input.float(1.5, 'Edge Gap (%)', 0, 40, step = 0.5, tooltip = 'Clear space between the bars and the strip of captions and macro rectangles below or above them, as a share of the visible price range. The chart gives up that much scale to make the room, so a larger gap means slightly flatter candles. Middle ignores it.', group = GRP_LABELS)

show_countdown = input.bool(true, 'Countdown On Future Lines', tooltip = 'Add the time left to the label of a line whose time has not come yet.', group = GRP_LABELS)

show_macros = input.bool(true, 'Show Macros', tooltip = 'Master switch for the twelve rows below.', group = GRP_MACROS)

macro_color = input.color(#F57C00, 'Color', inline = 'macro', group = GRP_MACROS)
macro_style = input.string('Dotted', 'Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'macro', group = GRP_MACROS)

macro_band_height = input.float(4, 'Band Height (%)', 0, 40, step = 0.5, tooltip = 'Height of the rectangle joining a macro\'s two lines, as a share of the visible price range. It carries the macro\'s caption, so it needs enough room to print it -- the chart clips text to the rectangle. 0 hides both.', group = GRP_MACROS)

macro_band_transp = input.int(85, 'Band Transparency', 0, 100, group = GRP_MACROS)

// Twelve slots, three inputs each. Defaults are the ICT macros in New York
// time; they are inputs rather than constants because the window a desk
// actually trades drifts from the published one, and because the same rows
// serve any other recurring span just as well.
MACRO_TOOLTIP = 'On/off, then the window\'s start and end as HH:MM in the selected zone.'

macro1_on = input.bool(true, '1', inline = 'm1', tooltip = MACRO_TOOLTIP, group = GRP_MACROS)
macro1_start = input.string('07:50', '', inline = 'm1', group = GRP_MACROS)
macro1_end = input.string('08:10', '-', inline = 'm1', group = GRP_MACROS)

macro2_on = input.bool(true, '2', inline = 'm2', group = GRP_MACROS)
macro2_start = input.string('08:50', '', inline = 'm2', group = GRP_MACROS)
macro2_end = input.string('09:10', '-', inline = 'm2', group = GRP_MACROS)

macro3_on = input.bool(true, '3', inline = 'm3', group = GRP_MACROS)
macro3_start = input.string('09:50', '', inline = 'm3', group = GRP_MACROS)
macro3_end = input.string('10:10', '-', inline = 'm3', group = GRP_MACROS)

macro4_on = input.bool(true, '4', inline = 'm4', group = GRP_MACROS)
macro4_start = input.string('10:50', '', inline = 'm4', group = GRP_MACROS)
macro4_end = input.string('11:10', '-', inline = 'm4', group = GRP_MACROS)

macro5_on = input.bool(true, '5', inline = 'm5', group = GRP_MACROS)
macro5_start = input.string('11:50', '', inline = 'm5', group = GRP_MACROS)
macro5_end = input.string('12:10', '-', inline = 'm5', group = GRP_MACROS)

macro6_on = input.bool(true, '6', inline = 'm6', group = GRP_MACROS)
macro6_start = input.string('12:50', '', inline = 'm6', group = GRP_MACROS)
macro6_end = input.string('13:10', '-', inline = 'm6', group = GRP_MACROS)

macro7_on = input.bool(true, '7', inline = 'm7', group = GRP_MACROS)
macro7_start = input.string('13:50', '', inline = 'm7', group = GRP_MACROS)
macro7_end = input.string('14:10', '-', inline = 'm7', group = GRP_MACROS)

macro8_on = input.bool(true, '8', inline = 'm8', group = GRP_MACROS)
macro8_start = input.string('14:50', '', inline = 'm8', group = GRP_MACROS)
macro8_end = input.string('15:10', '-', inline = 'm8', group = GRP_MACROS)

macro9_on = input.bool(true, '9', inline = 'm9', group = GRP_MACROS)
macro9_start = input.string('15:15', '', inline = 'm9', group = GRP_MACROS)
macro9_end = input.string('15:45', '-', inline = 'm9', group = GRP_MACROS)

macro10_on = input.bool(true, '10', inline = 'm10', group = GRP_MACROS)
macro10_start = input.string('15:45', '', inline = 'm10', group = GRP_MACROS)
macro10_end = input.string('16:00', '-', inline = 'm10', group = GRP_MACROS)

macro11_on = input.bool(false, '11', inline = 'm11', group = GRP_MACROS)
macro11_start = input.string('02:33', '', inline = 'm11', group = GRP_MACROS)
macro11_end = input.string('03:00', '-', inline = 'm11', group = GRP_MACROS)

macro12_on = input.bool(false, '12', inline = 'm12', group = GRP_MACROS)
macro12_start = input.string('04:03', '', inline = 'm12', group = GRP_MACROS)
macro12_end = input.string('04:30', '-', inline = 'm12', group = GRP_MACROS)

//==============================================================================
// TYPES
//==============================================================================
// One clock time to mark. The date is supplied per day drawn; an empty caption
// means the line goes up without a label.
type TimeLine
    int at_hour
    int at_minute
    string caption
    color tint
    string style

// A macro is a span, so it is kept as one: the pair of times its two lines are
// drawn at, and the caption the rectangle between them carries.
type MacroSpan
    int start_hour
    int start_minute
    int end_hour
    int end_minute
    string caption

//==============================================================================
// HELPERS
//==============================================================================
pad_two(int value) =>
    (value < 10 ? '0' : '') + str.tostring(value)

clock_text(int hour_of_day, int minute_of_hour) =>
    pad_two(hour_of_day) + ':' + pad_two(minute_of_hour)

// mm:ss while under an hour, then Hh MMm -- the seconds stop being useful once
// the line is that far out.
countdown_text(int milliseconds) =>
    total_seconds = int(math.max(0, milliseconds) / 1000)
    hours = int(total_seconds / 3600)
    minutes = int(total_seconds % 3600 / 60)
    seconds = total_seconds % 60
    hours > 0 ? str.tostring(hours) + 'h ' + pad_two(minutes) + 'm' : pad_two(minutes) + ':' + pad_two(seconds)

midnight_of(int reference_time) =>
    timestamp(tz, year(reference_time, tz), month(reference_time, tz), dayofmonth(reference_time, tz), 0, 0)

// Steps a whole number of days from one midnight to another. Adding 24 hours to
// a midnight lands at 23:00 or 01:00 across a daylight-saving switch -- once on
// the wrong date entirely -- so the step goes via the target day's noon, which
// no switch can push out of its own day, and midnight_of reduces it back.
shift_days(int day_midnight, int day_count) =>
    midnight_of(day_midnight + day_count * MS_PER_DAY + HALF_DAY_MS)

// Reads HH:MM into minutes since midnight, or -1 when the entry is not a time.
// Guarding here rather than indexing blindly keeps a typo in one slot from
// taking the whole indicator down.
parse_clock_minutes(string time_text) =>
    int minutes_since_midnight = -1
    parts = str.split(str.replace_all(time_text, ' ', ''), ':')
    if array.size(parts) == 2
        hour_value = str.tonumber(array.get(parts, 0))
        minute_value = str.tonumber(array.get(parts, 1))
        whole_numbers = hour_value == math.floor(hour_value) and minute_value == math.floor(minute_value)
        if not na(hour_value) and not na(minute_value) and whole_numbers and hour_value >= 0 and hour_value <= 23 and minute_value >= 0 and minute_value <= 59
            minutes_since_midnight := int(hour_value) * 60 + int(minute_value)
    minutes_since_midnight

line_style_constant(string name) =>
    switch name
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        => line.style_solid

label_size_constant() =>
    switch label_size
        'tiny' => size.tiny
        'small' => size.small
        'large' => size.large
        => size.normal

//==============================================================================
// THE LINES TO DRAW
//==============================================================================
var array<TimeLine> events = array.new<TimeLine>()
var array<MacroSpan> macro_spans = array.new<MacroSpan>()

add_line(bool enabled, string time_text, string caption, color tint, string style_name) =>
    if enabled
        minutes_since_midnight = parse_clock_minutes(time_text)
        if minutes_since_midnight < 0
            log.warning('Time-Based Vertical Lines: skipping "{0}", expected a time as HH:MM', time_text)
        else
            array.push(events, TimeLine.new(int(minutes_since_midnight / 60), minutes_since_midnight % 60, caption, tint, style_name))

add_macro(bool enabled, string start_text, string end_text) =>
    if show_macros and enabled
        start_minutes = parse_clock_minutes(start_text)
        end_minutes = parse_clock_minutes(end_text)
        if start_minutes < 0 or end_minutes < 0
            log.warning('Time-Based Vertical Lines: skipping macro "{0}" to "{1}", expected times as HH:MM', start_text, end_text)
        else
            start_hour = int(start_minutes / 60)
            start_minute = start_minutes % 60
            end_hour = int(end_minutes / 60)
            end_minute = end_minutes % 60
            // Both edges, always: a macro is a span, and one line can only say
            // when it opens. Neither line is captioned -- the rectangle between
            // them carries the name, which is what makes the pair read as one
            // window instead of two loose lines.
            array.push(events, TimeLine.new(start_hour, start_minute, '', macro_color, macro_style))
            array.push(events, TimeLine.new(end_hour, end_minute, '', macro_color, macro_style))
            array.push(macro_spans, MacroSpan.new(start_hour, start_minute, end_hour, end_minute, 'Macro ' + clock_text(start_hour, start_minute) + '-' + clock_text(end_hour, end_minute)))

if barstate.isfirst
    add_line(line1_on, line1_time, line1_text, line1_color, line1_style)
    add_line(line2_on, line2_time, line2_text, line2_color, line2_style)
    add_line(line3_on, line3_time, line3_text, line3_color, line3_style)
    add_line(line4_on, line4_time, line4_text, line4_color, line4_style)
    add_line(line5_on, line5_time, line5_text, line5_color, line5_style)
    add_line(line6_on, line6_time, line6_text, line6_color, line6_style)
    add_line(line7_on, line7_time, line7_text, line7_color, line7_style)
    add_line(line8_on, line8_time, line8_text, line8_color, line8_style)
    add_line(line9_on, line9_time, line9_text, line9_color, line9_style)
    add_line(line10_on, line10_time, line10_text, line10_color, line10_style)
    add_macro(macro1_on, macro1_start, macro1_end)
    add_macro(macro2_on, macro2_start, macro2_end)
    add_macro(macro3_on, macro3_start, macro3_end)
    add_macro(macro4_on, macro4_start, macro4_end)
    add_macro(macro5_on, macro5_start, macro5_end)
    add_macro(macro6_on, macro6_start, macro6_end)
    add_macro(macro7_on, macro7_start, macro7_end)
    add_macro(macro8_on, macro8_start, macro8_end)
    add_macro(macro9_on, macro9_start, macro9_end)
    add_macro(macro10_on, macro10_start, macro10_end)
    add_macro(macro11_on, macro11_start, macro11_end)
    add_macro(macro12_on, macro12_start, macro12_end)

//==============================================================================
// THE DAYS TO DRAW THEM ON
//==============================================================================
// Days are logged as the bars pass through them rather than counted back from
// today, so a weekend or a holiday never collects a set of lines nothing traded
// under. Today is added at draw time whether or not it has bars yet.
var array<int> trading_days = array.new<int>()

bar_midnight = midnight_of(time)
if array.size(trading_days) == 0 or array.last(trading_days) != bar_midnight
    array.push(trading_days, bar_midnight)
    if array.size(trading_days) > MAX_TRACKED_DAYS
        array.shift(trading_days)

//==============================================================================
// VISIBLE PRICE RANGE
//==============================================================================
// A vertical line needs two prices to be born, and the labels ride the edge of
// the screen, so both want the price range the screen is actually showing.
// Reading chart.left_visible_bar_time and chart.right_visible_bar_time is also
// what makes TradingView re-run the script on a scroll or a zoom, which is what
// keeps the labels welded to that edge.
var float visible_high = na
var float visible_low = na

bar_is_visible = not na(chart.left_visible_bar_time) and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
if bar_is_visible
    visible_high := na(visible_high) ? high : math.max(visible_high, high)
    visible_low := na(visible_low) ? low : math.min(visible_low, low)

// Stand-in for the visible range until the chart reports one: the last stretch
// of bars is a fair likeness of what is on screen. Computed on every bar because
// ta.* only sees the bars it runs on, so these cannot move inside the last-bar
// block that uses them.
fallback_high = ta.highest(high, FALLBACK_LOOKBACK)
fallback_low = ta.lowest(low, FALLBACK_LOOKBACK)

//==============================================================================
// DRAWING
//==============================================================================
// Everything is redrawn on each last-bar pass: the labels have to follow the
// visible range, and the countdowns have to stay current. Lines are anchored to
// real timestamps through xloc.bar_time, which is what lets one sit past the
// last bar -- a bar index cannot address a bar that does not exist yet, a
// timestamp can.
var array<line> drawn_lines = array.new<line>()
var array<label> drawn_labels = array.new<label>()
var array<box> drawn_boxes = array.new<box>()

if barstate.islast
    for existing_line in drawn_lines
        line.delete(existing_line)
    for existing_label in drawn_labels
        label.delete(existing_label)
    for existing_box in drawn_boxes
        box.delete(existing_box)
    array.clear(drawn_lines)
    array.clear(drawn_labels)
    array.clear(drawn_boxes)

    screen_high = na(visible_high) ? fallback_high : visible_high
    screen_low = na(visible_low) ? fallback_low : visible_low

    // The two kinds of drawing want opposite things from the price scale. A
    // line takes its endpoints from inside the visible range and reaches the
    // rest of the way with extend.both, so it fills the height without asking
    // the chart for room. Labels and macro rectangles do the reverse: they sit
    // past the highest or lowest bar on purpose, and the chart gives up that
    // much scale to hold them. That is the price of keeping them off the
    // candles rather than over them.
    price_range = screen_high - screen_low
    edge_gap = price_range * label_distance / 100
    band_height = price_range * macro_band_height / 100
    at_top = label_position == 'Top'

    // The strip is laid out from the bars outward: clear space first, then the
    // band. Starting the band at the bar extreme instead put its edge exactly
    // on the lowest low, so any bar that made the low sat on top of it.
    // Captions ride the middle of the band, which puts them and the rectangles
    // on one line rather than in two tiers.
    band_inner = at_top ? screen_high + edge_gap : screen_low - edge_gap
    band_outer = at_top ? band_inner + band_height : band_inner - band_height
    band_top = at_top ? band_outer : band_inner
    band_bottom = at_top ? band_inner : band_outer

    // Middle leaves no edge to hang a rectangle off, so the rectangles stay at
    // the bottom while the captions cross the chart.
    label_y = label_position == 'Middle' ? math.avg(screen_low, screen_high) : math.avg(band_top, band_bottom)

    today_midnight = midnight_of(timenow)

    // History counts back from the newest day the chart has bars for, not from
    // today. Counting from today would, over a weekend or a holiday, push the
    // last day that actually traded out of the window and leave the bars on
    // screen carrying no lines at all.
    cutoff = shift_days(array.last(trading_days), -history_days)

    days_to_draw = array.new<int>()
    for tracked_day in trading_days
        if tracked_day >= cutoff and tracked_day < today_midnight
            array.push(days_to_draw, tracked_day)

    // Today and tomorrow go in whether or not they have bars yet. Their lines
    // are the ones still ahead, which is the whole point of drawing them; the
    // bars-only rule is what keeps a past weekend from collecting a set.
    array.push(days_to_draw, today_midnight)
    if include_tomorrow
        array.push(days_to_draw, shift_days(today_midnight, 1))

    for day_start in days_to_draw
        day_year = year(day_start, tz)
        day_month = month(day_start, tz)
        day_of_month = dayofmonth(day_start, tz)
        for marker in events
            event_time = timestamp(tz, day_year, day_month, day_of_month, marker.at_hour, marker.at_minute)
            array.push(drawn_lines, line.new(event_time, screen_low, event_time, screen_high, xloc = xloc.bar_time, extend = extend.both, color = marker.tint, style = line_style_constant(marker.style), width = line_width))

            if show_labels and marker.caption != ''
                caption = marker.caption
                if show_countdown and event_time > timenow
                    caption := caption + '\n' + countdown_text(event_time - timenow)
                array.push(drawn_labels, label.new(event_time, label_y, caption, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_label_left, color = color.new(color.white, 100), textcolor = marker.tint, size = label_size_constant()))

        for span in macro_spans
            span_start = timestamp(tz, day_year, day_month, day_of_month, span.start_hour, span.start_minute)
            span_end = timestamp(tz, day_year, day_month, day_of_month, span.end_hour, span.end_minute)

            // One caption for the whole window, and it changes tense with it:
            // counting down to the open while the window is ahead, counting out
            // what is left of it once inside.
            caption = span.caption
            if show_countdown and timenow < span_start
                caption := caption + '   in ' + countdown_text(span_start - timenow)
            else if show_countdown and timenow < span_end
                caption := caption + '   ' + countdown_text(span_end - timenow) + ' left'

            array.push(drawn_boxes, box.new(span_start, band_top, span_end, band_bottom, xloc = xloc.bar_time, border_color = macro_color, border_width = line_width, border_style = line_style_constant(macro_style), bgcolor = color.new(macro_color, macro_band_transp), text = show_labels ? caption : '', text_color = macro_color, text_halign = text.align_center, text_valign = text.align_center, text_size = label_size_constant()))
