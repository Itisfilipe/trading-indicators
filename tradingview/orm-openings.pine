//@version=6
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Filipe Teixeira Amaral
// -----------------------------------------------------------------------------
// ORM Openings
// Author: Filipe Teixeira Amaral
// Version: 1.0
//
// Description:
// The opening prices the Open Reaction Model reads on NQ: a line at each
// session open and the New Week (and optionally New Day) Opening Gaps.
// Every time is New York local, so daylight saving needs no adjustment.
//
// Features:
// - Open lines at 00:00, 02:00, 08:30, 09:30, 13:30 and 20:00, each running to
//   the 17:00 close of its trading day (today's stop 15 candles past the
//   last one, caption just past its end), captioned with their time; times and colors
//   editable; 02:00 off by default, since London is context only
// - NWOG: Friday's 17:00 close and Sunday's 18:00 open as solid lines
//   ("NWOG C 13/11", "NWOG O 15/11") with the dotted midpoint ("NWOG CE 15/11") between,
//   for the last few weeks whether or not price has traded through them
// - NDOG (off by default): the same for each weekday's 17:00 close and 18:00
//   reopen
// - Opens at one price ending together share a caption ("00:00 / 02:00")
//
// Notes:
// - Opens come from a 5-minute feed and opening gaps from an hourly feed (the chart's
//   own timeframe when larger), not the chart's candles, so a 1-minute chart
//   shows the whole history even where its own candles do not reach.
// - An open time must sit on the 5-minute grid, or on the chart's own grid
//   above 5 minutes (a 1-hour chart reads 08:30 from the 09:00 candle).
// -----------------------------------------------------------------------------

indicator('ORMOpenings', 'ORM Openings', overlay = true, max_lines_count = 500, max_boxes_count = 500)

TZ = 'America/New_York'
MS_PER_MINUTE = 60000
MS_PER_DAY = 86400000
HALF_DAY_MS = 43200000

GRP_OPENS = 'Opens'
GRP_NWOG = 'Opening gaps'

dateFormatInput = input.string('DD/MM', 'Date format', options = ['DD/MM', 'MM/DD'], group = GRP_OPENS)
history = input.int(1, 'Days of history', minval = 1, maxval = 30, group = GRP_OPENS)
open1On = input.bool(true, '', inline = 'o1', group = GRP_OPENS)
open1Time = input.string('00:00', '', inline = 'o1', group = GRP_OPENS)
open1Color = input.color(#000000, '', inline = 'o1', group = GRP_OPENS)
open2On = input.bool(false, '', inline = 'o2', group = GRP_OPENS)
open2Time = input.string('02:00', '', inline = 'o2', group = GRP_OPENS)
open2Color = input.color(#000000, '', inline = 'o2', group = GRP_OPENS)
open3On = input.bool(true, '', inline = 'o3', group = GRP_OPENS)
open3Time = input.string('08:30', '', inline = 'o3', group = GRP_OPENS)
open3Color = input.color(#000000, '', inline = 'o3', group = GRP_OPENS)
open4On = input.bool(true, '', inline = 'o4', group = GRP_OPENS)
open4Time = input.string('09:30', '', inline = 'o4', group = GRP_OPENS)
open4Color = input.color(#000000, '', inline = 'o4', group = GRP_OPENS)
open5On = input.bool(true, '', inline = 'o5', group = GRP_OPENS)
open5Time = input.string('13:30', '', inline = 'o5', group = GRP_OPENS)
open5Color = input.color(#000000, '', inline = 'o5', group = GRP_OPENS)
open6On = input.bool(true, '', inline = 'o6', group = GRP_OPENS)
open6Time = input.string('20:00', '', inline = 'o6', group = GRP_OPENS)
open6Color = input.color(#000000, '', inline = 'o6', group = GRP_OPENS)
nwogOn = input.bool(true, 'NWOG', inline = 'nwog', group = GRP_NWOG)
nwogColor = input.color(#000000, '', inline = 'nwog', group = GRP_NWOG)
nwogWeeks = input.int(4, 'Weeks', minval = 1, maxval = 30, group = GRP_NWOG)
ndogOn = input.bool(false, 'NDOG', inline = 'ndog', group = GRP_NWOG)
ndogColor = input.color(#787b86, '', inline = 'ndog', group = GRP_NWOG)
ndogDays = input.int(5, 'Days', minval = 1, maxval = 30, group = GRP_NWOG)

type Mark
    float price
    int t
    int endTime

type Gap
    float openPrice
    int openTime
    float closePrice
    int closeTime

// "HH:MM" to minutes after midnight; na when the text is not a time.
parseClock(string clockText) =>
    parts = str.split(str.trim(clockText), ':')
    int result = na
    if parts.size() == 2
        hours = str.tonumber(parts.get(0))
        minutes = str.tonumber(parts.get(1))
        if not na(hours) and not na(minutes) and hours >= 0 and hours < 24 and minutes >= 0 and minutes < 60
            result := int(hours) * 60 + int(minutes)
    result

// The latest moment at or before t whose New York clock reads clockMinute.
latestClock(int t, int clockMinute) =>
    barMinute = hour(t, TZ) * 60 + minute(t, TZ)
    dayStart = timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0)
    base = barMinute >= clockMinute ? t : dayStart - HALF_DAY_MS
    timestamp(TZ, year(base, TZ), month(base, TZ), dayofmonth(base, TZ), int(clockMinute / 60), clockMinute % 60)

// The 17:00 close of the trading day that holds t.
tradingDayClose(int t) =>
    sameDay = timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 17, 0)
    nextDay = t + MS_PER_DAY
    sameDay > t ? sameDay : timestamp(TZ, year(nextDay, TZ), month(nextDay, TZ), dayofmonth(nextDay, TZ), 17, 0)

trackOpen(int openMinute, int barMs, int keep) =>
    var marks = array.new<Mark>()
    if not na(openMinute)
        openTime = latestClock(time, openMinute)
        if time < openTime + barMs and (marks.size() == 0 or marks.last().t != openTime)
            marks.push(Mark.new(open, openTime, tradingDayClose(openTime)))
            if marks.size() > keep
                marks.shift()
    barstate.islast ? marks : na

// The gap across the 17:00-18:00 break: the Sunday reopen makes the NWOG, the weekday reopens the NDOGs.
trackGaps(bool weekly, int keep) =>
    var gaps = array.new<Gap>()
    isReopen = hour(time, TZ) == 18 and minute(time, TZ) == 0
    isSunday = dayofweek(time, TZ) == dayofweek.sunday
    if isReopen and isSunday == weekly and open != close[1]
        gaps.push(Gap.new(open, time, close[1], time[1]))
        if gaps.size() > keep
            gaps.shift()
    barstate.islast ? gaps : na

// A feed below the chart's timeframe would only return its first sub-candle, so the chart's own timeframe takes over.
feedTimeframe(string minimum) =>
    timeframe.in_seconds() > timeframe.in_seconds(minimum) ? timeframe.period : minimum

feed = ticker.modify(syminfo.tickerid, session.extended)
openFeedTf = feedTimeframe('5')
calcMs = timeframe.in_seconds(openFeedTf) * 1000

opens1 = request.security(feed, openFeedTf, trackOpen(parseClock(open1Time), calcMs, history), lookahead = barmerge.lookahead_on)
opens2 = request.security(feed, openFeedTf, trackOpen(parseClock(open2Time), calcMs, history), lookahead = barmerge.lookahead_on)
opens3 = request.security(feed, openFeedTf, trackOpen(parseClock(open3Time), calcMs, history), lookahead = barmerge.lookahead_on)
opens4 = request.security(feed, openFeedTf, trackOpen(parseClock(open4Time), calcMs, history), lookahead = barmerge.lookahead_on)
opens5 = request.security(feed, openFeedTf, trackOpen(parseClock(open5Time), calcMs, history), lookahead = barmerge.lookahead_on)
opens6 = request.security(feed, openFeedTf, trackOpen(parseClock(open6Time), calcMs, history), lookahead = barmerge.lookahead_on)
weekGaps = request.security(feed, feedTimeframe('60'), trackGaps(true, nwogWeeks), lookahead = barmerge.lookahead_on)
dayGaps = request.security(feed, feedTimeframe('60'), trackGaps(false, ndogDays), lookahead = barmerge.lookahead_on)

var int firstBarTime = time
dateFormat = dateFormatInput == 'MM/DD' ? 'MM/dd' : 'dd/MM'
var openCaptions = map.new<string, box>()
var openCaptionTexts = map.new<string, string>()

// The caption starts right at the line's end (a borderless zero-height box, which has no label pointer gap); opens at one price ending together share one caption.
openCaption(int x, float price, string caption, color tint) =>
    key = str.tostring(x) + '|' + str.tostring(price)
    existing = openCaptions.get(key)
    merged = na(existing) ? caption : openCaptionTexts.get(key) + ' / ' + caption
    openCaptionTexts.put(key, merged)
    if na(existing)
        openCaptions.put(key, box.new(x, price, x + 30 * timeframe.in_seconds() * 1000, price, xloc = xloc.bar_time, border_color = color(na), bgcolor = color(na), text = merged, text_color = tint, text_size = size.small, text_halign = text.align_left, text_valign = text.align_center))
    else
        existing.set_text(merged)
    merged

drawOpens(array<Mark> marks, string caption, color tint) =>
    for mark in marks
        x1 = math.max(mark.t, firstBarTime)
        x2 = math.min(mark.endTime, time + 15 * timeframe.in_seconds() * 1000)
        if x2 > x1
            line.new(x1, mark.price, x2, mark.price, xloc = xloc.bar_time, color = tint, style = line.style_dashed)
            openCaption(x2, mark.price, caption, tint)

drawGaps(array<Gap> gaps, string name, color tint) =>
    x2 = time + 15 * timeframe.in_seconds() * 1000
    for gap in gaps
        x1 = math.max(gap.openTime, firstBarTime)
        middle = (gap.openPrice + gap.closePrice) / 2
        line.new(x1, gap.openPrice, x2, gap.openPrice, xloc = xloc.bar_time, color = tint)
        line.new(x1, gap.closePrice, x2, gap.closePrice, xloc = xloc.bar_time, color = tint)
        line.new(x1, middle, x2, middle, xloc = xloc.bar_time, color = tint, style = line.style_dotted)
        openCaption(x2, gap.openPrice, name + ' O ' + str.format_time(gap.openTime, dateFormat, TZ), tint)
        openCaption(x2, gap.closePrice, name + ' C ' + str.format_time(gap.closeTime, dateFormat, TZ), tint)
        openCaption(x2, middle, name + ' CE ' + str.format_time(gap.openTime, dateFormat, TZ), tint)

if barstate.islast and not na(opens1)
    for drawn in line.all
        drawn.delete()
    for drawn in box.all
        drawn.delete()
    openCaptions.clear()
    openCaptionTexts.clear()
    if nwogOn
        drawGaps(weekGaps, 'NWOG', nwogColor)
    if ndogOn
        drawGaps(dayGaps, 'NDOG', ndogColor)
    if open1On
        drawOpens(opens1, open1Time, open1Color)
    if open2On
        drawOpens(opens2, open2Time, open2Color)
    if open3On
        drawOpens(opens3, open3Time, open3Color)
    if open4On
        drawOpens(opens4, open4Time, open4Color)
    if open5On
        drawOpens(opens5, open5Time, open5Color)
    if open6On
        drawOpens(opens6, open6Time, open6Color)
